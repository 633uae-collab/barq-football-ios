# Configure these in Render's Environment panel, never in the iOS application.
APISPORTS_KEY=
PORT=3000
NODE_ENV=production
# Must be on an existing persistent disk. A deploy without one loses server preferences.
FOTIQ_DB_PATH=/var/data/fotiq/fotiq.sqlite
# Defensive per-process budget, not a substitute for the provider account quota.
API_DAILY_BUDGET=1000
