+async function evidence(question,cards) {
+ const row={player:{id:1100,name:'Haaland'},statistics:[{team:{id:50,name:'Synthetic Club'},league:{id:39,name:'Premier League',season:2025},cards,goals:{total:0}}]};
+ const before=structuredClone(row);
+ const data={'/players/profiles':[{player:row.player}],'/players/teams':[{team:{id:50},seasons:[2025]}],'/players':[row],'/leagues':[{league:{id:39},seasons:[{year:2025}]}],'/players/topscorers':[row]};
+ const result=await collectEvidence({load:async path=>({fetchedAt:1,data:data[path.split('?')[0]]||[]})},question);
+ assert.deepEqual(row,before,'provider input must remain unchanged');
+ const s=result.playerProfiles?.[0]?.statistics[0]?.statistics[0]||result.scoringLeaders[0].statistics[0];
+ assert.equal(s.teamId,50);assert.equal(s.leagueId,39);assert.equal(s.season,2025);assert.equal(s.scoring.goals,0);
+ return s;
+}
+for(const q of questions)test('withholds invalid discipline counts: '+q,async()=>{
+ for(const bad of [-1,0.5,'12',true,Number.MAX_SAFE_INTEGER+1,{},[],NaN,Infinity]) {
+  for(let i=0;i<fields.length;i++) {
+   const input={yellow:10,yellowred:2,red:3,[fields[i]]:bad};
+   const s=await evidence(q,input);
+   assert.equal(s.discipline[keys[i]],null,'invalid '+fields[i]+' must not reach the model');
+   assert.ok(s.warnings?.includes('Invalid player discipline counts withheld; null is unknown, not zero.'));
+   for(let j=0;j<fields.length;j++)if(i!==j)assert.equal(s.discipline[keys[j]],input[fields[j]]);
+  }
+ }
+});
+test('discipline counts preserve zero, unknown and safe integers without inferred limits',async()=>{
+ for(const q of questions)for(const input of [undefined,null,{}, {yellow:0,yellowred:0,red:0}, {yellow:10,yellowred:2,red:3}, {yellow:Number.MAX_SAFE_INTEGER,yellowred:null,red:Number.MAX_SAFE_INTEGER}]) {
+  const s=await evidence(q,input);
+  assert.deepEqual(s.discipline,{yellow:input?.yellow??null,yellowred:input?.yellowred??null,red:input?.red??null});
+  assert.ok(!s.warnings?.length);
+ }
+});
