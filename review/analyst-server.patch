+'use strict';
+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const {createApp}=require('../app');
+const fixture=(id=7,home=0)=>({fixture:{id,date:'2026-01-01T00:00:00Z',timestamp:1767225600,status:{short:'FT'}},league:{id:99,name:'Synthetic League'},teams:{home:{id:51,name:'Synthetic Home'},away:{id:52,name:'Synthetic Away'}},goals:{home,away:0}});
+async function harness(t){
+ let data,records=[];const app=createApp({storage:{},provider:{get:async()=>({data,fetchedAt:1,stale:false})},observations:{record:d=>records.push(d)}});
+ const server=app.listen(0,'127.0.0.1');await new Promise(r=>server.once('listening',r));
+ t.after(()=>new Promise(r=>server.close(r)));
+ return {records,request:async rows=>{data=rows;const before=structuredClone(rows);const r=await fetch(`http://127.0.0.1:${server.address().port}/api/match/7`);const body=await r.json();assert.deepEqual(rows,before);return {status:r.status,body};}};
+}
+test('match route binds requested fixture before recording observations',async t=>{
+ const h=await harness(t);const r=await h.request([fixture(99,8),fixture()]);assert.equal(r.status,200);assert.equal(r.body.match.id,7);assert.equal(r.body.match.goals.home,0);assert.equal(h.records[0].match.id,7);
+ const absent=await h.request([fixture(99)]);assert.equal(absent.status,404);assert.equal(h.records.length,1);
+});
+test('match route rejects all repeated requested fixtures without recording',async t=>{
+ const h=await harness(t);for(const duplicate of [fixture(),fixture(7,4),{fixture:{id:7}}])for(const rows of [[fixture(),duplicate],[duplicate,fixture()]]){const r=await h.request(rows);assert.equal(r.status,502);assert.equal(r.body.error,'UPSTREAM_INVALID_RESPONSE');}assert.equal(h.records.length,0);
+});
+test('match route distinguishes malformed collections from missing matches and keeps valid siblings',async t=>{
+ const h=await harness(t);for(const rows of [null,{},false,'invalid']){const r=await h.request(rows);assert.equal(r.status,502);assert.equal(r.body.error,'UPSTREAM_INVALID_RESPONSE');}
+ const r=await h.request([null,false,{},fixture()]);assert.equal(r.status,200);assert.equal(r.body.match.id,7);assert.equal(h.records.length,1);
+});
