+'use strict';
+const { verifiedTeamSeason } = require('./season-scope');
+// Season tables are rendered from identity-bound provider rows, never rewritten
+// by a language model. This prevents a fluent answer from swapping team totals.
+const fields = [
+  ['played', 'لعب', 'Played'], ['wins', 'فوز', 'Wins'], ['draws', 'تعادل', 'Draws'],
+  ['losses', 'خسارة', 'Losses'], ['goalsFor', 'له', 'Goals for'],
+  ['goalsAgainst', 'عليه', 'Goals against'], ['cleanSheets', 'شباك نظيفة', 'Clean sheets'],
+  ['failedToScore', 'مباريات دون تسجيل', 'Failed to score']
+];
+const cell = value => String(value).replace(/[|\r\n<>]/g, ' ').trim();
+const count = value => Number.isSafeInteger(value) && value >= 0;
+const scopeKey = club => Number.isSafeInteger(club?.teamId) && club.teamId > 0
+  && Number.isSafeInteger(club.season?.leagueId) && Number.isSafeInteger(club.season?.year)
+  ? `${club.teamId}/${club.season.leagueId}/${club.season.year}` : null;
+// Missing counts remain unverified; never infer them from other columns.
+// Withhold a whole row when its known match counts contradict each other.
+function consistentMatchCounts(totals) {
+  if (!count(totals.played)) return true;
+  const outcomes = [totals.wins, totals.draws, totals.losses];
+  const known = outcomes.filter(count);
+  const sum = known.reduce((a, b) => a + BigInt(b), 0n);
+  const played = BigInt(totals.played);
+  if (sum > played || (known.length === 3 && sum !== played)) return false;
+  if (![totals.cleanSheets, totals.failedToScore].every(n => !count(n) || n <= totals.played)) return false;
+  for (const [goals, scoreless] of [[totals.goalsFor, totals.failedToScore], [totals.goalsAgainst, totals.cleanSheets]]) {
+    if (!count(goals) || !count(scoreless)) continue;
+    const scoringMatches = totals.played - scoreless;
+    if (goals < scoringMatches || (scoringMatches === 0 && goals !== 0)) return false;
+  }
+  return true;
+}
+function seasonAnswer(question, evidence) {
+  if (!evidence.seasonOnlyComparison && !evidence.seasonOnlyClub) return null;
+  const ar = /[\u0600-\u06ff]/u.test(question);
+  const unknown = ar ? 'غير متحقق' : 'Unverified';
+  if (evidence.requestedSeasonScope?.ambiguous) return ar
+    ? 'حدّد بطولة واحدة وموسماً واحداً للمقارنة؛ لم أستبدل طلبك بإحصاءات الموسم الحالي.'
+    : 'Please specify one competition and one season; I have not substituted current-season statistics.';
+  const blocks = evidence.seasonOnlyClub ? [] : [ar ? 'مقارنة من بيانات المصدر المتحقق منها، دون استنتاج نتائج مباريات:' : 'Comparison from verified provider data; no individual match results inferred:'];
+  const displayedScopes = new Set();
+  const verifiedRows = [];
+  // Count before validation: a malformed duplicate cannot choose the winning totals.
+  const scopeCounts = new Map();
+  for (const club of evidence.clubs || []) {
+    const key = scopeKey(club);
+    if (key !== null) scopeCounts.set(key, (scopeCounts.get(key) || 0) + 1);
+  }
+  for (const club of evidence.clubs || []) {
+    const s = club.season;
+    const requested = evidence.requestedSeasonScope;
+    if (scopeCounts.get(scopeKey(club)) > 1) {
+      blocks.push(ar ? 'تكررت بيانات الفريق لنفس البطولة والموسم؛ حُجبت كل الصفوف المكررة دون اختيار إحصاءات إحداها.' : 'Repeated team data for the same competition and season; all duplicate rows are withheld without choosing one set of totals.');
+      continue;
+    }
+    if (!s?.verified || !s.totals || !club.team?.name || club.team.id !== club.teamId || s.team?.id !== club.teamId || s.team?.name !== club.team.name || !Number.isInteger(s.leagueId) || !Number.isInteger(s.year)
