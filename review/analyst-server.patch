+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { createApp } = require('../app');
+
+const fields = [['games','appearences'],['games','minutes'],['goals','total'],['goals','assists'],
+  ['shots','total'],['shots','on'],['passes','total'],['passes','key'],
+  ['dribbles','success'],['tackles','total'],['cards','yellow'],['cards','red']];
+async function harness(t) {
+  let statistics;
+  const server = createApp({provider:{get:async()=>({data:[{player:{id:7001,name:'Synthetic player'},statistics}],stale:false})}}).listen(0,'127.0.0.1');
+  await new Promise(r=>server.once('listening',r));
+  t.after(()=>new Promise(r=>server.close(r)));
+  return async rows=>{
+    statistics=rows; const before=structuredClone(rows);
+    const response=await fetch(`http://127.0.0.1:${server.address().port}/api/player/7001?season=2025`);
+    const body=await response.json(); assert.deepEqual(rows,before);
+    return {status:response.status,body};
+  };
+}
+const stat=()=>({team:{id:9001},league:{id:901,season:2025}});
+for(const [group,key] of fields) test(`player detail rejects invalid ${group}.${key} counts`,async t=>{
+  const request=await harness(t);
+  for(const value of [-1,1.5,'12',true,{},[],Number.MAX_SAFE_INTEGER+1,NaN,Infinity]) {
+    const row=stat();row[group]={[key]:value};
+    const result=await request([row]);
+    assert.equal(result.status,502,`${group}.${key}: ${String(value)}`);
+    assert.deepEqual(result.body,{error:'UPSTREAM_INVALID_RESPONSE'});
+  }
+});
+test('player detail preserves valid counts, absent fields and provider input',async t=>{
+  const request=await harness(t);
+  for(const value of [0,12,Number.MAX_SAFE_INTEGER,null,undefined]) {
+    const row=stat();for(const [group,key] of fields)(row[group]??={})[key]=value;
+    const result=await request([row]);assert.equal(result.status,200);
+    if(value!=null)for(const key of ['apps','minutes','goals','assists','shots','sot','passes','keyPasses','dribbles','tackles','yellow','red'])assert.equal(result.body.stats[0][key],value);
+  }
+  assert.equal((await request([stat()])).status,200);
+});
