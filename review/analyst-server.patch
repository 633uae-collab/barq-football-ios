+const locations = [
+  ['current', (f,v)=>{f.goals=v;}, e=>e.currentScore],
+  ['halftime', (f,v)=>{f.score.halftime=v;}, e=>e.completedPeriodScores.halftime],
+  ['fulltime', (f,v)=>{f.score.fulltime=v;}, e=>e.completedPeriodScores.fulltime]
+];
+for (const [name,set,get] of locations) {
