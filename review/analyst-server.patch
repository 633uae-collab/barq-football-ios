@@ -0,0 +1,38 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { collectEvidence } = require('../chat-evidence');
+
+for (const [question, followup, next] of [
+  ['حلل آخر مباراة لبرشلونة', 'كم كانت النتيجة في نفس المباراة؟', false],
+  ["When is Barcelona's next match?", 'Who plays at home in the same match?', true]
+]) {
+  test('season statistics cannot erase independently verified fixture context: ' + question, async () => {
+    const match = {
+      fixture: { id: 71, date: '2026-11-16T12:00:00Z', status: { short: next ? 'NS' : 'FT' } },
+      league: { id: 140, season: 2026 },
+      teams: { home: { id: 529, name: 'Barcelona' }, away: { id: 541, name: 'Real Madrid' } },
+      goals: next ? { home: null, away: null } : { home: 0, away: 1 }
+    };
+    for (const season of [null, { team: { id: 40, name: 'Liverpool' }, league: match.league }]) {
+      const calls = [];
+      const provider = { async load(path) {
+        calls.push(path);
+        const data = path.startsWith('/teams/statistics?') ? season
+          : path === '/fixtures?id=71' || path === '/fixtures?team=529&' + (next ? 'next=1' : 'last=5') ? [match] : [];
+        return { data, fetchedAt: 1 };
+      } };
+      const answer = await collectEvidence(provider, question);
+      assert.equal(answer.clubs[0].season.verified, false);
+      assert.equal(answer.clubs[0].season.totals, null);
+      assert.equal(answer.fixtureId, 71);
+      assert.deepEqual(answer.followUpContext, { teamIds: [529], fixtureId: 71 });
+      calls.length = 0;
+      const saved = JSON.parse(JSON.stringify(answer.followUpContext));
+      const detail = await collectEvidence(provider, followup, saved, [{ role: 'user', content: question }]);
+      assert.deepEqual(calls, ['/fixtures?id=71']);
+      assert.equal(detail.fixtureId, 71);
+      assert.deepEqual(detail.currentScore, match.goals);
+    }
+  });
+}
