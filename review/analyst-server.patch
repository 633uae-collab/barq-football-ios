diff --git a/server/test/next-match-followup.test.js b/server/test/next-match-followup.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..72e436fcb97d95ca0408d729034b780d2a175558
--- /dev/null
+++ b/server/test/next-match-followup.test.js
@@ -0,0 +1,80 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { collectEvidence } = require('../chat-evidence');
+
+for (const [previous, question] of [
+  ['Analyze the completed match for Barcelona', 'When is their next match?'],
+  ['حلل مباراة برشلونة المباشرة', 'متى مباراتهم القادمة؟']
+]) {
+  test('next-match follow-up replaces the previous fixture and retains its club: ' + question, async () => {
+    const fixture = (id, status) => ({
+      fixture: { id, status: { short: status } },
+      teams: { home: { id: 529, name: 'Barcelona' }, away: { id: 541, name: 'Real Madrid' } }
+    });
+    for (const hasNext of [true, false]) {
+      const calls = [];
+      const old = fixture(71, 'FT'), next = fixture(72, 'NS');
+      const provider = { async load(path) {
+        calls.push(path);
+        const rows = path === '/fixtures?team=529&next=1' ? (hasNext ? [next] : [])
+          : path === '/fixtures?id=72' ? [next] : [old];
+        return { data: rows, fetchedAt: 1000 };
+      } };
+      const saved = { fixtureId: 71, teamIds: [529] };
+      const result = await collectEvidence(provider, question, saved, [{ role: 'user', content: previous }]);
+      assert.ok(calls.includes('/fixtures?team=529&next=1'));
+      assert.ok(!calls.includes('/fixtures?id=71'));
+      assert.equal(result.fixtureId, hasNext ? 72 : undefined);
+      assert.deepEqual(result.followUpContext, hasNext ? { fixtureId: 72, teamIds: [529] } : { teamIds: [529] });
+    }
+  });
+}
+
+for (const question of ["When is Barcelona's next match?", 'متى مباراة برشلونة القادمة؟']) {
+  test('the next fixture needs a pre-match status: ' + question, async () => {
+    for (const status of ['FT', '2H', 'PST', 'CANC', undefined, 'NS', 'TBD']) {
+      const candidate = {
+        fixture: { id: 72, status: { short: status } },
+        teams: { home: { id: 529, name: 'Barcelona' }, away: { id: 541, name: 'Real Madrid' } }
+      };
+      const calls = [];
+      const provider = { async load(path) {
+        calls.push(path);
+        const data = path === '/fixtures?team=529&next=1' || path === '/fixtures?id=72' ? [candidate] : [];
+        return { data, fetchedAt: 1000 };
+      } };
+      const e = await collectEvidence(provider, question);
+      const upcoming = status === 'NS' || status === 'TBD';
+      assert.deepEqual(e.clubs[0].matches.map(match => match.id), upcoming ? [72] : [], String(status));
+      assert.equal(e.followUpContext.fixtureId, upcoming ? 72 : undefined);
+      assert.equal(calls.includes('/fixtures?id=72'), upcoming);
+      assert.equal(calls.includes('/fixtures?team=541&last=5'), upcoming);
+      if (!upcoming) assert.ok(e.missing.some(reason => /pre-match status/.test(reason)));
+    }
+  });
+}
+
+for (const question of ['What was the score of their last match?', 'كم كانت نتيجة مباراتهم السابقة؟']) {
+  test('previous result after a next-match question uses the last finished fixture: ' + question, async () => {
+    const teams = { home: { id: 529, name: 'Barcelona' }, away: { id: 541, name: 'Real Madrid' } };
+    const match = (id, status, date, goals) => ({ fixture: { id, status: { short: status }, date }, teams, goals });
+    const next = match(73, 'NS', '2026-11-20T18:00:00Z', { home: null, away: null });
+    const last = match(72, 'FT', '2026-11-15T18:00:00Z', { home: 0, away: 2 });
+    const older = match(71, 'FT', '2026-11-10T18:00:00Z', { home: 3, away: 0 });
+    const history = [{ role: 'user', content: "When is Barcelona's next match?" }];
+    for (const teamIds of [[529], [], [529, 541]]) {
+      const calls = [];
+      const provider = { async load(path) {
+        calls.push(path);
+        const data = path.endsWith('last=5') ? [older, next, last] : [path === '/fixtures?id=72' ? last : next];
+        return { data, fetchedAt: 1 };
+      } };
+      const e = await collectEvidence(provider, question, { fixtureId: 73, teamIds }, history);
+      const resolved = teamIds.length === 1;
+      assert.deepEqual(calls, resolved ? ['/fixtures?team=529&last=5', '/fixtures?id=72'] : []);
+      assert.deepEqual(e.currentScore, resolved ? last.goals : undefined);
+      assert.deepEqual(e.followUpContext, resolved ? { teamIds: [529], fixtureId: 72 } : {});
+    }
+  });
+}
diff --git a/server/test/observation-snapshot-binding.test.js b/server/test/observation-snapshot-binding.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..a5e154e9310300274f9d8331d2b159bfc1317a17
--- /dev/null
+++ b/server/test/observation-snapshot-binding.test.js
@@ -0,0 +1,67 @@
+'use strict';
+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const {openStorage}=require('../storage');
+const {Observations}=require('../observations');
+function detail(at,shots){return {match:{id:70001,home:{id:51,name:'Synthetic Home'},away:{id:52,name:'Synthetic Away'},league:{name:'Synthetic League'},goals:{home:0,away:0},status:{short:'1H',elapsed:20}},fetchedAt:at,stale:false,statistics:[{team:{id:51,name:'Synthetic Home'},statistics:[{type:'Shots on Goal',value:shots}]},{team:{id:52,name:'Synthetic Away'},statistics:[{type:'Shots on Goal',value:0}]}]};}
+function compareSnapshots(t, mutate) {
+  const storage = openStorage(':memory:');
+  t.after(() => storage.close());
+  let now = 1000000;
+  const observations = new Observations(storage, { now: () => now });
+  const first = detail(now, 0);
+  const last = detail(now + 480000, 4);
+  mutate(first, last);
+  const originals = structuredClone([first, last]);
+  observations.record(first);
+  now = last.fetchedAt;
+  const result = observations.analyze(last);
+  assert.deepEqual([first, last], originals);
+  return result;
+}
+function run(t, mutate, old) {
+  return compareSnapshots(t, (first, last) => mutate(old ? first : last));
+}
+test('pressure withholds cross-snapshot identity conflict even when each snapshot is internally consistent',t=>{
+ for(const old of [false,true])for(const side of ['home','away'])assert.deepEqual(run(t,d=>{
+  d.match[side].name='Different Synthetic Club';
+  d.statistics.find(x=>x.team.id===d.match[side].id).team.name=d.match[side].name;
+ },old).insights,[]);
+});
+test('pressure withholds swapped home-away ownership between snapshots',t=>{
+ for(const old of [false,true])assert.deepEqual(run(t,d=>{[d.match.home,d.match.away]=[d.match.away,d.match.home];},old).insights,[]);
+});
+test('pressure retains normalized stable snapshot identities and exact deltas',t=>{
+ const r=run(t,d=>{d.match.home.name='  SYNTHETIC   HOME ';d.statistics[0].team.name=d.match.home.name;},true);
+ assert.equal(r.insights.length,1);assert.equal(r.insights[0].nums.shotsOnGoal,4);assert.equal(r.insights[0].nums.opponentShotsOnGoal,0);assert.equal(r.insights[0].nums.observedMinutes,8);
+});
+
+for (const [side, index] of [['home', 0], ['away', 1]]) {
+  test(`pressure requires a valid ${side} ID even when both snapshots repeat it`, t => {
+    for (const id of [0, -1, 1.5, '51', null, undefined, Number.MAX_SAFE_INTEGER + 1]) {
+      const result = compareSnapshots(t, (...snapshots) => {
+        for (const snapshot of snapshots) {
+          snapshot.match[side].id = id;
+          snapshot.statistics[index].team = { id };
+        }
+      });
+      assert.deepEqual(result.insights, []);
+    }
+  });
+}
+test('pressure withholds the comparison when a participant is absent from both snapshots', t => {
+  const result = compareSnapshots(t, (...snapshots) => {
+    for (const snapshot of snapshots) snapshot.match.away = null;
+  });
+  assert.deepEqual(result.insights, []);
+});
+test('legacy statistics without names still require distinct participant IDs', t => {
+  const result = compareSnapshots(t, (...snapshots) => {
+    for (const snapshot of snapshots) {
+      snapshot.match.away.id = snapshot.match.home.id;
+      snapshot.statistics = [snapshot.statistics[0]];
+      delete snapshot.statistics[0].team.name;
+    }
+  });
+  assert.deepEqual(result.insights, []);
+});
