+      paths.push(path);
+      let data=[];
+      if(path.startsWith('/players/profiles')) data=[{player:{id:999,name:'Wrong player'}},{player:row().player}];
+      if(path.startsWith('/players/teams')) data=teams;
+      if(path.startsWith('/players?')) {const bad=row();bad.player.id=999;data=[bad,row()];}
+      return {data,fetchedAt:1000};
+    }},question);
+    const p=e.playerProfiles[0];
+    assert.equal(p.profile,'E. Haaland');assert.equal(p.season,2025);
+    assert.equal(p.statistics.length,1);assert.equal(p.statistics[0].playerId,1100);
+    assert.equal(p.statistics[0].statistics[0].leagueId,39);
+    assert.equal(p.statistics[0].statistics[0].season,2025);
+    assert.equal(p.statistics[0].statistics[0].scoring.goals,0);
+    assert.ok(paths.includes('/players?id=1100&season=2025&league=39'));
+    assert.ok(!paths.some(p=>p.includes('season=2026')));
