+'use strict';
+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const {verifiedFixturePlayerGroups:verify}=require('../fixture-player-scope');
+const fixture={fixture:{id:90001},league:{id:39,season:2026},teams:{home:{id:50},away:{id:40}}};
+const player=(id=70001,goals=0)=>({player:{id,name:`Synthetic Player ${id}`},statistics:[{games:{minutes:90},goals:{total:goals}}]});
+const group=(players,team=50)=>({team:{id:team},players});
+test('conflicting duplicate player rows are withheld regardless of provider order',()=>{
+  for(const rows of [[player(),player(70001,3)],[player(70001,3),player()]]) {
+    assert.deepEqual(verify([group(rows)],fixture,50),[]);
+  }
+});
+test('duplicate player across team groups cannot survive requested-team filtering',()=>{
+  for(const otherTeam of [50,40]) {
+    const groups=[group([player()]),group([player(70001,2)],otherTeam)];
+    assert.deepEqual(verify(groups,fixture,50),[]);
+    assert.deepEqual(verify(groups.reverse(),fixture,50),[]);
+  }
+});
+test('multiple statistics rows for the same fixture have no arbitrary winner',()=>{
+  const row=player();row.statistics.push(player(70001,4).statistics[0]);
+  assert.deepEqual(verify([group([row])],fixture,50),[]);
+});
+test('unambiguous players and zero survive while duplicated identity is withheld',()=>{
+  const clean=player(70002),duplicate=player();
+  const groups=[group([duplicate,player(70001,2),clean])];
+  const before=JSON.stringify(groups);
+  const result=verify(groups,fixture,50);
+  assert.deepEqual(result[0].players.map(p=>p.player.id),[70002]);
+  assert.equal(result[0].players[0].statistics[0].goals.total,0);
+  assert.equal(result[0].players[0].statistics[0].games.minutes,90);
+  assert.equal(JSON.stringify(groups),before);
+});
+test('rows for another fixture or nonparticipant team cannot invalidate a valid player',()=>{
+  const wrongFixture={...group([player()]),fixture:{id:90002}};
+  const result=verify([group([player()]),wrongFixture,group([player()],99),group([player(70002)],40)],fixture);
+  assert.deepEqual(result.map(g=>[g.team.id,g.players[0].player.id]),[[50,70001],[40,70002]]);
+});
