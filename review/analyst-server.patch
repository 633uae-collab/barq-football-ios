@@ -0,0 +1,42 @@
+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { collectEvidence } = require('../chat-evidence');
+const { seasonAnswer } = require('../season-answer');
+
+for (const question of [
+  'Compare Liverpool and Manchester City in the Premier League season 2025/26',
+  'قارن مانشستر سيتي وليفربول في الدوري الإنجليزي موسم ٢٠٢٥/٢٦'
+]) {
+  test('season totals require matching English club names and IDs: ' + question, async () => {
+    const league = { id: 39, name: 'Premier League', type: 'League' };
+    const names = { 40: 'Liverpool', 50: 'Manchester City' };
+    for (const swapped of [true, false]) {
+      const evidence = await collectEvidence({ async load(path) {
+        const url = new URL(path, 'https://synthetic.invalid');
+        const id = Number(url.searchParams.get('team'));
+        assert.ok(Object.hasOwn(names, id));
+        if (url.pathname === '/leagues') return { fetchedAt: 1, data: [{ league, seasons: [{ year: 2025 }] }] };
+        assert.equal(url.pathname, '/teams/statistics');
+        return { fetchedAt: 1, data: {
+          team: { id, name: names[swapped ? (id === 40 ? 50 : 40) : id] },
+          league: { ...league, season: 2025 }, goals: { for: { total: { total: id === 40 ? 987 : 0 } } }
+        } };
+      } }, question);
+      assert.equal(evidence.clubs.length, 2);
+      const answer = seasonAnswer(question, evidence);
+      if (swapped) {
+        assert.doesNotMatch(JSON.stringify(evidence.clubs), /987/);
+        assert.doesNotMatch(answer, /(?:Goals for|له): (?:987|0)/);
+      } else {
+        assert.match(answer, /Liverpool — Premier League — 2025[^—]*?(?:Goals for|له): 987/);
+        assert.match(answer, /Manchester City — Premier League — 2025[^—]*?(?:Goals for|له): 0/);
+        const altered = structuredClone(evidence);
+        for (const club of altered.clubs) {
+          club.team.name = club.season.team.name = names[club.teamId === 40 ? 50 : 40];
+        }
+        assert.doesNotMatch(seasonAnswer(question, altered), /(?:Goals for|له): (?:987|0)/);
+      }
+    }
+  });
+}
