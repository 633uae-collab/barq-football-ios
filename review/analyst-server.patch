+'use strict';
+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const {collectEvidence}=require('../chat-evidence');
+const {verifiedFixturePlayerGroups}=require('../fixture-player-scope');
+async function collect(question,minutes) {
+  return collectEvidence({load:async path=>{
+    let data=[];
+    if(path.startsWith('/players/profiles'))data=[{player:{id:1100,name:'Haaland'}}];
+    else if(path.startsWith('/players/teams'))data=[{team:{id:50},seasons:[2026]}];
+    else if(path.startsWith('/players/squads'))data=[{team:{id:50}}];
+    else if(path.startsWith('/fixtures?'))data=minutes.map((_,i)=>({fixture:{id:90000+i,date:`2026-01-${String(20-i).padStart(2,'0')}T00:00:00Z`,status:{short:'FT'}},league:{id:39,season:2026},teams:{home:{id:50,name:'Manchester City'},away:{id:40,name:'Liverpool'}},goals:{home:0,away:0}}));
+    else if(path.startsWith('/fixtures/players')) {
+      const id=Number(new URLSearchParams(path.split('?')[1]).get('fixture'));
+      data=[{team:{id:50,name:'Manchester City'},players:[{player:{id:1100,name:'Haaland'},statistics:[{games:{minutes:minutes[id-90000]},goals:{total:0,assists:0}}]}]}];
+    }
+    return {data,fetchedAt:1};
+  }},question);
+}
+for(const question of ['Analyze Haaland over the last five matches','حلل هالاند في آخر خمس مباريات']) {
+  test('invalid minutes cannot displace verified player appearances: '+question,async()=>{
+    const e=await collect(question,[true,'90',0.5,Number.MAX_SAFE_INTEGER+1,[],90,12,1,0,null]);
+    const p=e.playerProfiles[0];
+    assert.deepEqual(p.lastFiveAppearances.map(a=>a.match.id),[90005,90006,90007]);
+    assert.equal(p.appearanceCoverage.found,3);
+    assert.ok(e.missing.some(s=>s.includes('Only 3 appearances')));
+    for(const m of p.lastFiveTeamMatches)assert.equal(m.player.statistics[0].games.minutes,null,'invalid candidate minutes remain unknown');
+  });
+}
+test('positive integer minutes and zero retain meaning and newest-first order',async()=>{
+  const e=await collect('Analyze Haaland over the last five matches',[0,1,90,120,2,5,6]);
+  const p=e.playerProfiles[0];
+  assert.deepEqual(p.lastFiveAppearances.map(a=>a.match.id),[90001,90002,90003,90004,90005]);
+  assert.equal(p.lastFiveTeamMatches[0].player.statistics[0].games.minutes,0);
+  assert.equal(p.lastFiveAppearances[0].player.statistics[0].scoring.goals,0);
+});
+test('unknown and malformed minutes stay unknown without mutating provider rows',()=>{
+  const fixture={fixture:{id:90000},league:{id:39,season:2026},teams:{home:{id:50},away:{id:40}}};
+  for(const minutes of [undefined,null,-1,NaN,Infinity,{},[],true,'90',0.5,Number.MAX_SAFE_INTEGER+1,0,90]) {
+    const row={player:{id:1100,name:'Haaland'},statistics:[{games:{minutes,captain:false},goals:{total:0}}]};
+    const validated=verifiedFixturePlayerGroups([{team:{id:50},players:[row]}],fixture,50)[0].players[0].statistics[0];
+    assert.equal(validated.games.minutes,Number.isSafeInteger(minutes)&&minutes>=0?minutes:null);
+    assert.equal(validated.games.captain,false);
+    assert.equal(validated.goals.total,0);
+    assert.ok(Object.is(row.statistics[0].games.minutes,minutes));
+  }
+});
