@@ -0,0 +1,47 @@
+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const {GroqAnalyst} = require('../groq');
+const {seasonAnswer} = require('../season-answer');
+const club = (id, name, goalsFor, year=2025, leagueId=901) => ({teamId:id,team:{id,name},season:{verified:true,team:{id,name},leagueId,league:'Synthetic League',year,totals:{played:7,wins:2,draws:0,losses:5,goalsFor,goalsAgainst:0}}});
+for (const question of ['Compare these clubs and explain their form','قارن الناديين واشرح مستواهما']) {
+  for (const variant of ['conflicting','identical','invalid']) {
+    test(`season final boundary withholds repeated scope ${variant}: ${question}`, async()=>{
+      const first=club(90001,'Synthetic Club A',23), duplicate=structuredClone(first);
+      if(variant==='conflicting') duplicate.season.totals.goalsFor=41;
+      if(variant==='invalid') duplicate.season.verified=false;
+      const sibling=club(90002,'Synthetic Club B',0);
+      let calls=0;
+      const analyst=new GroqAnalyst({fetchImpl:async()=>{calls++;return {ok:true,headers:new Headers(),json:async()=>({choices:[{finish_reason:'stop',message:{content:'UNVERIFIED MODEL CLAIM'}}]})};}});
+      for(const clubs of [[first,duplicate,sibling],[sibling,duplicate,first]]) {
+        const evidence={clubs,requestedSeasonScope:{leagueId:901,year:2025}};
+        const before=structuredClone(evidence);
+        const result=await analyst.answer(question,evidence);
+        assert.equal(result.model,'verified-provider-data');
+        assert.doesNotMatch(result.answer,/Synthetic Club A —|UNVERIFIED MODEL CLAIM/);
+        assert.match(result.answer,/Synthetic Club B — Synthetic League — 2025/);
+        assert.match(result.answer,/(?:له|Goals for): 0/);
+        assert.match(result.answer,/(?:حُجبت|withheld)/);
+        const direct=seasonAnswer(question,{...evidence,seasonOnlyComparison:true});
+        assert.doesNotMatch(direct,/Synthetic Club A —/);
+        assert.deepEqual(evidence,before);
+      }
+      assert.equal(calls,2,'no correction retry');
+    });
+  }
+}
+test('distinct club seasons and competitions remain separate; ordering cannot swap totals',()=>{
+  const clubs=[club(90001,'Synthetic Club A',23),club(90001,'Synthetic Club A',41,2024),club(90001,'Synthetic Club A',17,2025,902),club(90002,'Synthetic Club B',0)];
+  clubs[2].season.league='Synthetic Other League';
+  for(const rows of [clubs,[...clubs].reverse()]) {
+    const answer=seasonAnswer('Compare clubs',{seasonOnlyComparison:true,clubs:rows});
+    for(const row of rows) {
+      const s=row.season;
+      const heading=`${row.team.name} — ${s.league} — ${s.year}`;
+      const block=answer.split(heading)[1]?.split('\n\n')[0];
+      assert.ok(block);
+      assert.ok(block.includes(`Goals for: ${s.totals.goalsFor}\n`));
+    }
+    assert.match(answer,/different competitions or seasons/);
+    assert.equal((answer.match(/Goals for:/g)||[]).length,4);
+  }
+});
diff --git a/server/test/season-repeated-scope.test.js b/server/test/season-repeated-scope.test.js
