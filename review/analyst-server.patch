+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { GroqAnalyst } = require('../groq');
+
+const evidence = { events: [{ sourceId: 'event-4', minute: 90, addedTime: 2,
+  type: 'subst', playerIn: null, playerOut: null }] };
+
+function simulatedAnalyst(text) {
+  return new GroqAnalyst({ key: 'synthetic', fetchImpl: async () =>
+    Response.json({ choices: [{ finish_reason: 'stop', message: { content: text } }] }) });
+}
+
+for (const [lang, question, wrongTime, guessedRoles, valid] of [
+  ['ar', 'متى صار التبديل؟', 'التبديل (event-٤) في ٩٠+٣′ [event-4].',
+    'دخل باء محل ألف (event-٤) في ٩٠+٢′ [event-4].',
+    'تبديل (event-٤) في ٩٠+٢′ [event-4].'],
+  ['en', 'When was the substitution?', 'The substitution (event-4) was at 90+3′ [event-4].',
+    'B replaced A (event-4) at 90+2′ [event-4].',
+    'Substitution (event-4) at 90+2′ [event-4].']
+]) {
+  test(lang + ' repeated citation cannot bypass the final event-minute check', async () => {
+    await assert.rejects(simulatedAnalyst(wrongTime).answer(question, evidence), { code: 'AI_FACT_CHECK_FAILED' });
+  });
+  test(lang + ' repeated citation cannot establish unknown substitution roles', async () => {
+    await assert.rejects(simulatedAnalyst(guessedRoles).answer(question, evidence), { code: 'AI_FACT_CHECK_FAILED' });
+  });
+  test(lang + ' correct repeated citation preserves the full answer', async () => {
+    assert.equal((await simulatedAnalyst(valid).answer(question, evidence)).answer, valid);
+  });
+}
