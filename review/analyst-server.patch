+const { seasonAnswer } = require('../season-answer');
+
+for (const question of ['Compare Barcelona and Real Madrid in the UCL season 2025/26',
+  'قارن برشلونة وريال مدريد في UCL موسم ٢٠٢٥/٢٦']) {
+  test('UCL comparison uses cup totals even when domestic totals are available: ' + question, async () => {
+    const provider = { load: async path => {
+      const params = new URLSearchParams(path.split('?')[1]);
+      const team = Number(params.get('team'));
+      const leagues = [{id:140,name:'La Liga',type:'League'}, {id:2,name:'UEFA Champions League',type:'Cup'}];
+      if (path.startsWith('/leagues?')) return { fetchedAt:1, data:leagues.map(league => ({league,seasons:[{year:2025}]})) };
+      const league = leagues.find(row => row.id === Number(params.get('league')));
+      return { fetchedAt:1, data:{team:{id:team,name:team===529?'Barcelona':'Real Madrid'},league:{...league,season:2025},
+        goals:{for:{total:{total:league.id===2?0:73}}}} };
+    }};
+    const evidence = await collectEvidence(provider, question);
+    assert.deepEqual(evidence.clubs.map(c => [c.season.leagueId,c.season.totals.goalsFor]), [[2,0],[2,0]]);
+    const answer = seasonAnswer(question,evidence);
+    assert.match(answer,/UEFA Champions League/);
+    assert.doesNotMatch(answer,/La Liga|73/);
+  });
+}
+test('UCL is a whole abbreviation and conflicts with an explicitly named domestic competition', () => {
+  assert.equal(requestedSeasonScope('ucl and La Liga').ambiguous,true);
+  assert.equal(requestedSeasonScope('UCLA').leagueId,null);
+});
+
+for (const question of [
+  "Compare Barcelona and Real Madrid in the UEFA Women’s Champions League season 2025/26",
+  "قارن برشلونة وريال مدريد في دوري أبطال أوروبا للسيدات موسم ٢٠٢٥/٢٦",
+  "Analyze Barcelona's last match in the UWCL",
+  "Analyze Barcelona's last match in the UEFA Champions League Women"
+]) {
+  test('unsupported women’s competition never supplies men’s club evidence: ' + question, async () => {
+    const calls = [];
+    const evidence = await collectEvidence({ load: async path => {
+      calls.push(path);
+      return { fetchedAt: 1, data: [] };
+    } }, question);
+    assert.deepEqual(calls, []);
+    assert.deepEqual(evidence.clubs, []);
+    assert.ok(evidence.missing.some(note => /competition/i.test(note)));
+    assert.equal(requestedSeasonScope(question).leagueId, null);
+  });
+}
