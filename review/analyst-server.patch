+ const before=structuredClone(row);
+ const data={'/players/profiles':[{player:row.player}],'/players/teams':[{team:{id:50},seasons:[2025]}],'/players':[row],'/leagues':[{league:{id:39},seasons:[{year:2025}]}],'/players/topscorers':[row]};
+ const e=await collectEvidence({load:async path=>({fetchedAt:1,data:data[path.split('?')[0]]||[]})},question);
+ assert.deepEqual(row,before,'provider rows must not be mutated');
+ return e.playerProfiles?.[0]?.statistics[0]?.statistics[0]||e.scoringLeaders[0].statistics[0];
+}
+const questions=['Analyze Haaland Premier League season 2025/26','حلل هالاند الدوري الإنجليزي موسم ٢٠٢٥/٢٦','Premier League top scorers season 2025/26','هدافو الدوري الإنجليزي موسم ٢٠٢٥/٢٦'];
+for(const q of questions)test('withholds malformed player shooting counts: '+q,async()=>{
+ for(const bad of [-1,0.5,'12',true,Number.MAX_SAFE_INTEGER+1,{},[],NaN,Infinity]) {
+  for(const [key,out,other] of [['total','total','onTarget'],['on','onTarget','total']]) {
+   const s=await evidence(q,{total:0,on:0,[key]:bad});
+   assert.equal(s.shooting[out],null,'invalid '+key+' must not reach model');
+   assert.equal(s.shooting[other],0);
+   assert.deepEqual(s.scoring,{goals:0,assists:null,conceded:null,saves:null});
+   assert.deepEqual(s.warnings,['Invalid player shooting counts withheld; null is unknown, not zero.']);
+  }
+ }
+});
+test('preserves zero, safe counts and unknowns and retains both validation warnings',async()=>{
+ for(const q of questions) {
+  for(const shots of [{total:Number.MAX_SAFE_INTEGER,on:0},{total:0,on:null},undefined,null,{}]) {
+   const s=await evidence(q,shots);
+   assert.deepEqual(s.shooting,{total:shots?.total??null,onTarget:shots?.on??null});
+   assert.ok(!s.warnings?.length);
+  }
+  const s=await evidence(q,{total:'3',on:0},{total:'2'});
+  assert.equal(s.scoring.goals,null);assert.equal(s.shooting.total,null);
+  assert.deepEqual(s.warnings,['Invalid player scoring counts withheld; null is unknown, not zero.','Invalid player shooting counts withheld; null is unknown, not zero.']);
+ }
+});
+
+for (const question of questions) {
+  test('withholds contradictory shot totals and preserves independent counts: ' + question, async () => {
+    const result = await evidence(question, { total: 2, on: 3 }, { total: 1 });
+    assert.deepEqual(result.shooting, { total: null, onTarget: null });
+    assert.equal(result.scoring.goals, 1);
+    assert.deepEqual(result.warnings, ['Shots on target exceed total shots; both counts withheld.']);
+  });
+}
+
+test('preserves equal shot counts and independently supplied on-target counts', async () => {
+  for (const shots of [{ total: 3, on: 3 }, { total: 0, on: 0 }, { on: 3 }]) {
+    const result = await evidence(questions[0], shots);
