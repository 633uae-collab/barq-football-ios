+++ b/server/test/substitution-direction-answer.test.js
@@ -0,0 +1,48 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { GroqAnalyst } = require('../groq');
+
+const evidence = { fetchedAt: 1, events: [{ sourceId: 'event-1', type: 'subst', minute: 18,
+  playerIn: 'A. North', playerOut: 'B. South', directionBasis: 'synthetic verified lineup' }] };
+
+async function generate(content) {
+  const analyst = new GroqAnalyst({ key: 'synthetic', fetchImpl: async () =>
+    Response.json({ choices: [{ finish_reason: 'stop', message: { content } }] }) });
+  return analyst.answer('Explain the substitution', evidence);
+}
+
+for (const text of [
+  "18′ **B. South** replaced **A. North** [event-1].",
+  "18′ B. South came on for A. North (event-1)",
+  "١٨′ – دخل B. South محل A. North (event-1)"
+]) test('rejects a cited substitution with reversed players: ' + text, async () => {
+  await assert.rejects(generate(text), { code: 'AI_FACT_CHECK_FAILED' });
+});
+
+test('correct direction, a negated claim and a passive description are not flagged as reversals', async () => {
+  for (const text of [
+    "18′ A. North replaced B. South [event-1].",
+    "١٨′ دخل A. North محل B. South (event-1)",
+    "18′ B. South did not replace A. North (event-1)",
+    "18′ B. South was replaced by A. North (event-1)"
+  ]) assert.equal((await generate(text)).answer, text);
+});
+
+for (const text of [
+  'B. South replaced A. North. [event-1]',
+  'دخل B. South بدل A. North. (event-١)',
+  '- Minute 18: **B. South** came on for **A. North** [event-1].',
+  '• الدقيقة ١٨: دخل B. South محل A. North! (event-١).'
+]) test('rejects the reversed substitution in a formatted sentence: ' + text, async () => {
+  await assert.rejects(generate(text), { code: 'AI_FACT_CHECK_FAILED' });
+});
+
+test('a formatted citation preserves correct, negated and interrogative text', async () => {
+  for (const text of [
+    '- Minute 18: **A. North** came on for **B. South**. [event-1]',
+    '• الدقيقة ١٨: دخل A. North محل B. South! (event-١).',
+    'Minute 18: B. South did not replace A. North. [event-1]',
+    'دخل B. South محل A. North؟ (event-١)'
+  ]) assert.equal((await generate(text)).answer, text);
+});
