+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const {seasonAnswer} = require('../season-answer');
+const {finalizeSeasonAnswer} = require('../season-final-answer');
+const evidence = totals => ({seasonOnlyComparison:true,clubs:[{
+  teamId:90001,team:{id:90001,name:'Synthetic Club'},season:{verified:true,
+    team:{id:90001,name:'Synthetic Club'},leagueId:901,league:'Synthetic League',year:2025,totals}
+}]});
+for (const q of ['Compare synthetic season statistics','قارن إحصاءات موسم مصطنع']) {
+  test('withhold goals contradicting scoreless match counts: '+q,()=>{
+    for (const totals of [
+      {played:7,failedToScore:7,goalsFor:1},
+      {played:7,failedToScore:2,goalsFor:4},
+      {played:7,cleanSheets:7,goalsAgainst:1},
+      {played:7,cleanSheets:2,goalsAgainst:4},
+      {played:0,failedToScore:0,goalsFor:1},
+      {played:0,cleanSheets:0,goalsAgainst:1}
+    ]) {
+      const input=evidence(totals), original=structuredClone(input);
+      assert.match(seasonAnswer(q,input),/حُجبت|withheld/);
+      const final=finalizeSeasonAnswer(q,'Synthetic unverified interpretation.',{...input,seasonOnlyComparison:false});
+      assert.match(final.answer,/حُجبت|withheld/);
+      assert.doesNotMatch(final.answer,/Synthetic Club/);
+      assert.equal(final.model,'verified-provider-data');
+      assert.deepEqual(input,original);
+    }
+  });
+  test('preserve consistent goals, zeros and incomplete counts: '+q,()=>{
+    for (const totals of [
+      {played:0,failedToScore:0,cleanSheets:0,goalsFor:0,goalsAgainst:0},
+      {played:7,failedToScore:7,cleanSheets:7,goalsFor:0,goalsAgainst:0},
+      {played:7,failedToScore:2,cleanSheets:2,goalsFor:5,goalsAgainst:500},
+      {played:7,failedToScore:0,goalsFor:Number.MAX_SAFE_INTEGER},
+      {played:7,failedToScore:null,goalsFor:1},
+      {played:null,failedToScore:7,goalsFor:1},
+      {played:7,cleanSheets:7,goalsAgainst:null}
+    ]) assert.doesNotMatch(seasonAnswer(q,evidence(totals)),/حُجبت|withheld/);
+  });
+}
