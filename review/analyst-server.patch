+++ b/server/test/season-matchday.test.js
@@ -0,0 +1,24 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { reconcileFinishedSeason } = require('../season-matchday');
+
+test('a final updates a lagging aggregate once, only with matching prior totals and unique scoped fixtures', () => {
+  const totals = { played: 1, wins: 0, draws: 1, losses: 0, goalsFor: 1, goalsAgainst: 1, cleanSheets: 0, failedToScore: 0 };
+  const club = () => ({ teamId: 1001, season: { leagueId: 140, year: 2026, totals: { ...totals } } });
+  const fixture = n => ({ fixture: { id: n, status: { short: 'FT' }, date: '2026-09-0'+n+'T12:00:00Z' },
+    league: { id:140, season:2026, round:'Regular Season - '+n },
+    teams:{ home:{id:2000+n,name:'Opponent'},away:{id:1001,name:'Test team'} },
+    goals:{ home:1, away:n } });
+  const page = rows => ({ paging:{current:1,total:1},data:rows });
+  const now = Date.UTC(2026,10,22), records=page([fixture(2),fixture(1)]), current=club();
+  assert.equal(reconcileFinishedSeason(current, records, now),'updated');
+  assert.deepEqual(current.season.totals,{...totals,played:2,wins:1,goalsFor:3,goalsAgainst:2});
+  assert.equal(reconcileFinishedSeason(current, records, now),'snapshot');
+  for (const mutate of [p => {p.paging.total=2}, p => {p.data[0].fixture.id=1},
+    p => {p.data[1].goals.away=4}, p => {p.data[0].league.season=2025},
+    p => {p.data[0].fixture.status.short='2H'}]) {
+    const faulty=structuredClone(records), untouched=club(); mutate(faulty);
+    assert.equal(reconcileFinishedSeason(untouched,faulty,now),'unconfirmed');
+    assert.deepEqual(untouched.season.totals,totals);
+  }
+});
