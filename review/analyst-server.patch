+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { Provider } = require('../provider');
+
+for (const status of [200, 205]) {
+  test('empty JSON body cannot substitute an older score at HTTP ' + status, async () => {
+    const path = '/fixtures?id=90001';
+    let now = 0, calls = 0;
+    const provider = new Provider({
+      key: 'synthetic', now: () => now,
+      fetchImpl: async () => {
+        calls++;
+        if (calls === 2) return new Response(null, {status, headers: {'content-type': 'application/json'}});
+        return Response.json({response: [{fixture: {id: 90001}, goals: {home: calls, away: 0}}]});
+      }
+    });
+    const first = await provider.get(path, 100);
+    now = 110;
+    await assert.rejects(provider.get(path, 100), {code: 'UPSTREAM_INVALID_JSON'});
+    assert.equal(calls, 2);
+    assert.equal(provider.active, 0);
+    assert.equal(provider.pending.size, 0);
+    assert.deepEqual(provider.cache.get(path).data, first.data);
+    const fresh = await provider.get(path, 100);
+    assert.equal(fresh.stale, false);
+    assert.deepEqual(fresh.data[0].goals, {home: 3, away: 0});
+  });
+}
+
+test('204 remains a successful empty fixture collection', async () => {
+  const provider = new Provider({key: 'synthetic', fetchImpl: async () => new Response(null, {status: 204})});
+  assert.deepEqual((await provider.get('/fixtures')).data, []);
+});
