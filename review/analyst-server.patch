new file mode 100644
index 0000000000000000000000000000000000000000..c6d0847ac7d959cd2df4840df2296d50e2090700
--- /dev/null
+++ b/server/test/chat-generation-cancel.test.js
@@ -0,0 +1,72 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const express = require('express');
+const { mountChat } = require('../chat');
+const { GroqAnalyst } = require('../groq');
+
+async function listen(server) {
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  return 'http://127.0.0.1:' + server.address().port;
+}
+async function stop(server) {
+  server.closeAllConnections();
+  await new Promise(resolve => server.close(resolve));
+}
+for (const partialBody of [false, true]) {
+  test('client disconnect cancels local generation ' + (partialBody ? 'during body' : 'before headers'), {timeout: 5000}, async t => {
+    const started = Promise.withResolvers(), closed = Promise.withResolvers(), finished = Promise.withResolvers();
+    let calls = 0, writes = 0, now = Date.UTC(2026, 0, 1);
+    const complete = JSON.stringify({choices: [{finish_reason: 'stop', message: {content: 'Synthetic control.'}}]});
+    const upstream = http.createServer((req, res) => {
+      if (++calls > 1) return res.end(complete);
+      res.once('close', closed.resolve);
+      if (partialBody) res.write('{"choices":');
+      if (!partialBody) started.resolve();
+    });
+    const upstreamUrl = await listen(upstream);
+    const analyst = new GroqAnalyst({key: 'synthetic', freePlanConfirmed: true, chatEnabled: true,
+      now: () => now, fetchImpl: async (_, options) => {
+        const response = await fetch(upstreamUrl, options);
+        if (partialBody) started.resolve();
+        return response;
+      }});
+    const app = express();
+    app.use(express.json());
+    app.use((req, res, next) => {
+      const json = res.json.bind(res);
+      res.json = value => { writes++; return json(value); };
+      next();
+    });
+    mountChat({post: (path, handle) => app.post(path, async (req, res) => {
+      try { await handle(req, res); } finally { finished.resolve(); }
+    })}, {analyst, provider: {load: async () => ({data: [], fetchedAt: now})}});
+    app.use((err, req, res, next) => res.status(err.status || 500).json({code: err.code}));
+    const server = http.createServer(app);
+    const url = await listen(server) + '/api/analyst/chat';
+    t.after(async () => { await stop(upstream); await stop(server); });
+    const options = {method: 'POST', headers: {'content-type': 'application/json'}};
+    const body = JSON.stringify({question: 'Synthetic analysis'});
+    const client = http.request(url, options);
+    client.on('error', () => {});
+    client.end(body);
+    await started.promise;
+    client.destroy();
+    let timer;
+    try {
+      await Promise.race([Promise.all([closed.promise, finished.promise]), new Promise((_, reject) => {
+        timer = setTimeout(() => reject(new Error('Disconnected generation still active')), 1000);
+      })]);
+    } finally { clearTimeout(timer); }
+    assert.equal(analyst.active, false);
+    assert.equal(writes, 0);
+    assert.equal((await fetch(url, {...options, body})).status, 429);
+    assert.equal(calls, 1);
+    now += 65001;
+    const next = await fetch(url, {...options, body});
+    assert.equal(next.status, 200);
+    assert.equal((await next.json()).answer, 'Synthetic control.');
+    assert.equal(calls, 2);
+  });
+}
diff --git a/server/test/chat-retry-window.test.js b/server/test/chat-retry-window.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..e9c9ffee8b7f8114c566d2239107742f249917aa
--- /dev/null
+++ b/server/test/chat-retry-window.test.js
@@ -0,0 +1,54 @@
+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { createApp } = require('../app');
+const { GroqAnalyst } = require('../groq');
+
+async function openChat(t, lastSend, upstreamWait, limitedCall) {
+  let now = lastSend - (limitedCall - 1) * 65000;
+  let calls = 0;
+  const analyst = new GroqAnalyst({ key: 'synthetic', chatEnabled: true, freePlanConfirmed: true,
+    now: () => now, fetchImpl: async () => {
+      calls++;
+      if (calls === limitedCall && upstreamWait !== null) {
+        return new Response(null, { status: 429, headers: { 'Retry-After': String(upstreamWait) } });
+      }
+      return Response.json({ choices: [{ finish_reason: 'stop', message: { content: 'Synthetic answer' } }] });
+    } });
+  const provider = { load: async () => ({ data: [{ fixture: { id: 7 } }], fetchedAt: now }) };
+  const server = createApp({ analyst, provider, storage: {} }).listen(0, '127.0.0.1');
+  await new Promise(resolve => server.once('listening', resolve));
+  t.after(() => new Promise(resolve => server.close(resolve)));
+  async function send() {
+    const response = await fetch('http://127.0.0.1:' + server.address().port + '/api/analyst/chat', {
+      method: 'POST', headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ question: 'Analyze', context: { fixtureId: 7 } })
+    });
+    await response.json();
+    return [response.status, response.headers.get('retry-after')];
+  }
+  for (let i = 1; i < limitedCall; i++) {
+    assert.deepEqual(await send(), [200, null]);
+    now += 65000;
+  }
+  return { send, advance: ms => { now += ms; }, calls: () => calls };
+}
+
+for (const [label, upstreamWait, limitedCall, wait] of [
+  ['local spacing after a short upstream reset', 2, 1, 65],
+  ['daily cap and spacing across midnight', null, 20, 65],
+  ['daily cap and a longer upstream reset across midnight', 120, 20, 120],
+  ['daily cap later than the upstream reset', 120, 20, 3600]
+]) test('chat reports the effective retry window for ' + label, async t => {
+  const lastSend = Date.UTC(2026, 0, 2) - (wait === 3600 ? 3600000 : 5000);
+  const chat = await openChat(t, lastSend, upstreamWait, limitedCall);
+  if (upstreamWait === null) assert.deepEqual(await chat.send(), [200, null]);
+  else assert.deepEqual(await chat.send(), [429, String(wait)]);
+  assert.deepEqual(await chat.send(), [429, String(wait)]);
+  chat.advance(wait * 1000 - 1);
+  assert.deepEqual(await chat.send(), [429, '1']);
+  assert.equal(chat.calls(), limitedCall);
+  chat.advance(1);
+  assert.deepEqual(await chat.send(), [200, null]);
+  assert.equal(chat.calls(), limitedCall + 1);
+});
