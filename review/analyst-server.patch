+  const e=await collectEvidence({load:async path=>({fetchedAt:1,data:path.startsWith('/players/profiles')?[{player:row().player}]:path.startsWith('/players/teams')?[membership()]:path.startsWith('/players?')?[row('Foreign Club')]:[]})},q);
+  assert.deepEqual(e.playerProfiles[0].statistics,[]);
