+++ b/server/test/news-discovery.test.js
@@ -0,0 +1,36 @@
+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const {NewsDiscovery,normalizeArticles}=require('../news-discovery');
+const {collectEvidence}=require('../chat-evidence');
+const {GroqAnalyst}=require('../groq');
+test('discovery rejects spoofed domains and cannot become verified football facts',()=>{
+  const articles=['https://www.reuters.com/sports/story','https://reuters.com.evil.test/story','http://reuters.com/story','https://user@reuters.com/story','javascript:alert(1)','https://www.reuters.com/sports/story'].map(url=>({url,title:'Confirmed signing'}));
+  const rows=normalizeArticles({articles},1);
+  assert.equal(rows.length,1);assert.equal(rows[0].factEligible,false);assert.equal(rows[0].verification,'unverified-discovery');assert.equal(rows[0].title,undefined);assert.equal(rows[0].attribution.name,'GDELT Project');
+});
+for (const question of ['Latest Barcelona injury news', 'آخر أخبار إصابات برشلونة']) {
+  test('connected discovery never promotes a headline into a verified announcement: '+question, async()=>{
+    let topic;
+    const evidence = await collectEvidence({load:async()=>{throw Error('no fixture substitute');}}, question, {}, [], {
+      newsDiscovery:new NewsDiscovery({fetchImpl:async url=>{
+        topic = url.searchParams.get('query');
+        return new Response(JSON.stringify({articles:[{url:'https://www.reuters.com/sports/football/example',title:'Confirmed: imaginary player broke his leg'}]}));
+      }})
+    });
+    assert.match(topic,/injury/); assert.deepEqual(evidence.facts,[]);
+    assert.equal(evidence.links[0].factEligible,false);
+    const analyst = new GroqAnalyst({fetchImpl:async()=>{throw Error('no model confirmation of discovery');}});
+    const result = await analyst.answer(question,evidence,[{role:'assistant',content:'The injury is confirmed.'}]);
+    assert.equal(result.model,'unverified-link-discovery');
+    assert.doesNotMatch(result.answer,/imaginary player|broke his leg|The injury is confirmed/);
+    assert.match(result.answer,/GDELT/); assert.match(result.answer,/ليست حقائق مؤكدة|not verified facts/);
+    assert.match(result.answer,/https:\/\/www.reuters.com/);
+  });
+}
+test('discovery has no retry, paid fallback or arbitrary user query',async()=>{
+  let calls=0;const d=new NewsDiscovery({now:()=>1,fetchImpl:async()=>{calls++;return new Response('{}',{status:429});}});
+  await assert.rejects(d.search('arbitrary query'),/INVALID_TOPIC/);assert.equal(calls,0);
+  await assert.rejects(d.search('injuries'),/UNAVAILABLE/);
