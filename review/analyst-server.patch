+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { HistoricalKnowledge } = require('../knowledge');
+const { collectEvidence } = require('../chat-evidence');
+
+const cases = [
+  ['When was FC Barcelona founded? Give the verified foundation date and source.',
+    'For that same club, repeat its name and verified foundation year. Do not switch clubs.'],
+  ['When was Barcelona founded?', 'When was that same club founded?'],
+  ['متى تأسس نادي برشلونة؟','متى تأسس النادي نفسه؟'],
+  ['متى تأسس برشلونة؟', 'للنادي نفسه، اذكر اسمه وسنة تأسيسه.']
+];
+
+function source() {
+  return new HistoricalKnowledge({ fetchImpl: async () => new Response(JSON.stringify({
+    entities: { Q7156: { id: 'Q7156', labels: { en: { value: 'FC Barcelona' } },
+      claims: { P571: [{ rank: 'normal', mainsnak: { snaktype: 'value', datavalue: {
+        value: { precision: 11, calendarmodel: 'http://www.wikidata.org/entity/Q1985727', time: '+1901-02-03T00:00:00Z' }
+      } } }] } } }
+  })) });
+}
+
+for (const [prior, question] of cases) test('restored foundation context selects a sourced fact: '+question, async () => {
+  const historical = source();
+  const first = await historical.collect(prior);
+  const context = JSON.parse(JSON.stringify(first.followUpContext));
+  const history = [{role:'user',content:prior},{role:'assistant',content:'Synthetic wrong year 1999'}];
+  const result = await collectEvidence({}, question, context, history, { historicalKnowledge: source() });
+  assert.deepEqual(result.facts,[{subject:'FC Barcelona',property:'foundationDate',value:'1901-02-03'}]);
+  assert.equal(result.sources[0].url,'https://www.wikidata.org/wiki/Q7156');
+  assert.deepEqual(result.followUpContext, context);
+});
+
+test('ambiguous or unrelated references supply no foundation fact', async () => {
+  for (const [question,context,prior] of [
+    [cases[0][1],{teamIds:[529,541]},cases[0][0]],
+    [cases[0][1],{teamIds:[541]},cases[0][0]],
+    [cases[0][1],{teamIds:[529]},'When was Real Madrid founded?'],
+    ['For that same club or Liverpool, repeat its foundation year.',{teamIds:[529]},cases[0][0]]
+  ]) {
+    const result = await collectEvidence({},question,context,[{role:'user',content:prior}],{historicalKnowledge:source()});
+    assert.deepEqual(result.facts,[]);
+  }
+});
diff --git a/server/test/foundation-rank.test.js b/server/test/foundation-rank.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..9fa95ed146c9c0ad0bb91d293e7cbaab2935c3dd
--- /dev/null
+++ b/server/test/foundation-rank.test.js
@@ -0,0 +1,38 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { HistoricalKnowledge } = require('../knowledge');
+
+function dated(rank, date) {
+  return { rank, mainsnak: { snaktype: 'value', datavalue: { value: {
+    time: '+' + date + 'T00:00:00Z', precision: 11,
+    calendarmodel: 'http://www.wikidata.org/entity/Q1985727'
+  } } } };
+}
+
+async function foundation(statements, question) {
+  const entity = { id: 'Q7156', labels: { en: { value: 'FC Barcelona' } }, claims: { P571: statements } };
+  const source = new HistoricalKnowledge({ fetchImpl: async () => Response.json({ entities: { Q7156: entity } }) });
+  return (await source.collect(question)).facts.map(fact => fact.value);
+}
+
+for (const question of ['When was Barcelona founded?', 'متى تأسس برشلونة؟']) {
+  test('preferred unknown or absent foundation suppresses an ordinary date: ' + question, async () => {
+    for (const snaktype of ['somevalue', 'novalue']) {
+      const statements = [dated('normal', '1901-02-03'), { rank: 'preferred', mainsnak: { snaktype } }];
+      for (const ordered of [statements, statements.toReversed()]) {
+        assert.deepEqual(await foundation(ordered, question), []);
+      }
+    }
+  });
+}
+test('an unresolved same-rank statement prevents presenting a unique foundation day', async () => {
+  const good = dated('preferred', '1901-02-03');
+  for (const other of [{ rank: 'preferred', mainsnak: { snaktype: 'novalue' } }, dated('preferred', '1901-02-30')]) {
+    assert.deepEqual(await foundation([good, other], 'Barcelona history'), []);
+  }
+});
+test('identical preferred dates survive conflicting lower ranks', async () => {
+  const good = dated('preferred', '1901-02-03');
+  assert.deepEqual(await foundation([dated('deprecated', '1904-03-04'), good,
+    dated('normal', '1905-04-05'), structuredClone(good)], 'Barcelona history'), ['1901-02-03']);
+});
diff --git a/server/test/groq-response-shapes.test.js b/server/test/groq-response-shapes.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..d042ed852401741e88754806aa93fa5a723ba1db
--- /dev/null
+++ b/server/test/groq-response-shapes.test.js
@@ -0,0 +1,82 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { GroqAnalyst } = require('../groq');
+
+const choice = content => ({ finish_reason: 'stop', message: { content } });
+async function rejectedThenRecovered(body, raw = false) {
+  let calls = 0, signal;
+  const analyst = new GroqAnalyst({ key: 'synthetic', fetchImpl: async (_url, options) => {
+    signal = options.signal;
+    calls++;
+    if (calls === 1 && raw) return new Response(body);
+    return new Response(JSON.stringify(calls === 1 ? body : { choices: [choice('Synthetic complete answer.')] }));
+  } });
+  await assert.rejects(analyst.answer('Synthetic question', {}), { code: 'AI_INCOMPLETE_RESPONSE' });
+  assert.equal(calls, 1, 'Malformed completions must not trigger an automatic retry');
+  assert.equal(signal.aborted, true);
+  assert.equal(analyst.active, false);
+  assert.equal((await analyst.answer('Synthetic next question', {})).answer, 'Synthetic complete answer.');
+  assert.equal(calls, 2);
+  assert.equal(analyst.active, false);
+}
+
+test('Groq rejects indexed objects masquerading as completion arrays', async () => {
+  await rejectedThenRecovered({ choices: { 0: choice('Synthetic unverified first answer.') } });
+});
+test('Groq withholds ambiguous multiple completions in either order', async () => {
+  const alternatives = [choice('Synthetic answer A.'), choice('Synthetic answer B.')];
+  await rejectedThenRecovered({ choices: alternatives });
+  await rejectedThenRecovered({ choices: [...alternatives].reverse() });
+  await rejectedThenRecovered({ choices: [alternatives[0], alternatives[0]] });
+});
+test('Groq null completion envelopes are incomplete responses rather than connection failures', async () => {
+  await rejectedThenRecovered(null);
+});
+test('Groq still rejects missing, empty, malformed, and truncated completions', async () => {
+  for (const body of [{}, [], { choices: [] }, { choices: [null] },
+    { choices: [choice('  ')] }, { choices: [{ ...choice('partial'), finish_reason: 'length' }] }]) {
+    await rejectedThenRecovered(body);
+  }
+});
+test('Groq transport failures retain their category and release admission without retry', async () => {
+  let calls = 0, signal;
+  const analyst = new GroqAnalyst({ key: 'synthetic', fetchImpl: async (_url, options) => {
+    calls++; signal = options.signal; throw new TypeError('Synthetic transport failure');
+  } });
+  await assert.rejects(analyst.answer('Synthetic question', {}), { code: 'AI_UPSTREAM_UNAVAILABLE' });
+  assert.equal(calls, 1);
+  assert.equal(signal.aborted, true);
+  assert.equal(analyst.active, false);
+});
+
+test('Groq refuses to attribute an explicitly different model to the requested analyst', async () => {
+  await rejectedThenRecovered({ model: 'synthetic-other-model', choices: [choice('Synthetic reply.')] });
+});
+
+test('Groq refuses a completion explicitly attributed to a non-assistant role', async () => {
+  await rejectedThenRecovered({ choices: [{ finish_reason: 'stop', message: { role: 'user', content: 'Synthetic question.' } }] });
+});
+
+test('Groq accepts a completion with the matching model and assistant role', async () => {
+  const model = 'openai/gpt-oss-120b';
+  const analyst = new GroqAnalyst({ fetchImpl: async () => Response.json({
+    model, choices: [{ finish_reason: 'stop', message: { role: 'assistant', content: 'Synthetic answer.' } }]
+  }) });
+  const result = await analyst.answer('Synthetic question', {});
+  assert.equal(result.answer, 'Synthetic answer.');
+  assert.equal(result.model, model);
+});
+
+test('HTTP success with undecodable JSON yields an incomplete reply and permits recovery', async () => {
+  for (const raw of ['', '{"choices":', '<html>synthetic gateway</html>']) {
+    await rejectedThenRecovered(raw, true);
+  }
+});
+
+test('a response stream interrupted during the body read remains a transport failure', async () => {
+  const analyst = new GroqAnalyst({ fetchImpl: async () => new Response(new ReadableStream({
+    start(controller) { controller.error(new TypeError('Synthetic connection closed')); }
+  })) });
+  await assert.rejects(analyst.answer('Synthetic question', {}), { code: 'AI_UPSTREAM_UNAVAILABLE' });
+  assert.equal(analyst.active, false);
+});
diff --git a/server/test/groq-stream-cleanup.test.js b/server/test/groq-stream-cleanup.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..4a05d4b86cc91df4cda0fb8ad88f7cf501583d95
--- /dev/null
+++ b/server/test/groq-stream-cleanup.test.js
@@ -0,0 +1,44 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const { GroqAnalyst } = require('../groq');
+
+// Real HTTP/fetch transport against a local synthetic upstream only.
+for (const [status, code] of [[503, 'AI_UPSTREAM_UNAVAILABLE'], [401, 'AI_AUTH_FAILED'],
+  [403, 'AI_AUTH_FAILED'], [429, 'AI_FREE_QUOTA_REACHED']]) {
+  test(`Groq HTTP ${status} closes its unfinished response immediately without retry`, async t => {
+    let closed, calls = 0, signal;
+    const responseClosed = new Promise(resolve => { closed = resolve; });
+    const server = http.createServer((_req, res) => {
+      res.writeHead(status, { 'content-type': 'application/json', 'retry-after': '120' });
+      res.write('synthetic unfinished error');
+      res.once('close', closed);
+    });
+    await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+    t.after(() => { server.closeAllConnections(); return new Promise(resolve => server.close(resolve)); });
+    const a = new GroqAnalyst({ key: 'synthetic', now: () => 1000, fetchImpl: (_url, opts) => {
+      calls++; signal = opts.signal;
+      return fetch(`http://127.0.0.1:${server.address().port}`, { signal });
+    } });
+    await assert.rejects(a.answer('Synthetic analysis', { fetchedAt: 1 }), { code });
+    let timer;
+    try {
+      await Promise.race([responseClosed, new Promise((_, reject) => {
+        timer = setTimeout(() => reject(new Error('Rejected Groq stream remained open')), 300);
+      })]);
+    } finally { clearTimeout(timer); }
+    assert.equal(signal.aborted, true);
+    assert.equal(a.active, false);
+    assert.equal(calls, 1);
+    if (status === 429) {
+      await assert.rejects(a.answer('Synthetic retry', {}), e => e.code === code && e.retryAfter === 120);
+      assert.equal(calls, 1, 'Quota cooldown must still block new network calls');
+    } else {
+      a.fetch = async () => new Response(JSON.stringify({ choices: [
+        { finish_reason: 'stop', message: { content: 'Synthetic analysis complete.' } }
+      ] }));
+      assert.equal((await a.answer('Synthetic analysis', {})).answer, 'Synthetic analysis complete.');
+      assert.equal(a.active, false);
+    }
+  });
+}
