+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const {collectEvidence}=require('../chat-evidence');
+const stat=()=>({team:{id:50,name:'Synthetic Club'},league:{id:39,name:'Premier League',season:2025},goals:{total:0}});
+const player=()=>({player:{id:1100,name:'Haaland'},statistics:[stat()]});
+const membership=()=>({team:{id:50},seasons:[2025]});
+const league=()=>({league:{id:39},seasons:[{year:2025,current:false}]});
+const evidence=(q,overrides={})=>collectEvidence({load:async path=>{
+ const key=path.split('?')[0];
+ const defaults={'/players/profiles':[{player:player().player}],'/players/teams':[membership()],'/players':[player()],'/leagues':[league()],'/players/topscorers':[player()]};
+ return {fetchedAt:1,data:Object.hasOwn(overrides,key)?overrides[key]:defaults[key]||[]};
+}},q);
+for(const q of ['Analyze Haaland Premier League season 2025/26','حلل هالاند الدوري الإنجليزي موسم ٢٠٢٥/٢٦']) {
+ test('player route tolerates malformed collections and retains valid siblings: '+q,async()=>{
+  for(const key of ['/players/profiles','/players/teams','/players'])for(const bad of [null,{},'invalid']) {
+   const e=await evidence(q,{[key]:bad});
+   assert.ok(e.missing.length>0);
+   assert.ok(e.playerProfiles.length===0||e.playerProfiles[0].statistics.length===0);
+  }
+  const e=await evidence(q,{'/players/profiles':[null,{player:player().player}],'/players/teams':[null,{seasons:'2026'},membership()],'/players':[null,false,player()]});
+  assert.equal(e.playerProfiles[0].season,2025);
+  assert.equal(e.playerProfiles[0].statistics[0].statistics[0].scoring.goals,0);
+ });
+}
+for(const q of ['Premier League top scorers season 2025/26','هدافو الدوري الإنجليزي موسم ٢٠٢٥/٢٦']) {
+ test('leaders tolerate malformed rows before shared scope validation: '+q,async()=>{
+  for(const key of ['/leagues','/players/topscorers'])for(const bad of [null,{},'invalid']) {
+   const e=await evidence(q,{[key]:bad});assert.ok(!e.scoringLeaders?.length);assert.ok(e.missing.length>0);
+  }
+  const bad=player();bad.statistics={};
+  const good=player();good.statistics.unshift(null);
+  const e=await evidence(q,{'/leagues':[null,{league:{id:39},seasons:{}},league()],'/players/topscorers':[null,false,bad,good]});
+  assert.equal(e.leaderSeason,2025);assert.equal(e.scoringLeaders.length,1);
+  assert.equal(e.scoringLeaders[0].statistics[0].scoring.goals,0);
+ });
+}
