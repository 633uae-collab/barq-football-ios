+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { GroqAnalyst } = require('../groq');
+
+const fact = { subject: 'FC Barcelona', property: 'foundationDate', value: '1901-02-03' };
+function generate(question, content, facts = [fact]) {
+  const analyst = new GroqAnalyst({ key: 'synthetic', fetchImpl: async () =>
+    Response.json({ choices: [{ finish_reason: 'stop', message: { content } }] }) });
+  const evidence = { schema: 'fotiq-licensed-history-v1', facts, events: [], fetchedAt: 1 };
+  return analyst.answer(question, evidence, [{ role: 'assistant', content: 'Synthetic guess: 1999' }]);
+}
+
+for (const [question, wrong] of [
+  ['When was FC Barcelona founded?', 'FC Barcelona was founded in **1999**.'],
+  ['متى تأسس نادي برشلونة؟', 'تأسس نادي برشلونة عام ١٩٩٩.']
+]) test('checks the stated foundation year against current club evidence: ' + question, async () => {
+  await assert.rejects(generate(question, wrong), { code: 'AI_FACT_CHECK_FAILED' });
+});
+
+test('another subject or an absent fact cannot support the stated year', async () => {
+  for (const facts of [[], [{ ...fact, subject: 'Synthetic United' }]]) {
+    await assert.rejects(generate('When was Barcelona founded?', 'Barcelona was founded in 1901.', facts),
+      { code: 'AI_FACT_CHECK_FAILED' });
+  }
+});
+
+test('preserves supported years, separate retrieval dates and explicit corrections', async () => {
+  for (const answer of ['FC Barcelona was founded in 1901. Source retrieved in 2026.',
+    'تأسس نادي برشلونة عام ١٩٠١. تاريخ الاسترجاع ٢٠٢٦.',
+    'FC Barcelona was not founded in 1999.', 'Was Barcelona founded in 1999?']) {
+    assert.equal((await generate('Give the verified year.', answer)).answer, answer);
+  }
+});
