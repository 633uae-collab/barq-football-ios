+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { HistoricalKnowledge } = require('../knowledge');
+const { collectEvidence } = require('../chat-evidence');
+
+for (const [language, supported, otherClub] of [
+  ['en', 'When was FC Barcelona founded?', ['When was Barcelona SC founded?', 'Barcelona Sporting Club history', 'When was Barcelona de Guayaquil founded?']],
+  ['ar', 'متى تأسس نادي برشلونة؟', ['متى تأسس برشلونة الإكوادوري؟', 'تاريخ برشلونة سبورتينغ كلوب', 'متى تأسس برشلونة إس سي؟']]
+]) {
+  test(language + ' distinct Barcelona club cannot inherit a foundation fact or a cached source', async () => {
+    let calls = 0;
+    const historicalKnowledge = new HistoricalKnowledge({fetchImpl: async () => {
+      calls++;
+      return Response.json({entities: {Q7156: {id: 'Q7156', labels: {en: {value: 'FC Barcelona'}},
+        claims: {P571: [{rank: 'normal', mainsnak: {snaktype: 'value', datavalue: {value: {
+          precision: 11, calendarmodel: 'http://www.wikidata.org/entity/Q1985727', time: '+1901-02-03T00:00:00Z'
+        }}}}]}}}});
+    }});
+    const collect = (question, context, history) => collectEvidence({}, question, context, history, {historicalKnowledge});
+    async function verifyUnmapped(question, context, history) {
+      const result = await collect(question, context, history);
+      assert.deepEqual(result.facts, []);
+      assert.deepEqual(result.sources, []);
+      assert.equal(result.followUpContext, undefined);
+      assert.ok(result.missing.length);
+    }
+    await verifyUnmapped(otherClub[0], {}, []);
+    assert.equal(calls, 0);
+    const valid = await collect(supported, {}, []);
+    assert.equal(valid.facts[0].value, '1901-02-03');
+    for (const question of otherClub) {
+      await verifyUnmapped(question, valid.followUpContext, [{role: 'user', content: supported}]);
+    }
+    assert.equal(calls, 1);
+  });
+}
