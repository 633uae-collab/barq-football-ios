@@ -0,0 +1,40 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { createApp } = require('../app');
+
+const fields = [['games','appearences','apps'],['games','minutes','minutes'],
+  ['goals','total','goals'],['goals','assists','assists'],['shots','total','shots'],
+  ['shots','on','sot'],['passes','total','passes'],['passes','key','keyPasses'],
+  ['dribbles','success','dribbles'],['tackles','total','tackles'],
+  ['cards','yellow','yellow'],['cards','red','red']];
+const stat = () => ({team:{id:9001},league:{id:901,season:2025}});
+async function check(t, row) {
+  const before = structuredClone(row);
+  const server = createApp({provider:{get:async()=>({data:[{player:{id:7001,name:'Synthetic player'},statistics:[row]}],stale:false})}}).listen(0,'127.0.0.1');
+  await new Promise(r=>server.once('listening',r));
+  t.after(()=>new Promise(r=>server.close(r)));
+  const response = await fetch(`http://127.0.0.1:${server.address().port}/api/player/7001?season=2025`);
+  assert.equal(response.status,200);
+  const body = await response.json();
+  assert.deepEqual(row,before);
+  assert.equal(body.player.id,7001);
+  assert.deepEqual(body.stats[0].team,row.team);
+  assert.deepEqual(body.stats[0].league,row.league);
+  return body.stats[0];
+}
+for (const shape of ['null','missing-field','missing-group']) {
+  test(`player response preserves unknown counts for ${shape}`,async t=>{
+    const row=stat();
+    if(shape!=='missing-group')for(const [group,key] of fields){row[group]??={};if(shape==='null')row[group][key]=null;}
+    const result=await check(t,row);
+    for(const [,,key] of fields)assert.equal(result[key],null,key);
+  });
+}
+test('player response distinguishes unknown, real zero and positive counts in one row',async t=>{
+  const row=stat();
+  const values=fields.map((_,i)=>[null,0,12][i%3]);
+  values[4]=12; values[5]=0; // A known on-target count cannot exceed the total shots.
+  fields.forEach(([group,key],i)=>(row[group]??={})[key]=values[i]);
+  const result=await check(t,row);
+  fields.forEach(([,,key],i)=>assert.equal(result[key],values[i],key));
+});
