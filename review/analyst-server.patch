+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { collectEvidence } = require('../chat-evidence');
+
+async function compare(question, mbappeId, lewandowskiId) {
+  const teamsRequested = [];
+  const profiles = {
+    Mbappe: { id: mbappeId, name: 'K. Mbappé', firstname: 'Kylian', lastname: 'Mbappé' },
+    Lewandowski: { id: lewandowskiId, name: 'R. Lewandowski', firstname: 'Robert', lastname: 'Lewandowski' }
+  };
+  const provider = { async load(path) {
+    const url = new URL(path, 'https://synthetic.invalid');
+    let data = [];
+    if (url.searchParams.has('search')) data = [{ player: profiles[url.searchParams.get('search')] }];
+    if (url.pathname === '/players/teams') {
+      teamsRequested.push(Number(url.searchParams.get('player')));
+      data = [{ team: { id: 81 }, seasons: [2025] }];
+    }
+    return { data, paging: { current: 1, total: 1 }, fetchedAt: 1 };
+  } };
+  const evidence = await collectEvidence(provider, question, { playerIds: [7109] });
+  return { evidence, teamsRequested };
+}
+for (const question of ['Compare Mbappe and Lewandowski', 'قارن ليفاندوفسكي ومبابي']) {
+  test('different players sharing one search-result ID cannot carry statistics or context: ' + question, async () => {
+    const { evidence, teamsRequested } = await compare(question, 7101, 7101);
+    assert.deepEqual(teamsRequested, []);
+    assert.deepEqual(evidence.followUpContext, {});
+    assert.ok(!evidence.playerProfiles?.length);
+    assert.ok(evidence.missing.some(message => /same.*identifier/i.test(message)));
+  });
+}
+test('a collision with the Haaland alias preserves an independently resolved third player', async () => {
+  const { evidence, teamsRequested } = await compare('Compare Haaland, Mbappe and Lewandowski', 1100, 7102);
+  assert.deepEqual(teamsRequested, [7102]);
+  assert.deepEqual(evidence.followUpContext, {});
+  assert.ok(evidence.missing.some(message => /comparison.*follow-up/i.test(message)));
+  assert.deepEqual(evidence.playerProfiles.map(row => row.playerId), [7102]);
+});
diff --git a/server/test/news-discovery.test.js b/server/test/news-discovery.test.js
