+'use strict';
+// GDELT dataset terms: https://www.gdeltproject.org/about.html#termsofuse
+// Discovery metadata only. This grants no rights to copy publisher articles,
+// and an indexed headline is NOT verification of an injury or transfer.
+const publishers = new Set(['reuters.com','apnews.com','bbc.com','bbc.co.uk','theguardian.com','fifa.com','uefa.com','fcbarcelona.com','realmadrid.com']);
+const topics = { news: '(football OR soccer)', injuries: '(football OR soccer) (injury OR injured)', transfers: '(football OR soccer) (transfer OR signing)' };
+function normalizeArticles(data, retrievedAt) {
+  if (!Array.isArray(data?.articles)) throw Error('NEWS_INVALID_RESPONSE');
+  const seen = new Set();
+  return data.articles.flatMap(item => {
+    let url; try { url = new URL(item.url); } catch { return []; }
+    const host = url.hostname.toLowerCase().replace(/^www\./,'');
+    if (url.protocol !== 'https:' || url.username || url.password || url.port || !publishers.has(host) || seen.has(url.href)) return [];
+    seen.add(url.href);
+    return [{url:url.href,publisher:host,discoveredAt:item.seendate || null,retrievedAt,
+      verification:'unverified-discovery', factEligible:false,
+      attribution:{name:'GDELT Project',url:'https://www.gdeltproject.org/'}}];
+  }).slice(0,20);
+}
+class NewsDiscovery {
+  constructor({fetchImpl=fetch,now=Date.now}={}) { this.fetch=fetchImpl;this.now=now;this.nextAt=0;this.active=false; }
+  async search(topic) {
+    if (!Object.hasOwn(topics,topic)) throw Error('NEWS_INVALID_TOPIC');
+    if (this.active || this.now()<this.nextAt) throw Error('NEWS_RATE_LIMIT');
+    this.active=true;this.nextAt=this.now()+65000;
+    try {
+      const url=new URL('https://api.gdeltproject.org/api/v2/doc/doc');
+      url.search=new URLSearchParams({query:topics[topic],mode:'artlist',format:'json',maxrecords:'20',timespan:'24h',sort:'datedesc'});
+      const response=await this.fetch(url,{redirect:'error',signal:AbortSignal.timeout(10000)});
+      if (!response.ok) throw Error('NEWS_UNAVAILABLE');
+      const text=await response.text();
+      if (Buffer.byteLength(text)>200000) throw Error('NEWS_RESPONSE_TOO_LARGE');
+      return normalizeArticles(JSON.parse(text),this.now());
+    } finally { this.active=false; }
+  }
+}
+module.exports={NewsDiscovery,normalizeArticles};
