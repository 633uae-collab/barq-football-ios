+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { collectEvidence } = require('../chat-evidence');
+const { seasonAnswer } = require('../season-answer');
+const { requestedSeasonScope } = require('../season-scope');
+
+for (const question of ['Compare Barcelona and Real Madrid in the Champions League season 2025/26', 'قارن برشلونة وريال مدريد في دوري أبطال أوروبا موسم ٢٠٢٥/٢٦']) {
+  test('explicit competition and season cannot fall back to current domestic rows: '+question, async () => {
+    for (const wrongScope of [false, true]) {
+      const paths = [];
+      const e = await collectEvidence({ load: async path => {
+        paths.push(path);
+        const p = new URLSearchParams(path.split('?')[1]);
+        return { fetchedAt: 1, data: path.startsWith('/leagues?') ? [
+          { league: { id: 140, name: 'La Liga', type: 'League' }, seasons: [{year:2026,current:true}] },
+          { league: { id: 2, name: 'Champions League', type: 'Cup' }, seasons: [{year:2025,current:false}] }
+        ] : { team: {id:Number(p.get('team')),name:Number(p.get('team'))===529?'Barcelona':'Real Madrid'},
+          league:{id:wrongScope?140:2,name:wrongScope?'La Liga':'Champions League',season:wrongScope?2026:2025},
+          fixtures:{played:{total:1},wins:{total:1},draws:{total:0},loses:{total:0}}, goals:{for:{total:{total:7}}} } };
+      } }, question);
+      assert.ok(paths.includes('/leagues?team=529&season=2025&id=2'));
+      assert.ok(paths.includes('/teams/statistics?team=541&league=2&season=2025'));
+      assert.ok(!paths.some(p=>p.includes('current=true')));
+      const answer = seasonAnswer(question,e);
+      if (wrongScope) assert.doesNotMatch(answer,/(?:Goals for|له): 7/);
+      else { assert.match(answer,/Champions League — 2025/); assert.doesNotMatch(answer,/La Liga/); }
+    }
+  });
+}
+test('ambiguous seasons fail closed without querying arbitrary current data', async () => {
+  for (const q of ['Compare Barcelona and Real Madrid season 2024/26', 'Compare Barcelona and Real Madrid seasons 2024 and 2025', 'Compare Barcelona and Real Madrid last season', 'Compare Barcelona and Real Madrid this season in the Intercontinental Cup']) {
+    const e = await collectEvidence({load:async()=>{throw Error('must clarify');}},q);
+    assert.equal(e.requestedSeasonScope.ambiguous,true);
+    assert.match(seasonAnswer(q,e),/specify one competition and one season/);
+  }
+  assert.equal(requestedSeasonScope('موسم ٢٠٢٥/٢٦ في الليغا').year,2025);
+});
+test('general comparison and upcoming venue splits reject swapped provider identities', async () => {
+  for (const question of ['Compare Barcelona and Real Madrid', 'Predict Barcelona next match']) {
+    const e = await collectEvidence({load:async path=>({fetchedAt:1,data:
+      path.startsWith('/leagues?') ? [{league:{id:140,name:'La Liga',type:'League'},seasons:[{year:2026,current:true}]}] :
+      path.startsWith('/teams/statistics?') ? {team:{id:50,name:'Wrong team'},league:{id:140,season:2026},fixtures:{wins:{total:999,home:999,away:999}}} :
+      [{fixture:{id:8,status:{short:'NS'}},league:{id:140,name:'La Liga',season:2026},teams:{home:{id:529},away:{id:541}},goals:{home:1,away:0}}]
+    })},question);
+    assert.doesNotMatch(JSON.stringify(e.clubs),/999/);
+    assert.ok(e.clubs.every(c=>!c.nextFixtureVenue));
+    assert.ok(e.missing.some(m=>/identity/.test(m)));
+  }
+});
+test('final renderer rejects valid data bound to a different requested scope',()=>{
+  const team = {id:529,name:'Barcelona'};
+  const evidence = {seasonOnlyComparison:true,requestedSeasonScope:{year:2025,leagueId:2},clubs:[{teamId:529,team,season:{team,verified:true,leagueId:140,league:'La Liga',year:2026,totals:{goalsFor:48}}}]};
+  assert.doesNotMatch(seasonAnswer('Compare this season',evidence),/Goals for: 48/);
+});
+
+test('known club ID and name must agree before evidence or final text exposes totals', async () => {
+  const { verifiedTeamSeason } = require('../season-scope');
+  const league = {id:140,season:2025};
+  for (const [id, correct, swapped] of [[529,'Barcelona','Real Madrid'],[541,'Real Madrid','Barcelona']]) {
+    assert.equal(verifiedTeamSeason({team:{id,name:correct},league},id,league),true);
+    assert.equal(verifiedTeamSeason({team:{id,name:swapped},league},id,league),false);
+    const team={id,name:swapped};
+    const e={seasonOnlyComparison:true,clubs:[{teamId:id,team,season:{verified:true,team,leagueId:140,league:'La Liga',year:2025,totals:{goalsFor:987}}}]};
+    assert.doesNotMatch(seasonAnswer('Compare this season',e),/987/);
+  }
+  const e=await collectEvidence({load:async path=>{
+    const team=Number(new URLSearchParams(path.split('?')[1]).get('team'));
+    return {fetchedAt:1,data:path.startsWith('/leagues?')?[{league:{id:140,name:'La Liga',type:'League'},seasons:[{year:2025,current:true}]}]:
+      {team:{id:team,name:team===529?'Real Madrid':'Barcelona'},league,goals:{for:{total:{total:987}}}}};
+  }},'Compare Barcelona and Real Madrid this season');
+  assert.doesNotMatch(JSON.stringify(e.clubs),/987/);
+});
