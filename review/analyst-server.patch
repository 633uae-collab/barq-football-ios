+function analyze(t,mutate,old=false){const s=openStorage(':memory:');t.after(()=>s.close());let now=1000000;const o=new Observations(s,{now:()=>now});const first=detail(now),last=detail(now+480000,4);mutate(old?first:last);o.record(first);now+=480000;const before=structuredClone(last);const r=o.analyze(last);assert.deepEqual(last,before);return r;}
