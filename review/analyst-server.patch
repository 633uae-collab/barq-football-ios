+'use strict';
+// Entity aliases select provider IDs; they are not a source of football facts.
+const competitions = [
+  [140, /la\s*liga|لاليغا|الليغا|الدوري الإسباني|الدوري الاسباني/i],
+  [2, /\bucl\b|champions league|دوري أبطال أوروبا|دوري ابطال اوروبا/i],
+  [39, /premier league|الدوري الإنجليزي|الدوري الانجليزي/i],
+  [143, /copa del rey|كأس ملك إسبانيا|كاس ملك اسبانيا/i]
+];
+const relativeSeasonReference = /\b(?:last|previous|next|upcoming) season\b|الموسم\s+(?:الماضي|السابق|القادم|المقبل|الجاي|الياي)/i;
+const normalizeDigits = text => text.replace(/[٠-٩]/g, n => String('٠١٢٣٤٥٦٧٨٩'.indexOf(n)));
+const seasonYears = normalized => [...normalized.matchAll(/\b((?:19|20)\d{2})(?:\s*[\/–-]\s*(\d{4}|\d{2}))?\b/g)];
+function requestedSeasonScope(question, currentQuestion = question) {
+  const normalized = normalizeDigits(question);
+  const years = seasonYears(normalized);
+  const uniqueYears = [...new Set(years.map(m => Number(m[1])))];
+  // The supported UCL identifier is for the men's competition. Treat an
+  // explicit UWCL request as unsupported before it can match the shorter alias.
+  const womensChampionsLeague = /\buwcl\b|\bwomen(?:['’]?s)?\s+champions league\b|\bchampions league\s+women(?:['’]?s)?\b|دوري [أا]بطال [أا]وروبا (?:للسيدات|للنساء)/i.test(normalized);
+  const otherContinentalChampionsLeague = /\b(?:afc|caf|ofc|concacaf|asian|african)\s+champions league\b|دوري\s+[أا]بطال\s+(?:[آا]سيا|[أاإ]فريقيا)/i.test(normalized);
+  const spanishSecondTier = /\bla\s*liga(?:2\b|\s+hypermotion\b)|\bsegunda divisi[oó]n\b|الدوري\s+ال[اإ]سباني\s+(?:للدرجة|الدرجة)\s+الثانية/i.test(normalized)
+    || /(?:\bla\s*liga|الليغا|لاليغا)\s+2(?=\s*(?:$|[.,?،؟]|\b(?:season|in|(?:19|20)\d{2})\b|موسم))/i.test(normalized);
+  if (womensChampionsLeague || otherContinentalChampionsLeague || spanishSecondTier)
+    return { year: uniqueYears.length === 1 ? uniqueYears[0] : null, leagueId: null, ambiguous: true };
+  const leagues = competitions.filter(([, re]) => re.test(normalized)).map(([id]) => id);
+  const invalidRange = years.some(m => m[2] && m[2] !== String(Number(m[1]) + 1).slice(-m[2].length));
+  const unsupportedCompetition = !leagues.length && /league|cup|كأس|كاس|دوري|بطولة/i.test(normalized)
+    && !/domestic league|الدوري المحلي/i.test(normalized);
+  // An explicit year from another turn cannot resolve "next season" in this one.
+  const relativeSeason = (!years.length && relativeSeasonReference.test(normalized))
+    || (currentQuestion !== question && relativeSeasonReference.test(currentQuestion)
+      && !seasonYears(normalizeDigits(currentQuestion)).length);
+  return { year: uniqueYears.length === 1 ? uniqueYears[0] : null,
+    leagueId: leagues.length === 1 ? leagues[0] : null,
+    ambiguous: invalidRange || uniqueYears.length > 1 || leagues.length > 1 || unsupportedCompetition || relativeSeason };
+}
+// Provider IDs for supported named clubs must not be paired with the other club's name.
+// These aliases establish identity only; they supply no football statistics.
+const knownClubNames = new Map([
+  [40, new Set(['liverpool', 'liverpool fc', 'ليفربول'])],
+  [50, new Set(['manchester city', 'manchester city fc', 'man city', 'مانشستر سيتي'])],
+  [529, new Set(['barcelona', 'fc barcelona', 'برشلونة', 'برشلونه'])],
+  [541, new Set(['real madrid', 'real madrid cf', 'ريال مدريد'])]
+]);
+const normalizedName = value => typeof value === 'string'
+  ? value.normalize('NFKC').trim().toLowerCase().replace(/\s+/g, ' ') : '';
+function verifiedTeamSeason(stats, teamId, league) {
+  if (![teamId, league?.id, league?.season].every(value => Number.isSafeInteger(value) && value > 0)) return false;
+  const names = knownClubNames.get(teamId);
+  const name = normalizedName(stats?.team?.name);
+  const selectedName = normalizedName(league?.name);
+  const statisticsName = normalizedName(stats?.league?.name);
+  return stats?.team?.id === teamId && !!name
+    && (league?.name == null || !!selectedName)
+    && (stats?.league?.name == null || (!!statisticsName && (!selectedName || statisticsName === selectedName)))
+    && (!names || names.has(name))
+    && stats?.league?.id === league?.id && stats?.league?.season === league?.season;
+}
+module.exports = { requestedSeasonScope, verifiedTeamSeason };
+
