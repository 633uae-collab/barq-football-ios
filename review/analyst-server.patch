+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { HistoricalKnowledge } = require('../knowledge');
+
+async function facts(time, question) {
+  const value = { time, precision: 11, calendarmodel: 'http://www.wikidata.org/entity/Q1985727' };
+  const entity = { id: 'Q7156', labels: { en: { value: 'FC Barcelona' } },
+    claims: { P571: [{ rank: 'normal', mainsnak: { snaktype: 'value', datavalue: { value } } }] } };
+  const source = new HistoricalKnowledge({ fetchImpl: async () =>
+    new Response(JSON.stringify({ entities: { Q7156: entity } })) });
+  return (await source.collect(question)).facts;
+}
+
+for (const question of ['متى تأسس برشلونة؟', 'When was FC Barcelona founded?']) {
+  test('invalid Gregorian foundation dates yield no fact: ' + question, async () => {
+    for (const time of ['+1900-02-29T00:00:00Z','+1901-04-31T00:00:00Z',
+      '+1901-00-00T00:00:00Z','+1901-13-01T00:00:00Z','+1901-01-01Tgarbage',['+1901-01-01T00:00:00Z']]) {
+      assert.deepEqual(await facts(time,question),[],String(time));
+    }
+  });
+}
+test('valid leap day and month end retain exact source date', async () => {
+  for (const date of ['2000-02-29','1904-02-29','1901-04-30']) {
+    const result = await facts('+' + date + 'T00:00:00Z','When was Barcelona founded?');
+    assert.deepEqual(result,[{subject:'FC Barcelona',property:'foundationDate',value:date}]);
+  }
+});
