+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { collectEvidence } = require('../chat-evidence');
+const { requestedSeasonScope } = require('../season-scope');
+
+test('repeated mentions of one season identify one scope, including equivalent Arabic ranges', () => {
+  for (const q of ['season 2025/26 and season 2025', 'موسم ٢٠٢٥/٢٦ وموسم 2025/2026'])
+    assert.deepEqual(requestedSeasonScope(q), {year:2025,leagueId:null,ambiguous:false});
+});
+for (const [previous, question] of [
+  ['Compare Barcelona and Real Madrid in La Liga season 2025/26', 'Who won more in season 2025/26?'],
+  ['قارن برشلونة وريال مدريد في الليغا موسم ٢٠٢٥/٢٦', 'من فاز أكثر في موسم ٢٠٢٥/٢٦؟']
+]) test('repeating the season in a follow-up retains verified club evidence: '+question, async () => {
+  const paths=[];
+  const e=await collectEvidence({load:async path=>{
+    paths.push(path);
+    const p=new URLSearchParams(path.split('?')[1]),id=Number(p.get('team'));
+    assert.equal(p.get('season'),'2025');
+    if(path.startsWith('/leagues?')) return {fetchedAt:1,data:[{league:{id:140,name:'La Liga',type:'League'},seasons:[{year:2025}]}]};
+    assert.ok(path.startsWith('/teams/statistics?'));
+    return {fetchedAt:1,data:{team:{id,name:id===529?'Barcelona':'Real Madrid'},league:{id:140,name:'La Liga',season:2025},
+      fixtures:{played:{total:1},wins:{total:id===529?1:0},draws:{total:0},loses:{total:id===529?0:1}}}};
+  }},question,{teamIds:[529,541]},[{role:'user',content:previous}]);
+  assert.equal(e.requestedSeasonScope.ambiguous,false);
+  assert.deepEqual(e.clubs.map(c=>[c.team.id,c.season.year,c.season.totals.wins]),[[529,2025,1],[541,2025,0]]);
+  assert.equal(paths.length,4);
+  assert.deepEqual(e.followUpContext,{teamIds:[529,541]});
+});
+test('repeated years do not hide conflicting seasons, invalid ranges or competitions',()=>{
+  for(const q of ['2025/26 2025/27','2025 2025 2026','2025/26 2025 La Liga Champions League'])
+    assert.equal(requestedSeasonScope(q).ambiguous,true);
+});
