+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { collectEvidence } = require('../chat-evidence');
+const { seasonAnswer } = require('../season-answer');
+
+for (const [anchor, next, last, clarify] of [
+  ['Compare Barcelona and Real Madrid in La Liga season 2025/26', 'next season', 'last season', /specify one competition and one season/i],
+  ['قارن برشلونة وريال مدريد في الليغا موسم ٢٠٢٥/٢٦', 'الموسم الياي', 'الموسم الماضي', /حدّد بطولة واحدة وموسماً واحداً/]
+]) {
+  const ar = next.startsWith('ال');
+  const follow = period => ar ? 'وماذا عن ' + period + '؟' : 'What about ' + period + '?';
+  const cases = [
+    [ar ? 'قارن برشلونة وريال مدريد الموسم القادم' : 'Compare Barcelona and Real Madrid next season', []],
+    [follow(next), [{role: 'user', content: anchor}]],
+    [follow(last), [{role: 'user', content: anchor}]]
+  ];
+  for (const [question, history] of cases) test('clarify the requested relative season: ' + question, async () => {
+    const calls = [];
+    const evidence = await collectEvidence({load: async path => {
+      calls.push(path);
+      return {fetchedAt: 1, data: []};
+    }}, question, {teamIds: [529, 541]}, history);
+    assert.deepEqual(calls, []);
+    assert.equal(evidence.requestedSeasonScope.ambiguous, true);
+    assert.match(seasonAnswer(question, evidence), clarify);
+  });
+}
+
+test('a year supplied in the current question remains usable', () => {
+  const { requestedSeasonScope } = require('../season-scope');
+  for (const current of ['next season 2025/26', 'الموسم المقبل ٢٠٢٥/٢٦']) {
+    assert.deepEqual(requestedSeasonScope(current + ' La Liga', current), {year: 2025, leagueId: 140, ambiguous: false});
+  }
+});
