+'use strict';
+// A provider row is usable only inside the requested player's verified season
+// and team memberships. Do not attach the first returned player's totals to an ID.
+const positiveInteger = value => Number.isSafeInteger(value) && value > 0;
+function verifiedPlayerSeasonRows(rows, playerId, year, leagueId, teams) {
+  const object = value => value !== null && typeof value === 'object' && !Array.isArray(value);
+  if (!Array.isArray(rows) || !Array.isArray(teams)) return [];
+  if (!positiveInteger(playerId) || !positiveInteger(year) || (leagueId != null && !positiveInteger(leagueId))) return [];
+  const scopedTeams = teams.filter(t => object(t) && Array.isArray(t.seasons) && t.seasons.includes(year));
+  const memberships = new Set(scopedTeams.map(t => t.team?.id));
+  const normalizedName = name => typeof name === 'string' ? name.normalize('NFKC').trim().toLowerCase().replace(/\s+/g, ' ') : '';
+  // Supplied membership names must agree; absent names retain the existing ID binding.
+  const matchesMembershipName = s => scopedTeams.filter(t => t.team?.id === s.team.id)
+    .every(t => t.team.name === undefined || (normalizedName(t.team.name) && normalizedName(t.team.name) === normalizedName(s.team.name)));
+  const candidates = rows.filter(p => object(p) && object(p.player) && p.player.id === playerId && typeof p.player.name === 'string' && p.player.name.trim())
+    .map(p => ({ ...p, statistics: (Array.isArray(p.statistics) ? p.statistics : []).filter(s =>
+      object(s) && positiveInteger(s.team?.id) && memberships.has(s.team.id) && typeof s.team.name === 'string' && s.team.name.trim()
+      && positiveInteger(s.league?.id) && typeof s.league.name === 'string' && s.league.name.trim()
+      && s.league.season === year && (!leagueId || s.league.id === leagueId)) }))
+    .filter(p => p.statistics.length > 0);
+  // Repeated totals for one player/team/competition/season have no safe winner.
+  // Separate transfer clubs and competitions are distinct scopes, not duplicates.
+  const key = s => `${s.team.id}:${s.league.id}:${s.league.season}`;
+  const counts = new Map();
+  for (const p of candidates) for (const s of p.statistics) {
+    const scope = key(s);
+    counts.set(scope, (counts.get(scope) || 0) + 1);
+  }
+  return candidates.map(p => ({ ...p, statistics: p.statistics.filter(s => counts.get(key(s)) === 1 && matchesMembershipName(s)) }))
+    .filter(p => p.statistics.length > 0);
+}
+module.exports = { verifiedPlayerSeasonRows };
+
