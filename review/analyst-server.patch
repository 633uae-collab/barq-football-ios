+   else if(path.startsWith('/players/teams'))data=[{team:{id:50},seasons:[2026]}];
+   else if(path.startsWith('/players/squads'))data=[{team:{id:50}}];
+   else if(path.startsWith('/fixtures?'))data=[fixture,{...fixture,fixture:{id:8},teams:{home:{id:529},away:{id:541}}}];
+   else if(path.startsWith('/fixtures/players')) {const g=group();g.team={id:40,name:'Liverpool'};data=[g];}
+   return {data,fetchedAt:1};
+  }},question);
+  assert.deepEqual(e.playerProfiles[0].lastFiveAppearances,[]);
+  assert.equal(e.playerProfiles[0].lastFiveTeamMatches.length,1);
+  assert.equal(e.playerProfiles[0].lastFiveTeamMatches[0].player,null);
+  assert.ok(e.missing.some(x=>x.includes('Only 0 appearances')));
+ });
+}
