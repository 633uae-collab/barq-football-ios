diff --git a/server/test/club-competition-label.test.js b/server/test/club-competition-label.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..e1a094c118bf60a48296ab965830dafb4f75966e
--- /dev/null
+++ b/server/test/club-competition-label.test.js
@@ -0,0 +1,43 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { collectEvidence } = require('../chat-evidence');
+const { seasonAnswer } = require('../season-answer');
+
+const name = 'UEFA Champions League';
+function provider(statsName, available = true) {
+  return { load: async path => {
+    const team = Number(new URLSearchParams(path.split('?')[1]).get('team'));
+    if (path.startsWith('/leagues?'))
+      return { data: available ? [{ league: { id: 2, name, type: 'Cup' }, seasons: [{ year: 2025 }] }] : [], fetchedAt: 1 };
+    assert.equal(path, '/teams/statistics?team=' + team + '&league=2&season=2025');
+    return { data: { team: { id: team, name: team === 529 ? 'Barcelona' : 'Real Madrid' },
+      league: { id: 2, season: 2025, name: team === 529 ? statsName : name },
+      goals: { for: { total: { total: team === 529 ? 17 : 0 } } } }, fetchedAt: 1 };
+  } };
+}
+for (const question of ['Compare Barcelona and Real Madrid in Champions League season 2025/26',
+  'قارن برشلونة وريال مدريد في دوري أبطال أوروبا موسم ٢٠٢٥/٢٦']) {
+  test('withholds totals carrying a contradictory competition name: ' + question, async () => {
+    const evidence = await collectEvidence(provider('La Liga'), question);
+    const [barca, madrid] = evidence.clubs;
+    assert.equal(barca.season.verified, false);
+    assert.equal(barca.season.totals, null);
+    assert.equal(madrid.season.totals.goalsFor, 0);
+    const answer = seasonAnswer(question, evidence);
+    assert.doesNotMatch(answer, /La Liga|\b17\b/);
+    assert.match(answer, /Real Madrid — UEFA Champions League — 2025/);
+  });
+}
+test('aggregate scope describes the historical cup, including when coverage is missing', async () => {
+  const question = 'Compare Barcelona and Real Madrid in Champions League season 2025/26';
+  for (const statsName of [' UEFA   CHAMPIONS League ', undefined]) {
+    const evidence = await collectEvidence(provider(statsName), question);
+    assert.equal(evidence.clubs[0].season.totals.goalsFor, 17);
+    assert.equal(evidence.clubs[0].season.league, name);
+    assert.doesNotMatch(evidence.clubs[0].season.scope, /current|domestic/i);
+    assert.match(evidence.clubs[0].season.scope, /2025/);
+  }
+  const unavailable = await collectEvidence(provider(undefined, false), question);
+  assert.ok(unavailable.missing.some(message => /unavailable/i.test(message)));
+  assert.doesNotMatch(unavailable.missing.join(' '), /current domestic/i);
+});
