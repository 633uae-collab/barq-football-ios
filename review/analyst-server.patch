@@ -0,0 +1,40 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { prepareEvidence } = require('../analyst-evidence');
+const { collectEvidence } = require('../chat-evidence');
+
+test('fixture status never reports an invalid minute or added time without a minute', () => {
+  for (const elapsed of [null, '45', true, -1, 2.5, {}, Number.MAX_SAFE_INTEGER + 1]) {
+    const status = { short: '1H', elapsed, extra: 2 };
+    const copy = structuredClone(status);
+    const evidence = prepareEvidence({ fixture: { status } }, 1000);
+    assert.deepEqual(evidence.status, { short: '1H', elapsed: null, extra: null });
+    assert.deepEqual(status, copy);
+  }
+});
+
+test('valid elapsed minutes survive malformed added time and valid zeros are retained', () => {
+  for (const [elapsed, extra, expectedExtra] of [[45, '2', null], [45, 2, 2], [0, 0, 0]]) {
+    const status = { short: '1H', elapsed, extra };
+    const evidence = prepareEvidence({ fixture: { status } }, 1000);
+    assert.deepEqual(evidence.status, { short: '1H', elapsed, extra: expectedExtra });
+  }
+});
+
+for (const [short, question] of [['NS', "When is Barcelona's next match?"], ['TBD', 'متى مباراة برشلونة القادمة؟']]) {
+  test('a scheduled fixture has no running clock in club summaries or refreshed details: ' + short, async () => {
+    const status = { short, long: 'Synthetic scheduled fixture', elapsed: 45, extra: 2 };
+    const fixture = { fixture: { id: 72, status },
+      teams: { home: { id: 529, name: 'Barcelona' }, away: { id: 541, name: 'Real Madrid' } } };
+    const provider = { async load(path) {
+      return { data: ['/fixtures?team=529&next=1', '/fixtures?id=72'].includes(path) ? [fixture] : [], fetchedAt: 1000 };
+    } };
+    const result = await collectEvidence(provider, question);
+    const expected = { ...status, elapsed: null, extra: null };
+    assert.equal(result.followUpContext.fixtureId, 72);
+    assert.deepEqual(result.clubs[0].matches[0].status, expected);
+    assert.deepEqual(result.status, expected);
+    assert.equal(fixture.fixture.status.elapsed, 45);
+  });
+}
