+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { createApp } = require('../app');
+
+async function fixture(t, initial) {
+  let seasons = initial;
+  const calls = [];
+  const server = createApp({ provider: { get: async path => {
+    calls.push(path);
+    if (path.startsWith('/players/seasons?')) return { data: seasons };
+    const year = Number(new URL(path, 'https://synthetic.invalid').searchParams.get('season'));
+    return { data: [{ player: { id: 7001, name: 'Synthetic player' }, statistics: [
+      { team: { id: 9001 }, league: { id: 901, season: year }, goals: { total: 0 } }
+    ] }], stale: false };
+  } } }).listen(0, '127.0.0.1');
+  await new Promise(resolve => server.once('listening', resolve));
+  t.after(() => new Promise(resolve => server.close(resolve)));
+  return { calls, set: value => { seasons = value; }, request: async (query = '') => {
+    const response = await fetch(`http://127.0.0.1:${server.address().port}/api/player/7001${query}`);
+    return { status: response.status, body: await response.json() };
+  } };
+}
+
+test('automatic player season rejects malformed collections without loading player statistics', async t => {
+  const f = await fixture(t, null);
+  for (const value of [null, undefined, {}, { season: 2025 }, false, 2025, '2025']) {
+    f.set(value); f.calls.length = 0;
+    assert.deepEqual(await f.request(), { status: 502, body: { error: 'UPSTREAM_INVALID_RESPONSE' } });
+    assert.deepEqual(f.calls, ['/players/seasons?player=7001']);
+  }
+});
+
+test('malformed player season discovery recovers on a subsequent valid response', async t => {
+  const f = await fixture(t, null);
+  assert.equal((await f.request()).status, 502);
+  const seasons = [2024, 2025, 2025], before = structuredClone(seasons);
+  f.set(seasons);
+  const r = await f.request();
+  assert.equal(r.status, 200); assert.equal(r.body.stats[0].league.season, 2025);
+  assert.equal(r.body.stats[0].goals, 0); assert.deepEqual(seasons, before);
+  assert.deepEqual(f.calls, ['/players/seasons?player=7001', '/players/seasons?player=7001', '/players?id=7001&season=2025']);
+});
+
+test('empty season lists stay unavailable and explicit seasons bypass discovery', async t => {
+  const f = await fixture(t, []);
+  assert.deepEqual(await f.request(), { status: 404, body: { error: 'PLAYER_SEASON_UNAVAILABLE' } });
+  f.set(null); f.calls.length = 0;
+  const r = await f.request('?season=2025');
+  assert.equal(r.status, 200); assert.equal(r.body.stats[0].league.season, 2025);
+  assert.deepEqual(f.calls, ['/players?id=7001&season=2025']);
+});
