diff --git a/server/test/completed-fixture-order.test.js b/server/test/completed-fixture-order.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..7efb1045be37fd8db377cc285cf5384cdc478134
--- /dev/null
+++ b/server/test/completed-fixture-order.test.js
@@ -0,0 +1,69 @@
+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { collectEvidence } = require('../chat-evidence');
+
+function fixture(id, date, goals) {
+  return {
+    fixture: { id, date, status: { short: 'FT' } },
+    teams: { home: { id: 529, name: 'Barcelona' }, away: { id: id + 1000, name: 'Synthetic opponent' } },
+    goals: { home: goals, away: 0 }
+  };
+}
+async function collect(rows, question) {
+  const calls = [];
+  const provider = { async load(path) {
+    calls.push(path);
+    if (path === '/fixtures?team=529&last=5') return { data: rows, fetchedAt: 1 };
+    const id = Number(new URL(path, 'https://synthetic.invalid').searchParams.get('id'));
+    return { data: rows.filter(row => row.fixture.id === id), fetchedAt: 2 };
+  } };
+  return { evidence: await collectEvidence(provider, question), calls };
+}
+for (const question of ['Analyze Barcelona last completed match', 'حلل آخر مباراة منتهية لبرشلونة']) {
+  test('uses the latest completed kickoff regardless of provider order: ' + question, async () => {
+    const older = fixture(82, '2025-05-15T22:00:00+03:00', 4);
+    const latest = fixture(70, '2025-05-15T20:00:00Z', 0);
+    for (const rows of [[older, latest], [latest, older]]) {
+      const { evidence, calls } = await collect(rows, question);
+      assert.deepEqual(calls, ['/fixtures?team=529&last=5', '/fixtures?id=70']);
+      assert.equal(evidence.fixtureId, 70);
+      assert.equal(evidence.currentScore.home, 0);
+      assert.equal(evidence.followUpContext.fixtureId, 70);
+    }
+  });
+}
+test('ambiguous latest kickoff does not select a score or a follow-up fixture', async () => {
+  for (const date of [undefined, 'invalid', '2025-05-15T20:00:00', '2025-05-15T21:00:00+01:00']) {
+    const { evidence, calls } = await collect([
+      fixture(70, '2025-05-15T20:00:00Z', 0), fixture(82, date, 4)
+    ], 'Analyze Barcelona last completed match');
+    assert.deepEqual(calls, ['/fixtures?team=529&last=5']);
+    assert.equal(evidence.currentScore, undefined);
+    assert.equal(evidence.followUpContext.fixtureId, undefined);
+    assert.ok(evidence.missing.some(message => /kickoff/i.test(message)));
+    assert.equal(evidence.clubs[0].matches.length, 2);
+    assert.equal(evidence.clubs[0].recentResultsNewestFirst, undefined);
+  }
+});
+
+for (const question of ['Analyze Barcelona last completed match', 'حلل آخر مباراة منتهية لبرشلونة']) {
+  test('an impossible calendar day cannot select the latest score: ' + question, async () => {
+    const { evidence, calls } = await collect([
+      fixture(70, '2025-03-01T20:00:00Z', 0), fixture(82, '2025-02-30T23:00:00+04:00', 4)
+    ], question);
+    assert.deepEqual(calls, ['/fixtures?team=529&last=5']);
+    assert.equal(evidence.followUpContext.fixtureId, undefined);
+    assert.equal(evidence.clubs[0].matches.find(row => row.id === 82).kickoffUTC, null);
+  });
+}
+test('explicit fixture retains its score without inventing a kickoff date', async () => {
+  for (const [date, expected] of [[false, null], ['2025-02-29T10:00:00Z', null],
+    ['2024-02-29T00:15:00+04:00', '2024-02-28T20:15:00.000Z']]) {
+    const { evidence } = await collect([fixture(70, date, 0)], 'Analyze Barcelona last completed match');
+    assert.equal(evidence.fixtureId, 70);
+    assert.equal(evidence.currentScore.home, 0);
+    assert.equal(evidence.kickoffUTC, expected);
+    assert.equal(evidence.clubs[0].matches[0].kickoffUTC, expected);
+  }
+});
