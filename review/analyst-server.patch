+'use strict';
+const { normalizeArticles } = require('./news-discovery');
+function announcementAnswer(question, evidence) {
+  if (evidence.schema !== 'fotiq-announcement-discovery-v1') return null;
+  const ar = /[\u0600-\u06ff]/u.test(question);
+  const lines = [ar ? 'لا أملك تأكيداً متحققاً للخبر أو الإصابة أو الانتقال المطلوب.' : 'I do not have verified confirmation of the requested news, injury or transfer.'];
+  // Validate links again at the output boundary; never print supplied headlines.
+  const links = normalizeArticles({articles:evidence.links || []}, evidence.fetchedAt);
+  if (links.length) {
+    lines.push(ar ? 'هذه روابط اكتشاف عامة للموضوع عبر GDELT، وليست حقائق مؤكدة أو نتائج خاصة بالنادي المذكور. لم تُقرأ نصوص المقالات للتحقق منها:' : 'These are topic-wide links discovered through GDELT, not verified facts or team-specific results. Article text has not been read to verify them:');
+    for (const link of links.slice(0,5)) lines.push(`${link.publisher}: ${link.url}`);
+    lines.push('GDELT Project: https://www.gdeltproject.org/');
+  } else lines.push(ar ? 'لم تتوفر روابط اكتشاف في هذا الطلب. هذا لا يعني عدم وجود خبر أو إصابة.' : 'No discovery links were available for this request. This does not mean there is no news or injury.');
+  return lines.join('\n');
+}
+module.exports = { announcementAnswer };
