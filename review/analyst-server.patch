+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { HistoricalKnowledge } = require('../knowledge');
+const { collectEvidence } = require('../chat-evidence');
+
+for (const question of ["Show Liverpool Women's latest result", 'حلل آخر مباراة لسيدات ريال مدريد',
+  'Compare Barcelona Femení and Manchester City Women this season']) {
+  test(question, async () => {
+    const calls = [];
+    const evidence = await collectEvidence({ async load(path) {
+      calls.push(path);
+      return { data: [], fetchedAt: 1 };
+    } }, question, { teamIds: [529], fixtureId: 100 });
+    assert.deepEqual(calls, []);
+    assert.deepEqual(evidence.followUpContext, {});
+    assert.equal(evidence.sources.length, 0);
+    assert.ok(evidence.missing.length);
+  });
+}
+
+test('women’s foundation questions cannot reuse the parent club’s cached founding date', async () => {
+  let fetches = 0;
+  const knowledge = new HistoricalKnowledge({ now: () => 1, fetchImpl: async () => {
+    fetches++;
+    return Response.json({entities: {Q7156: { id: 'Q7156', labels: {en: {value:'FC Barcelona'}},
+      claims: {P571: [{rank:'normal', mainsnak: {snaktype:'value', datavalue:{value:{
+        time:'+1900-01-02T00:00:00Z', precision:11, calendarmodel:'http://www.wikidata.org/entity/Q1985727'
+      }}}}]}}}});
+  }});
+  assert.equal((await knowledge.collect('When was FC Barcelona founded?')).facts[0].value, '1900-01-02');
+  for (const q of ['When was Barcelona Femení founded?', 'متى تأسس فريق برشلونة للسيدات؟']) {
+    const history = await knowledge.collect(q, {teamIds:[529]});
+    assert.deepEqual(history.facts, []);
+    assert.deepEqual(history.sources, []);
+    assert.deepEqual(history.followUpContext, {});
+  }
+  assert.equal(fetches, 1);
+});
diff --git a/server/season-matchday.js b/server/season-matchday.js
new file mode 100644
index 0000000000000000000000000000000000000000..88c7893970c78ef55b47e66c102969a16c6c83c3
--- /dev/null
+++ b/server/season-matchday.js
@@ -0,0 +1,48 @@
+'use strict';
+const { fixtureHasTeam } = require('./fixture-player-scope');
+const { verifiedTeamSeason } = require('./season-scope');
+
+const fields = ['played','wins','draws','losses','goalsFor','goalsAgainst','cleanSheets','failedToScore'];
+
+const completeAggregate = totals => totals && fields.every(k => Number.isSafeInteger(totals[k]) && totals[k] >= 0);
+
+// Reconcile only a one-match lag. The earlier completed fixtures must exactly
+// reproduce the provider's aggregate before the latest final score is included.
+function reconcileFinishedSeason(club, page, now) {
+  const season = club.season, prior = season.totals;
+  if (!prior || page.stale || page.paging?.current !== 1 || page.paging?.total !== 1 ||
+      !Array.isArray(page.data)) return 'unconfirmed';
+  if (!completeAggregate(prior) || ![prior.played, prior.played + 1].includes(page.data.length)) return 'unconfirmed';
+  const scope = { id: season.leagueId, season: season.year };
+  const ids = new Set(), rounds = new Set(), times = new Set(), matches = [];
+  for (const f of page.data) {
+    if (!fixtureHasTeam(f, club.teamId) || f.fixture.status?.short !== 'FT') return 'unconfirmed';
+    const home = f.teams.home.id === club.teamId;
+    if (!verifiedTeamSeason({team: home ? f.teams.home : f.teams.away, league:f.league}, club.teamId, scope)) return 'unconfirmed';
+    const ts = Date.parse(f.fixture.date), round = f.league.round;
+    const scored = home ? f.goals?.home : f.goals?.away, conceded = home ? f.goals?.away : f.goals?.home;
+    if (ids.has(f.fixture.id) || !/^Regular Season - (?:[1-9]|[12][0-9]|3[0-8])$/.test(round) ||
+        rounds.has(round) || times.has(ts) || !Number.isFinite(ts) || ts >= now ||
+        ![scored,conceded].every(n => Number.isSafeInteger(n) && n >= 0)) return 'unconfirmed';
+    ids.add(f.fixture.id); rounds.add(round); times.add(ts);
+    matches.push({ts,scored,conceded});
+  }
+  matches.sort((a,b) => a.ts-b.ts);
+  const totals = Object.fromEntries(fields.map(key => [key,0]));
+  for (const {scored,conceded} of matches) {
+    if (totals.played === prior.played && !fields.every(k => totals[k] === prior[k])) return 'unconfirmed';
+    totals.played++;
+    if (scored > conceded) totals.wins++;
+    else if (scored === conceded) totals.draws++;
+    else totals.losses++;
+    totals.goalsFor += scored;
+    totals.goalsAgainst += conceded;
+    if (scored === 0) totals.failedToScore++;
+    if (conceded === 0) totals.cleanSheets++;
+    if (!Number.isSafeInteger(totals.goalsFor) || !Number.isSafeInteger(totals.goalsAgainst)) return 'unconfirmed';
+  }
+  if (totals.played === prior.played) return fields.every(k => totals[k] === prior[k]) ? 'snapshot' : 'unconfirmed';
+  season.totals = totals;
+  return 'updated';
+}
+module.exports = { completeAggregate, reconcileFinishedSeason };
diff --git a/server/test/season-matchday.test.js b/server/test/season-matchday.test.js
