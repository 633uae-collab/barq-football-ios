+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { verifiedTeamSeason } = require('../season-scope');
+const { seasonAnswer } = require('../season-answer');
+
+function clubRow(teamId, leagueId, year) {
+  const team = { id: teamId, name: 'Synthetic Athletic' };
+  return { teamId, team, season: { verified: true, team, leagueId, year,
+    league: 'Synthetic League', totals: { played: 2, wins: 0 } } };
+}
+
+for (const field of ['team', 'league', 'season']) {
+  test('season evidence rejects an invalid ' + field + ' even when both copies agree', () => {
+    for (const value of [undefined, null, 0, -1, 1.5, '2025', true, Number.MAX_SAFE_INTEGER + 1]) {
+      const id = field === 'team' ? value : 90001;
+      const league = { id: field === 'league' ? value : 90002, season: field === 'season' ? value : 2025 };
+      assert.equal(verifiedTeamSeason({ team: { id, name: 'Synthetic Athletic' }, league }, id, league), false);
+    }
+  });
+}
+for (const question of ['Compare clubs', 'قارن الناديين']) {
+  test('season answer withholds unbound totals and preserves the valid club for ' + question, () => {
+    for (const invalid of [clubRow(undefined, 90002, 2025), clubRow(90001, -1, 2025), clubRow(90001, 90002, 0)]) {
+      invalid.season.totals.played = 99;
+      const answer = seasonAnswer(question, { seasonOnlyComparison: true, clubs: [invalid, clubRow(90003, 90002, 2025)] });
+      assert.doesNotMatch(answer, /99/);
+      assert.match(answer, /withheld|حُجبت/);
+      assert.match(answer, /Played: 2|لعب: 2/);
+      assert.match(answer, /Wins: 0|فوز: 0/);
+    }
+  });
+}
diff --git a/server/test/season-multihop-followup.test.js b/server/test/season-multihop-followup.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..f36afeeb37731570d1ba2811b18c404c1c553f26
--- /dev/null
+++ b/server/test/season-multihop-followup.test.js
@@ -0,0 +1,83 @@
+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const {collectEvidence}=require('../chat-evidence');
+const pairs=qs=>qs.flatMap(content=>[{role:'user',content},{role:'assistant',content:'Synthetic reply; no football facts.'}]);
+async function collect(question,history,context={teamIds:[529,541]}) {
+ const before=structuredClone({history,context}),calls=[];
+ const e=await collectEvidence({load:async path=>{
+  calls.push(path); const p=new URLSearchParams(path.split('?')[1]),team=Number(p.get('team')),year=Number(p.get('season')||2026);
+  if(path.startsWith('/fixtures?'))return {fetchedAt:1,data:[]};
+  if(path.startsWith('/leagues?'))return {fetchedAt:1,data:[{league:{id:140,name:'La Liga',type:'League'},seasons:[{year,current:true}]}]};
+  assert.ok(path.startsWith('/teams/statistics?'));
+  return {fetchedAt:1,data:{team:{id:team,name:team===529?'Barcelona':'Real Madrid'},league:{id:140,name:'La Liga',season:year},
+   fixtures:{played:{total:1},wins:{total:team===529?1:0},draws:{total:0},loses:{total:team===529?0:1}}}};
+ }},question,context,history);
+ assert.deepEqual({history,context},before);
+ return {e,calls};
+}
+for(const qs of [
+ ['Compare Barcelona and Real Madrid in La Liga season 2025/26','Who won more?','And who scored more?','Who conceded fewer?'],
+ ['قارن برشلونة وريال مدريد في الليغا موسم ٢٠٢٥/٢٦','من فاز أكثر؟','ومن سجل أكثر؟','ومن استقبل أقل؟']
+])test('retains explicit season across consecutive comparative follow-ups: '+qs[0],async()=>{
+ for(let i=1;i<qs.length;i++){
+  const {e,calls}=await collect(qs[i],pairs(qs.slice(0,i)));
+  assert.deepEqual(e.requestedSeasonScope,{year:2025,leagueId:140,ambiguous:false});
+  assert.deepEqual(e.clubs.map(c=>[c.team.id,c.season.year,c.season.totals.wins]),[[529,2025,1],[541,2025,0]]);
+  assert.equal(calls.length,4);assert.ok(calls.every(p=>p.includes('season=2025')));
+ }
+});
+const anchor='Compare Barcelona and Real Madrid in La Liga season 2025/26';
+test('unknown intervening topic stops season inheritance',async()=>{
+ for(const topic of ['Analyze Haaland','What about injuries?','Who won the World Cup?','Tell me something else']){
+  const {calls}=await collect('And who scored more?',pairs([anchor,topic,'Who won more?']));
+  assert.ok(calls.every(p=>!p.includes('season=2025')));
+ }
+});
+test('different club scope, match context and assistant claims cannot supply anchor',async()=>{
+ for(const [history,context] of [
+  [pairs(['Compare Liverpool and Manchester City in La Liga season 2025/26','Who won more?']),{teamIds:[529,541]}],
+  [[{role:'assistant',content:anchor},...pairs(['Who won more?'])],{teamIds:[529,541]}],
+  [pairs([anchor,'Who won more?']),{teamIds:[529,541],fixtureId:77}]
+ ]){
+  const {calls}=await collect('And who scored more?',history,context);
+  assert.ok(calls.every(p=>!p.includes('season=2025')));
+ }
+});
+test('latest explicit season wins without resurrecting an older comparison',async()=>{
+ const {e}=await collect('And who scored more?',pairs([anchor,anchor.replace('2025/26','2024/25'),'Who won more?']));
+ assert.equal(e.requestedSeasonScope.year,2024);
+});
+test('anchor outside eight-message request window is not recovered',async()=>{
+ const {calls}=await collect('And who scored more?',pairs([anchor,...Array(4).fill('Who won more?')]));
+ assert.ok(calls.every(p=>!p.includes('season=2025')));
+});
+
+for (const [first, switchYear, more] of [
+  [anchor, 'What about season 2024/25?', 'And who scored more?'],
+  ['قارن برشلونة وريال مدريد في الليغا موسم ٢٠٢٥/٢٦', 'وماذا عن موسم ٢٠٢٤/٢٥؟', 'ومن سجل أكثر؟']
+]) {
+  test('a season change retains the same clubs and competition: ' + switchYear, async () => {
+    for (const [question, prior] of [[switchYear, [first]], [more, [first, switchYear]]]) {
+      const {e, calls} = await collect(question, pairs(prior));
+      assert.deepEqual(e.requestedSeasonScope, {year: 2024, leagueId: 140, ambiguous: false});
+      assert.deepEqual(e.clubs.map(club => [club.team.id, club.season.year, club.season.totals.wins]),
+        [[529, 2024, 1], [541, 2024, 0]]);
+      const answer = require('../season-answer').seasonAnswer(question, e);
+      assert.match(answer, /Barcelona — La Liga — 2024/);
+      assert.match(answer, /Real Madrid — La Liga — 2024/);
+      assert.doesNotMatch(answer, /2025/);
+      assert.equal(calls.length, 4);
+      assert.ok(calls.every(path => path.includes('season=2024')));
+    }
+  });
+}
+test('the nearest season change wins and an invalid season change breaks the chain', async () => {
+  const history = pairs([anchor, 'What about season 2024/25?', 'Who won more?', 'What about season 2023/24?']);
+  const {e} = await collect('Who scored more?', history);
+  assert.deepEqual(e.requestedSeasonScope, {year: 2023, leagueId: 140, ambiguous: false});
+  for (const question of ['What about season 2024/29?', 'What about season 2024/25 and 2023/24?']) {
+    const {e, calls} = await collect(question, pairs([anchor]));
+    assert.equal(e.requestedSeasonScope.ambiguous, true);
+    assert.deepEqual(calls, []);
+  }
+});
