+'use strict';
+const validId = n => Number.isSafeInteger(n) && n > 0;
+const record = value => value !== null && typeof value === 'object' && !Array.isArray(value);
+const normalizedName = value => typeof value === 'string'
+  ? value.normalize('NFKC').trim().toLowerCase().replace(/\s+/g, ' ') : '';
+function fixtureHasTeam(f, team) {
+  if (!record(f)) return false;
+  const home = f.teams?.home?.id, away = f.teams?.away?.id;
+  return validId(f.fixture?.id) && validId(team) && validId(home) && validId(away)
+    && home !== away && (home === team || away === team);
+}
+// Match-player endpoints carry team identity on the outer group; nested rows
+// usually omit team/league fields. Bind them to that group and the requested
+// fixture, rejecting any supplied conflicting identity instead of relabelling it.
+function verifiedFixturePlayerGroups(groups, f, requestedTeam) {
+  if (!Array.isArray(groups) || !record(f) || !validId(f.league?.id) || !Number.isSafeInteger(f.league?.season)) return [];
