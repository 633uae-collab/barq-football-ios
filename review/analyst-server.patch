@@ -0,0 +1,33 @@
+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { collectEvidence } = require('../chat-evidence');
+const fixture = (score = 0) => ({ fixture: { id: 7, status: { short: 'FT' } },
+  teams: { home: { id: 529, name: 'Barcelona' }, away: { id: 541, name: 'Real Madrid' } },
+  league: { id: 140, season: 2025 }, goals: { home: score, away: 0 } });
+async function collect(data, question = 'For the same completed match, state the score') {
+  const calls = [], before = structuredClone(data);
+  const e = await collectEvidence({ load: async path => { calls.push(path); return { data, fetchedAt: 1000 }; } },
+    question, { fixtureId: 7 }, [{ role: 'user', content: 'Analyze this completed match' }]);
+  assert.deepEqual(calls, ['/fixtures?id=7']); assert.deepEqual(data, before); return e;
+}
+for (const question of ['For the same completed match, state the score', 'للمباراة المنتهية نفسها، اذكر النتيجة']) {
+  for (const duplicate of ['conflicting', 'identical']) test(`fixture detail withholds ${duplicate} repeated identity: ${question}`, async () => {
+    const a = fixture(), b = fixture(duplicate === 'conflicting' ? 3 : 0);
+    for (const data of [[a,b], [b,a]]) {
+      const e = await collect(data, question);
+      assert.equal(e.fixtureId, undefined); assert.equal(e.currentScore, undefined);
+      assert.ok(e.missing.some(m => /duplicate.*fixture/i.test(m)));
+    }
+  });
+}
+test('unique detail preserves zero and ignores unrelated or null rows', async () => {
+  const other = fixture(9); other.fixture.id = 8;
+  const e = await collect([null, other, fixture()]);
+  assert.equal(e.fixtureId, 7); assert.deepEqual(e.currentScore, { home: 0, away: 0 });
+});
+test('malformed detail collections are withheld and a malformed duplicate cannot select a winner', async () => {
+  for (const data of [null, false, {}, 'invalid', [fixture(), { fixture: { id: 7 } }]]) {
+    const e = await collect(data); assert.equal(e.fixtureId, undefined); assert.equal(e.currentScore, undefined); assert.ok(e.missing.length);
+  }
+});
