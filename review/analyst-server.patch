+const group = () => ({team:{id:50,name:'Manchester City'},players:[{player:{id:1100,name:'Haaland'},statistics:[{games:{minutes:90},goals:{total:0,assists:0}}]}]});
+test('match-player identity binds outer team to fixture, league and season and retains zero',()=>{
+ const result=verifiedFixturePlayerGroups([group()],fixture,50)[0].players[0].statistics[0];
+ assert.equal(result.team.id,50);assert.equal(result.league.id,39);assert.equal(result.league.season,2026);assert.equal(result.fixture.id,7);
+ assert.equal(result.goals.total,0);assert.equal(result.goals.assists,0);
+ for(const key of ['team','league','season','fixture','player','group']) {
+  const g=group();
+  if(key==='team')g.players[0].statistics[0].team={id:40};
+  if(key==='league')g.players[0].statistics[0].league={id:140};
+  if(key==='season')g.players[0].statistics[0].league={season:2025};
+  if(key==='fixture')g.fixture={id:99};
+  if(key==='player')g.players[0].player.id=null;
+  if(key==='group')g.team.id=529;
+  assert.deepEqual(verifiedFixturePlayerGroups([g],fixture,50),[],key);
