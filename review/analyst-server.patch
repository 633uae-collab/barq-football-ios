+ assert.equal(fixtureHasTeam(fixture,529),false);
+ assert.deepEqual(verifiedFixturePlayerGroups([group()],{...fixture,league:{}},50),[]);
+});
+for(const question of ['Analyze Haaland over the last five matches','حلل هالاند في آخر خمس مباريات']) {
+ test('last-five collection rejects a player under the opponent team: '+question,async()=>{
