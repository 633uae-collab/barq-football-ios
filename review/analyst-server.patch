+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const {collectEvidence}=require('../chat-evidence');
+const fields=['total','blocks','interceptions'];
+const keys=['tackles','blocks','interceptions'];
+const questions=['Analyze Haaland Premier League season 2025/26','حلل هالاند الدوري الإنجليزي موسم ٢٠٢٥/٢٦','Premier League top scorers season 2025/26','هدافو الدوري الإنجليزي موسم ٢٠٢٥/٢٦'];
+async function evidence(question,tackles) {
+ const row={player:{id:1100,name:'Haaland'},statistics:[{team:{id:50,name:'Synthetic Club'},league:{id:39,name:'Premier League',season:2025},tackles,goals:{total:0}}]};
+ const before=structuredClone(row);
+ const data={'/players/profiles':[{player:row.player}],'/players/teams':[{team:{id:50},seasons:[2025]}],'/players':[row],'/leagues':[{league:{id:39},seasons:[{year:2025}]}],'/players/topscorers':[row]};
+ const result=await collectEvidence({load:async path=>({fetchedAt:1,data:data[path.split('?')[0]]||[]})},question);
+ assert.deepEqual(row,before,'provider input must remain unchanged');
+ const s=result.playerProfiles?.[0]?.statistics[0]?.statistics[0]||result.scoringLeaders[0].statistics[0];
+ assert.equal(s.teamId,50);assert.equal(s.leagueId,39);assert.equal(s.season,2025);assert.equal(s.scoring.goals,0);
+ return s;
+}
+for(const q of questions)test('withholds invalid defending counts: '+q,async()=>{
+ for(const bad of [-1,0.5,'12',true,Number.MAX_SAFE_INTEGER+1,{},[],NaN,Infinity]) {
+  for(let i=0;i<fields.length;i++) {
+   const input={total:0,blocks:2,interceptions:3,[fields[i]]:bad};
+   const s=await evidence(q,input);
+   assert.equal(s.defending[keys[i]],null,'invalid '+fields[i]+' must not reach the model');
+   assert.ok(s.warnings?.includes('Invalid player defending counts withheld; null is unknown, not zero.'));
+   for(let j=0;j<fields.length;j++)if(i!==j)assert.equal(s.defending[keys[j]],input[fields[j]]);
+  }
+ }
+});
+test('defending counts preserve zero, unknown and safe integers without inferred limits',async()=>{
+ for(const q of questions)for(const input of [undefined,null,{}, {total:0,blocks:null,interceptions:Number.MAX_SAFE_INTEGER}]) {
+  const s=await evidence(q,input);
+  assert.deepEqual(s.defending,{tackles:input?.total??null,blocks:input?.blocks??null,interceptions:input?.interceptions??null});
+  assert.ok(!s.warnings?.length);
+ }
+});
