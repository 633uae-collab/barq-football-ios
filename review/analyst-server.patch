+async function evidence(question,games) {
+ const row={player:{id:1100,name:'Haaland'},statistics:[{team:{id:50,name:'Synthetic Club'},league:{id:39,name:'Premier League',season:2025},games,goals:{total:0}}]};
+ const before=structuredClone(row);
+ const data={'/players/profiles':[{player:row.player}],'/players/teams':[{team:{id:50},seasons:[2025]}],'/players':[row],'/leagues':[{league:{id:39},seasons:[{year:2025}]}],'/players/topscorers':[row]};
+ const result=await collectEvidence({load:async path=>({fetchedAt:1,data:data[path.split('?')[0]]||[]})},question);
+ assert.deepEqual(row,before,'provider input must remain unchanged');
+ const s=result.playerProfiles?.[0]?.statistics[0]?.statistics[0]||result.scoringLeaders[0].statistics[0];
+ assert.equal(s.teamId,50);assert.equal(s.leagueId,39);assert.equal(s.season,2025);assert.equal(s.scoring.goals,0);
+ return s;
+}
+for(const q of questions)test('withholds invalid participation counts: '+q,async()=>{
+ for(const bad of [-1,0.5,'12',true,Number.MAX_SAFE_INTEGER+1,{},[],NaN,Infinity]) {
+  for(let i=0;i<fields.length;i++) {
+   const input={appearences:10,lineups:2,minutes:3,position:'Attacker',rating:'7.1',captain:false,number:0,[fields[i]]:bad};
+   const s=await evidence(q,input);
+   assert.equal(s.games[keys[i]],null,'invalid '+fields[i]+' must not reach the model');
+   assert.ok(s.warnings?.includes('Invalid player participation counts withheld; null is unknown, not zero.'));
+   assert.equal(s.games.position,'Attacker');assert.equal(s.games.rating,'7.1');assert.equal(s.games.captain,false);assert.equal(s.games.number,0);
+   for(let j=0;j<fields.length;j++)if(i!==j)assert.equal(s.games[keys[j]],input[fields[j]]);
+  }
+ }
+});
+test('participation counts preserve zero, unknown and safe integers without inferred limits',async()=>{
+ for(const q of questions)for(const input of [undefined,null,{}, {appearences:0,lineups:0,minutes:0}, {appearences:10,lineups:2,minutes:3}, {appearences:Number.MAX_SAFE_INTEGER,lineups:null,minutes:Number.MAX_SAFE_INTEGER}]) {
+  const s=await evidence(q,input);
+  assert.deepEqual(s.games,{appearences:input?.appearences??null,lineups:input?.lineups??null,minutes:input?.minutes??null});
+  assert.ok(!s.warnings?.length);
