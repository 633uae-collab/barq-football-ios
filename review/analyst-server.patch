+    && fixtureHasTeam(f, group.team?.id)
+    && (group.fixture?.id == null || group.fixture.id === f.fixture.id));
+  // Count before requested-team filtering: one player cannot own conflicting
+  // match rows on either side. Withhold duplicates instead of picking the first.
+  const occurrences = new Map();
+  for (const group of candidates) for (const row of group.players || []) {
+    if (record(row) && validId(row.player?.id)) occurrences.set(row.player.id, (occurrences.get(row.player.id) || 0) + 1);
+  }
+  return candidates.flatMap(group => {
+    const team = group.team?.id;
+    const participant = [f.teams.home, f.teams.away].find(t => t.id === team);
+    const expectedName = normalizedName(participant?.name);
+    // Optional names must not contradict the fixture's participant identity.
+    // Keep duplicate counting above this check: a conflicting row is no tie-breaker.
+    const nameMatches = identity => identity?.name == null || !expectedName
+      || normalizedName(identity.name) === expectedName;
+    if (!fixtureHasTeam(f, team) || (requestedTeam != null && team !== requestedTeam)
+      || !nameMatches(group.team)
+      || (group.fixture?.id != null && group.fixture.id !== f.fixture.id)) return [];
+    const players = (group.players || []).flatMap(row => {
+      if (!record(row) || !validId(row.player?.id) || typeof row.player.name !== 'string' || !row.player.name.trim()) return [];
+      if (occurrences.get(row.player.id) !== 1 || !Array.isArray(row.statistics) || row.statistics.length !== 1) return [];
+      const statistics = (row.statistics || []).filter(s => record(s) &&
+        (s.team?.id == null || s.team.id === team)
+        && nameMatches(s.team)
+        && (s.league?.id == null || s.league.id === f.league.id)
+        && (s.league?.season == null || s.league.season === f.league.season)
+        && (s.fixture?.id == null || s.fixture.id === f.fixture.id))
+        .map(s => ({ ...s,
+          // Invalid or absent minutes are unknown, never evidence of an appearance.
+          games: { ...s.games, minutes: Number.isSafeInteger(s.games?.minutes) && s.games.minutes >= 0 ? s.games.minutes : null },
+          team: group.team, league: f.league, fixture: {id:f.fixture.id} }));
+      return statistics.length ? [{ ...row, statistics }] : [];
+    });
+    return players.length ? [{ team: group.team, players }] : [];
+  });
+}
