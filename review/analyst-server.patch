@@ -0,0 +1,44 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { createApp } = require('../app');
+
+const row = () => ({ player: { id: 7001, name: 'Synthetic player' }, statistics: [{ league: { id: 140, season: 2025 }, team: { id: 9001 }, goals: { total: 0, assists: 0 }, games: { appearences: 0 } }] });
+async function request(t, kind, data) {
+  const before = structuredClone(data);
+  const server = createApp({ provider: { get: async () => ({ data, stale: false }) } }).listen(0, '127.0.0.1');
+  await new Promise(resolve => server.once('listening', resolve));
+  t.after(() => new Promise(resolve => server.close(resolve)));
+  const res = await fetch(`http://127.0.0.1:${server.address().port}/api/${kind}/140?season=2025`);
+  const body = await res.json();
+  assert.deepEqual(data, before);
+  return { status: res.status, body };
+}
+const fields = [['goals', 'total', 'goals'], ['goals', 'assists', 'assists'], ['games', 'appearences', 'apps']];
+for (const kind of ['topscorers', 'topassists']) {
+  for (const [group, key, output] of fields) {
+    test(`${kind} rejects invalid ${output} without numeric coercion`, async t => {
+      for (const value of [-1, 1.5, '12', true, {}, [], Number.MAX_SAFE_INTEGER + 1, NaN, Infinity]) {
+        const item = row(); item.statistics[0][group][key] = value;
+        const r = await request(t, kind, [item]);
+        assert.equal(r.status, 502);
+        assert.deepEqual(r.body, { error: 'UPSTREAM_INVALID_RESPONSE' });
+      }
+    });
+  }
+  test(`${kind} preserves zero, safe counts and unknown count semantics`, async t => {
+    for (const value of [0, 12, Number.MAX_SAFE_INTEGER, null, undefined]) {
+      const item = row();
+      for (const [group, key] of fields) item.statistics[0][group][key] = value;
+      const r = await request(t, kind, [item]);
+      assert.equal(r.status, 200);
+      for (const [, , output] of fields) {
+        assert.equal(r.body.players[0][output], value);
+        assert.equal(Object.hasOwn(r.body.players[0], output), value !== undefined);
+      }
+    }
+    const item = row(); delete item.statistics[0].goals; delete item.statistics[0].games;
+    const r = await request(t, kind, [item]);
+    assert.equal(r.status, 200);
+    for (const [, , output] of fields) assert.equal(Object.hasOwn(r.body.players[0], output), false);
+  });
+}
