@@ -0,0 +1,37 @@
+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const {prepareEvidence}=require('../analyst-evidence');
+const home={id:529,name:'Barcelona'}, away={id:541,name:'Real Madrid'};
+const starter={id:11,name:'Starter'}, sub={id:22,name:'Substitute'};
+const fixture=()=>({fixture:{id:7,status:{short:'2H'}},teams:{home,away},
+  lineups:[{team:home,startXI:[{player:{...starter}}],substitutes:[{player:{...sub}}]}],
+  events:[{team:home,type:'subst',time:{elapsed:60},player:{...starter},assist:{...sub}}]});
+function withheld(f) {
+  const e=prepareEvidence(f,1000);
+  assert.equal(e.events[0].playerIn,null);
+  assert.equal(e.events[0].playerOut,null);
+  assert.deepEqual(e.events[0].participants,[],'Contradictory names must not reach the model as participants');
+  assert.ok(e.warnings.some(w=>/substitution/.test(w)));
+}
+test('substitution rejects matching player IDs carrying conflicting or missing names',()=>{
+  for(const name of ['Opponent player','',null]) {
+    for(const field of ['player','assist']) { const f=fixture(); f.events[0][field].name=name; withheld(f); }
+  }
+});
+test('substitution cannot infer direction from one player appearing both on field and bench',()=>{
+  const f=fixture(); f.lineups[0].substitutes.push({player:{...starter}}); withheld(f);
+});
+test('substitution rejects duplicate player ownership across the two fixture teams',()=>{
+  const f=fixture(); f.lineups.push({team:away,startXI:[{player:{...starter}}],substitutes:[]}); withheld(f);
+});
+test('substitution requires positive player IDs in the roster and event',()=>{
+  for(const id of [0,-1]) { const f=fixture(); f.lineups[0].startXI[0].player.id=id; f.events[0].player.id=id; withheld(f); }
+});
+test('substitution rejects duplicate lineup rows for a team rather than using the last row',()=>{
+  const f=fixture(); f.lineups.push(structuredClone(f.lineups[0])); withheld(f);
+});
+test('substitution accepts normalized player names and preserves chronological role updates',()=>{
+  const f=fixture(); f.events[0].player.name=' STARTER '; f.events[0].assist.name='Ｓｕｂｓｔｉｔｕｔｅ';
+  const e=prepareEvidence(f,1000);
+  assert.equal(e.events[0].playerOut,'Starter'); assert.equal(e.events[0].playerIn,'Substitute');
+});
diff --git a/server/test/team-squad-binding.test.js b/server/test/team-squad-binding.test.js
new file mode 100644
