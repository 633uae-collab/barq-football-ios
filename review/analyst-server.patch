diff --git a/server/test/event-clock-integrity.test.js b/server/test/event-clock-integrity.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..97010237a02b3720e4b6f0b8367b0c6f725cb89a
--- /dev/null
+++ b/server/test/event-clock-integrity.test.js
@@ -0,0 +1,54 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { prepareEvidence } = require('../analyst-evidence');
+
+const home = { id: 1, name: 'Home' }, away = { id: 2, name: 'Away' };
+function substitution(team, time) {
+  const player = { id: team.id * 10, name: team.name + ' starter' };
+  const assist = { id: player.id + 1, name: team.name + ' substitute' };
+  return { team, type: 'subst', player, assist, time };
+}
+function prepare(events) {
+  const lineups = [home, away].map(team => {
+    const { player, assist } = substitution(team);
+    return { team, startXI: [{ player }], substitutes: [{ player: assist }] };
+  });
+  return prepareEvidence({ teams: { home, away }, lineups, events }, 1000);
+}
+
+test('a substitution without a usable clock has participants but no verified direction', () => {
+  for (const time of [undefined, { elapsed: '60' }, { elapsed: 60, extra: -1 }]) {
+    const [sub] = prepare([substitution(home, time)]).events;
+    assert.equal(sub.playerOut, null);
+    assert.equal(sub.playerIn, null);
+    assert.deepEqual(sub.participants, ['Home starter', 'Home substitute']);
+  }
+});
+
+test('an undated dismissal makes its team substitution sequence uncertain in either input order', () => {
+  const homeSub = substitution(home, { elapsed: 62 });
+  const red = { team: home, type: 'Card', detail: 'Red Card', player: homeSub.assist };
+  for (const events of [[red, homeSub], [homeSub, red]]) {
+    const result = prepare([...events, substitution(away, { elapsed: 45, extra: 2 })]);
+    const subs = result.events.filter(event => event.type === 'subst');
+    assert.equal(subs.find(event => event.team === 'Home').playerIn, null);
+    assert.equal(subs.find(event => event.team === 'Away').playerIn, 'Away substitute');
+  }
+});
+
+test('invalid event clocks never reach evidence as minutes or sort ahead of known times', () => {
+  for (const time of [{ elapsed: false }, { elapsed: null, extra: 3 }, { elapsed: -2 },
+    { elapsed: 4.5 }, { elapsed: Number.MAX_SAFE_INTEGER + 1 }, { elapsed: 45, extra: '2' }]) {
+    const goal = { team: home, type: 'Goal', time };
+    const events = [goal, substitution(home, { elapsed: 0, extra: 0 })];
+    const snapshot = structuredClone(events);
+    const result = prepare(events);
+    assert.equal(result.events[0].playerIn, 'Home substitute');
+    assert.equal(result.events[0].minute, 0);
+    assert.equal(result.events[0].addedTime, 0);
+    assert.equal(result.events[1].minute, null);
+    assert.equal(result.events[1].addedTime, null);
+    assert.ok(result.warnings.some(message => /time/i.test(message)));
+    assert.deepEqual(events, snapshot);
+  }
+});
