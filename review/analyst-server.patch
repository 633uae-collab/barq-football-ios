+const {GroqAnalyst} = require('../groq');
+for (const question of ['Compare these clubs and explain their form', 'قارن الناديين واشرح مستواهما']) {
+  for (const identities of [[[529,'Barcelona'],[541,'Real Madrid']],[[90001,'Synthetic Club A'],[90002,'Synthetic Club B']]]) {
+    test('post-generation season boundary preserves identity and zero: '+question+identities[0][0], async()=>{
+      const clubs=identities.map(([id,name],i)=>({teamId:id,team:{id,name},season:{verified:true,team:{id,name},leagueId:901,league:'Synthetic League',year:2025,totals:{played:7,wins:i?2:5,draws:0,losses:i?5:2,goalsFor:i?9:23,goalsAgainst:i?17:4}}}));
+      // Deliberately wrong generated output; all values exist in evidence but
+      // belong to the opposite club. The final boundary must not forward it.
+      const generated=`${identities[0][1]} scored 9 and won 2; ${identities[1][1]} scored 23 and won 5. UNVERIFIED MODEL CLAIM`;
+      let calls=0;
+      const a=new GroqAnalyst({fetchImpl:async()=>{calls++;return {ok:true,headers:new Headers(),json:async()=>({choices:[{finish_reason:'stop',message:{content:generated}}]})};}});
+      for(const rows of [clubs,[...clubs].reverse()]) {
+        const r=await a.answer(question,{clubs:rows,requestedSeasonScope:{leagueId:901,year:2025}});
+        assert.equal(r.model,'verified-provider-data');assert.doesNotMatch(r.answer,/UNVERIFIED MODEL CLAIM/);
+        const block=r.answer.split(identities[0][1]+' — Synthetic League — 2025')[1].split('\n\n')[0];
+        assert.match(block,/(?:له|Goals for): 23/);assert.match(block,/(?:تعادل|Draws): 0/);
+      }
+      assert.equal(calls,2,'one generation per request, no correction retry');
+      const bad=structuredClone(clubs);bad[0].season.year=2026;
+      const r=await a.answer(question,{clubs:bad,requestedSeasonScope:{leagueId:901,year:2025}});
+      assert.doesNotMatch(r.answer,/(?:له|Goals for): 23/);assert.match(r.answer,/(?:حُجبت|withheld)/);
+    });
+  }
+}
