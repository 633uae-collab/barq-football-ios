@@ -0,0 +1,34 @@
+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const {seasonAnswer} = require('../season-answer');
+const club = totals => ({teamId:90001,team:{id:90001,name:'Synthetic Club'},season:{verified:true,team:{id:90001,name:'Synthetic Club'},leagueId:901,league:'Synthetic League',year:2025,totals}});
+const render = (q, totals) => seasonAnswer(q,{seasonOnlyComparison:true,clubs:[club(totals)]});
+for (const q of ['Compare synthetic season statistics','قارن إحصاءات موسم مصطنع']) {
+  test('withhold internally contradictory season counts: '+q,()=>{
+    for (const totals of [
+      {played:7,wins:5,draws:2,losses:1},
+      {played:7,wins:2,draws:0,losses:1},
+      {played:7,wins:8},
+      {played:7,wins:5,draws:3},
+      {played:7,cleanSheets:8},
+      {played:7,failedToScore:8}
+    ]) {
+      const answer=render(q,{...totals,goalsFor:12345});
+      assert.doesNotMatch(answer,/12345/,'contradictory row must not publish unrelated totals as verified');
+      assert.match(answer,/حُجبت|withheld/);
+    }
+  });
+  test('preserve zero, partial coverage and unbounded goal totals: '+q,()=>{
+    for(const totals of [
+      {played:0,wins:0,draws:0,losses:0,cleanSheets:0,failedToScore:0,goalsFor:0},
+      {played:7,wins:5,draws:0,losses:2,cleanSheets:7,failedToScore:0,goalsFor:23},
+      {played:7,wins:5,draws:null,losses:null,goalsFor:23},
+      {played:null,wins:5,draws:0,losses:2,goalsFor:23}
+    ]) {
+      const answer=render(q,totals);
+      assert.doesNotMatch(answer,/حُجبت|withheld/);
+      assert.match(answer,new RegExp('(?:له|Goals for): '+totals.goalsFor));
+      if(totals.played===null) assert.match(answer,/(?:لعب|Played): (?:غير متحقق|Unverified)/);
+    }
+  });
+}
