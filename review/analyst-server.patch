+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { createApp } = require('../app');
+
+async function harness(t, kind, data) {
+  const calls = [], original = structuredClone(data);
+  const provider = { get: async path => {
+    calls.push(path);
+    return { data: path.startsWith(kind === 'team' ? '/teams?' : '/players?') ? data : [], stale: false };
+  } };
+  const server = createApp({ provider }).listen(0, '127.0.0.1');
+  await new Promise(resolve => server.once('listening', resolve));
+  t.after(() => new Promise(resolve => server.close(resolve)));
+  return { calls, request: async () => {
+    const res = await fetch(`http://127.0.0.1:${server.address().port}/api/${kind}/7001?season=2025`);
+    const body = await res.json();
+    assert.deepEqual(data, original, 'Provider input must not change');
+    return { status: res.status, body };
+  } };
+}
+
+for (const kind of ['team', 'player']) {
+  const row = value => ({ [kind]: { id: value, name: 'Synthetic entity' }, ...(kind === 'player' ? { statistics: [] } : {}) });
+  test(`${kind} detail rejects wrong, repeated and malformed primary identity before attribution`, async t => {
+    for (const data of [[row(7002)], [row(7001), row(7001)], [row(7001), row(7002)], [row('7001')], [null], {}, null]) {
+      const h = await harness(t, kind, data), r = await h.request();
+      assert.equal(r.status, 502);
+      assert.equal(r.body.error, 'UPSTREAM_INVALID_RESPONSE');
+      assert.equal(r.body[kind], undefined);
+      assert.equal(h.calls.length, 1, 'Invalid primary identity must not fetch dependent sections');
+    }
+  });
+  test(`${kind} detail preserves unique matching identity and empty-result not-found`, async t => {
+    const valid = await harness(t, kind, [row(7001)]), r = await valid.request();
+    assert.equal(r.status, 200); assert.equal(r.body[kind].id, 7001);
+    assert.equal(r.body[kind].name, 'Synthetic entity'); assert.equal(r.body.stale, false);
+    if (kind === 'player') assert.deepEqual(r.body.stats, []);
+    const missing = await harness(t, kind, []), absent = await missing.request();
+    assert.equal(absent.status, 404); assert.equal(absent.body.error, `${kind.toUpperCase()}_NOT_FOUND`);
+    assert.equal(missing.calls.length, 1);
+  });
+}
