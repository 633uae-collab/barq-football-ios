+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { prepareEvidence } = require('../analyst-evidence');
+
+const home = { id: 101, name: 'Home' };
+const away = { id: 102, name: 'Away' };
+const row = (id, number) => ({ player: { id, name: 'Player ' + id, number } });
+function prepare(starters, bench = []) {
+  const fixture = { teams: {home, away}, fixture: { id: 501, status: {short: 'NS'} }, lineups: [
+    { team: home, startXI: starters, substitutes: bench },
+    { team: away, startXI: [row(91, 14)] }
+  ] };
+  const original = structuredClone(fixture);
+  const result = prepareEvidence(fixture, 1000);
+  assert.deepEqual(fixture, original);
+  return result.lineups.map(lineup => lineup.startingXI.map(p => [p.name, p.number]));
+}
+test('repeated shirt within the starting side cannot identify either player', () => {
+  for (const ids of [[11,12], [12,11]]) {
+    assert.deepEqual(prepare([row(ids[0],14),row(ids[1],14),row(13,0)]), [
+      [['Player ' + ids[0],null],['Player ' + ids[1],null],['Player 13',0]], [['Player 91',14]]
+    ]);
+  }
+});
+test('starting shirt shared with a substitute is withheld for that side only', () => {
+  assert.deepEqual(prepare([row(11,14)], [row(12,14)]), [[['Player 11',null]], [['Player 91',14]]]);
+});
+test('malformed shirts stay unknown and cannot displace a valid number', () => {
+  for (const value of [-1, 3.5, '14', true, {}, Number.MAX_SAFE_INTEGER + 1]) {
+    assert.deepEqual(prepare([row(11,value),row(12,14)]), [
+      [['Player 11',null],['Player 12',14]], [['Player 91',14]]
+    ]);
+  }
+});
diff --git a/server/test/live-fixture-binding.test.js b/server/test/live-fixture-binding.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..7743745d99d3ca75a9e483349c0d5a7fb9a3e98d
--- /dev/null
+++ b/server/test/live-fixture-binding.test.js
@@ -0,0 +1,128 @@
+'use strict';
+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const {collectEvidence} = require('../chat-evidence');
+// Synthetic fixtures only. No provider or Groq network request.
+const fixture = (id, status='2H', home=529, league=140, season=2025) => ({
+  fixture:{id,date:'2026-11-10T15:00:00Z',status:{short:status,elapsed:70}},
+  teams:{home:{id:home,name:home===529?'Barcelona':'Other club'},away:{id:541,name:'Real Madrid'}},
+  league:{id:league,season,name:'Synthetic competition'},goals:{home:0,away:0}
+});
+function providerFor(rows, detail) {
+ const calls=[];
+ return {calls,async load(path){calls.push(path);
+  if(path==='/fixtures?live=all')return {data:rows,fetchedAt:1000};
+  if(path.startsWith('/fixtures?id='))return {data:[detail || rows.find(f=>f.fixture.id===Number(path.split('=')[1]))],fetchedAt:2000};
+  // A previous completed match must never substitute for a live request.
+  return {data:[fixture(99,'FT')],fetchedAt:1000};
+ }};
+}
+for(const question of ['Analyze a live match in La Liga season 2025/26','حلل مباراة مباشرة في الدوري الإسباني موسم ٢٠٢٥/٢٦']) {
+ test('live selection validates status and requested competition/season: '+question, async()=>{
+  const rows=[fixture(1,'FT'),fixture(2,'NS'),fixture(3,'SUSP'),fixture(4,'2H',529,39),fixture(5,'2H',529,140,2026),fixture(0),fixture(6)];
+  const p=providerFor(rows);const e=await collectEvidence(p,question);
+  assert.equal(e.fixtureId,6);assert.equal(e.status.short,'2H');
+  assert.deepEqual(p.calls,['/fixtures?live=all','/fixtures?id=6']);
+  assert.equal(e.currentScore.home,0);
+ });
+}
+for(const question of ['Analyze Barcelona live now','حلل مباراة برشلونة المباشرة الآن']) {
+ test('live club selection matches the named team and never falls back to a completed match: '+question, async()=>{
+  for(const available of [false,true]) {
+   const rows=[fixture(1,'2H',50),...(available?[fixture(2)]:[])];
+   const p=providerFor(rows);const e=await collectEvidence(p,question);
+   assert.equal(e.fixtureId,available?2:undefined);
+   assert.deepEqual(p.calls,available?['/fixtures?live=all','/fixtures?id=2']:['/fixtures?live=all']);
+   if(!available)assert.ok(e.missing.some(m=>/No live/i.test(m)));
+  }
+ });
+}
+test('a selected live fixture finishing during retrieval is labelled finished without inventing another live match',async()=>{
+ const p=providerFor([fixture(7)],fixture(7,'FT'));
+ const e=await collectEvidence(p,'Analyze a live match');
+ assert.equal(e.fixtureId,7);assert.equal(e.status.short,'FT');
+ assert.ok(e.missing.some(m=>/no longer live/i.test(m)));
+ assert.deepEqual(p.calls,['/fixtures?live=all','/fixtures?id=7']);
+});
+
+test('refreshed live details must still contain the selected participants',async()=>{
+ const swapped=fixture(7);[swapped.teams.home,swapped.teams.away]=[swapped.teams.away,swapped.teams.home];
+ for (const detail of [fixture(7,'2H',50),swapped]) {
+ const p=providerFor([fixture(7)],detail);
+ const e=await collectEvidence(p,'Analyze a live match');
+ assert.equal(e.fixtureId,undefined);
+ assert.equal(e.currentScore,undefined);
+ assert.ok(e.missing.some(m=>/identity was not verified/i.test(m)));
+ }
+});
+
+
+for (const question of ['Analyze Barcelona live now', 'حلل مباراة برشلونة المباشرة الآن']) {
+  test('a repeated live fixture identity cannot select a match: ' + question, async () => {
+    const live = fixture(7);
+    for (const duplicate of [fixture(7, 'FT'), fixture(7, '2H', 50), { fixture: { id: 7 } }, fixture(7)]) {
+      for (const pair of [[live, duplicate], [duplicate, live]]) {
+        for (const sibling of [[], [fixture(8)]]) {
+          const rows = [...pair, ...sibling];
+          const original = structuredClone(rows);
+          const provider = providerFor(rows);
+          const evidence = await collectEvidence(provider, question);
+          assert.deepEqual(provider.calls, sibling.length
+            ? ['/fixtures?live=all', '/fixtures?id=8'] : ['/fixtures?live=all']);
+          assert.equal(evidence.fixtureId, sibling[0]?.fixture.id);
+          assert.equal(evidence.currentScore?.home, sibling.length ? 0 : undefined);
+          assert.ok(evidence.missing.some(message => /duplicate live fixture/i.test(message)));
+          assert.deepEqual(rows, original);
+        }
+      }
+    }
+  });
+}
+
+for (const [question, field] of [
+  ['Analyze a live match', 'id'],
+  ['حلل مباراة مباشرة الآن', 'season']
+]) {
+  test('refresh must preserve the selected competition and season: ' + question, async () => {
+    const selected = fixture(7);
+    for (const changed of [true, false]) {
+      const detail = fixture(7, 'FT');
+      detail.goals = { home: 3, away: 1 };
+      if (changed) detail.league[field]++;
+      const provider = providerFor([selected], detail);
+      const result = await collectEvidence(provider, question);
+      assert.deepEqual(provider.calls, ['/fixtures?live=all', '/fixtures?id=7']);
+      assert.equal(result.fixtureId, changed ? undefined : 7);
+      assert.equal(result.followUpContext.fixtureId, changed ? undefined : 7);
+      assert.deepEqual(result.currentScore, changed ? undefined : detail.goals);
+      if (changed) assert.ok(result.missing.some(m => /competition or season/i.test(m)));
+      else assert.equal(result.status.short, 'FT');
+    }
+  });
+}
+
+for (const [question, followUp] of [
+  ['Analyze a live match', 'Show the score for the same match'],
+  ['حلل مباراة مباشرة الآن', 'كم نتيجة نفس المباراة؟']
+]) {
+  test('restored follow-up cannot revive conflicting fixture participants: ' + question, async () => {
+    const listed = fixture(7);
+    for (const variant of ['replacement', 'swapped', 'valid']) {
+      const detail = fixture(7, 'FT', variant === 'replacement' ? 50 : 529);
+      if (variant === 'swapped') [detail.teams.home, detail.teams.away] = [detail.teams.away, detail.teams.home];
+      detail.goals = { home: 3, away: 0 };
+      const provider = providerFor([listed], detail);
+      const first = await collectEvidence(provider, question);
+      const valid = variant === 'valid';
+      assert.deepEqual(first.currentScore, valid ? detail.goals : undefined);
+      const restored = JSON.parse(JSON.stringify(first.followUpContext));
+      const next = await collectEvidence(provider, followUp, restored, [{ role: 'user', content: question }]);
+      assert.deepEqual(next.currentScore, valid ? detail.goals : undefined);
+      assert.deepEqual(restored, valid ? { fixtureId: 7 } : {});
+      assert.deepEqual(provider.calls, valid
+        ? ['/fixtures?live=all', '/fixtures?id=7', '/fixtures?id=7']
+        : ['/fixtures?live=all', '/fixtures?id=7']);
+      if (!valid) assert.ok(next.missing.some(note => /specify.*match/i.test(note)));
+    }
+  });
+}
diff --git a/server/test/live-followup-context.test.js b/server/test/live-followup-context.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..5b10933d2156fa3adec3e317c1750ea9c3bfb095
--- /dev/null
+++ b/server/test/live-followup-context.test.js
@@ -0,0 +1,78 @@
+'use strict';
+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const {collectEvidence}=require('../chat-evidence');
+// Synthetic only: another live fixture deliberately has a different score.
+const fixture=(id,status='2H')=>({fixture:{id,status:{short:status,elapsed:70}},
+ teams:{home:{id:90001,name:'Synthetic Home'},away:{id:90002,name:'Synthetic Away'}},
+ league:{id:140,season:2025,name:'Synthetic League'},goals:{home:id===7?0:9,away:0}});
+function provider(status='2H') { const calls=[];return {calls,async load(path){calls.push(path);
+ if(path==='/fixtures?live=all')return {data:[fixture(8)],fetchedAt:1};
+ if(path==='/fixtures?id=7')return {data:[fixture(7,status)],fetchedAt:2};
+ if(path==='/fixtures?id=8')return {data:[fixture(8)],fetchedAt:2};
+ throw Error('Unexpected synthetic request: '+path);
+}};}
+for(const question of ['Show statistics for the same live match','اعرض إحصاءات نفس المباراة المباشرة']) {
+ test('live follow-up retains the restored fixture: '+question,async()=>{
+  const p=provider();const e=await collectEvidence(p,question,{fixtureId:7},[{role:'user',content:'Analyze a live match'}]);
+  assert.equal(e.fixtureId,7);assert.equal(e.currentScore.home,0);
+  assert.deepEqual(e.followUpContext,{fixtureId:7});assert.deepEqual(p.calls,['/fixtures?id=7']);
+ });
+ test('a same-live-match reference without identity never chooses another match: '+question,async()=>{
+  const p=provider();const e=await collectEvidence(p,question);
+  assert.equal(e.fixtureId,undefined);assert.equal(e.currentScore,undefined);assert.deepEqual(p.calls,[]);
+  assert.ok(e.missing.some(x=>/specify.*match/i.test(x)));
+ });
+}
+test('refreshing a retained live fixture reports its finished status; a fresh request still selects live',async()=>{
+ const p=provider('FT');const e=await collectEvidence(p,'Show statistics for the same live match',{fixtureId:7});
+ assert.equal(e.fixtureId,7);assert.equal(e.status.short,'FT');assert.ok(e.missing.some(x=>/no longer live/i.test(x)));
+ assert.deepEqual(p.calls,['/fixtures?id=7']);
+ const fresh=provider();const next=await collectEvidence(fresh,'Analyze a live match');
+ assert.equal(next.fixtureId,8);assert.deepEqual(fresh.calls,['/fixtures?live=all','/fixtures?id=8']);
+});
+
+function clubProvider() {
+  const calls = [];
+  const clubFixture = id => {
+    const match = fixture(id);
+    match.teams.home = {id: 529, name: 'Barcelona'};
+    return match;
+  };
+  return {calls, async load(path) {
+    calls.push(path);
+    if (path === '/fixtures?id=7') return {data: [clubFixture(7)], fetchedAt: 2};
+    if (path === '/fixtures?id=8' || path.startsWith('/fixtures?team=529'))
+      return {data: [clubFixture(8)], fetchedAt: 2};
+    return {data: [], fetchedAt: 2};
+  }};
+}
+
+for (const question of [
+  'How did Barcelona play in the same live match?',
+  'كيف لعب برشلونة في نفس المباراة المباشرة؟',
+  'Show the score for Barcelona in the same match',
+  'كم نتيجة برشلونة في نفس المباراة؟'
+]) {
+  test('a named club constrains the restored match: ' + question, async () => {
+    const p = clubProvider();
+    const evidence = await collectEvidence(p, question, {fixtureId: 7});
+    assert.equal(evidence.fixtureId, 7);
+    assert.equal(evidence.currentScore.home, 0);
+    assert.deepEqual(p.calls, ['/fixtures?id=7']);
+  });
+}
+test('a club cannot supply a missing same-match identity', async () => {
+  const p = clubProvider();
