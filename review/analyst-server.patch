+ const before=structuredClone(history);
+ const e=await collectEvidence(p,'How many assists?',{playerIds:[1100]},history);
+ assert.equal(e.playerProfiles[0].season,2025);
+ assert.equal(e.playerProfiles[0].statistics[0].statistics[0].scoring.goals,7);
