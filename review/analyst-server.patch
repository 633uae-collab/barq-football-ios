--- /dev/null
+++ b/server/test/player-route-season-binding.test.js
@@ -0,0 +1,38 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { createApp } = require('../app');
+
+const stat = (season, team = 9001, league = 140) => ({ team: { id: team }, league: { id: league, season }, games: { appearences: 0, minutes: 0 }, goals: { total: 0, assists: 0 } });
+async function request(t, statistics, explicit = true) {
+  const original = structuredClone(statistics), calls = [];
+  const provider = { get: async path => {
+    calls.push(path);
+    return { data: path.startsWith('/players/seasons?') ? [2024, 2025] : [{ player: { id: 7001, name: 'Synthetic player' }, statistics }], stale: true };
+  } };
+  const server = createApp({ provider }).listen(0, '127.0.0.1');
+  await new Promise(resolve => server.once('listening', resolve));
+  t.after(() => new Promise(resolve => server.close(resolve)));
+  const res = await fetch(`http://127.0.0.1:${server.address().port}/api/player/7001${explicit ? '?season=2025' : ''}`);
+  const body = await res.json();
+  assert.deepEqual(statistics, original, 'Provider input must not change');
+  assert.equal(new URL(calls.at(-1), 'https://synthetic.invalid').searchParams.get('season'), '2025');
+  return { status: res.status, body };
+}
+test('player detail rejects wrong or unverifiable season before exposing statistics', async t => {
+  for (const statistics of [[stat(2024)], [stat('2025')], [stat(undefined)], [stat(2025), stat(2024)], [stat(2024), stat(2025)], [null], {}, false]) {
+    const r = await request(t, statistics);
+    assert.equal(r.status, 502); assert.deepEqual(r.body, { error: 'UPSTREAM_INVALID_RESPONSE' });
+  }
+});
+test('player detail also binds statistics to automatically selected season', async t => {
+  const r = await request(t, [stat(2024)], false);
+  assert.equal(r.status, 502); assert.deepEqual(r.body, { error: 'UPSTREAM_INVALID_RESPONSE' });
+});
+test('player detail preserves requested-season transfer clubs, competitions, zeros and empty statistics', async t => {
+  const r = await request(t, [stat(2025), stat(2025, 9002), stat(2025, 9002, 2)]);
+  assert.equal(r.status, 200); assert.equal(r.body.player.id, 7001); assert.equal(r.body.stale, true);
+  assert.deepEqual(r.body.stats.map(s => [s.team.id, s.league.id, s.league.season, s.goals, s.assists, s.apps, s.minutes]), [[9001, 140, 2025, 0, 0, 0, 0], [9002, 140, 2025, 0, 0, 0, 0], [9002, 2, 2025, 0, 0, 0, 0]]);
+  for (const statistics of [[], undefined, null]) {
+    const empty = await request(t, statistics); assert.equal(empty.status, 200); assert.deepEqual(empty.body.stats, []);
+  }
+});
