+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { collectEvidence } = require('../chat-evidence');
+
+test('a named club comparison discards previous player and match context in both languages', async () => {
+  for (const question of ['قارن برشلونة وريال مدريد هذا الموسم', 'Compare Barcelona and Real Madrid this season']) {
+    const calls = [];
+    const provider = { load: async path => {
+      calls.push(path);
+      if (path.startsWith('/leagues?')) return { fetchedAt: 1, data: [{ league: { id: 140, name: 'La Liga', type: 'League' }, seasons: [{ year: 2026, current: true }] }] };
+      if (path.startsWith('/teams/statistics?')) {
+        const team = Number(new URLSearchParams(path.split('?')[1]).get('team'));
+        return { fetchedAt: 1, data: { team: {id: team, name: team === 529 ? 'Barcelona' : 'Real Madrid'}, league: {id:140,name:'La Liga',season:2026}, fixtures:{played:{total:12},wins:{total:team===529?11:10},draws:{total:0},loses:{total:team===529?1:2}} } };
+      }
+      throw Error('Unrelated request: ' + path);
+    } };
+    const evidence = await collectEvidence(provider, question, {fixtureId:7,teamIds:[50],playerIds:[1100]}, [{role:'user',content:'Give Haaland lineup statistics for the same match'}]);
+    assert.equal(evidence.seasonOnlyComparison, true);
+    assert.deepEqual(evidence.followUpContext, {teamIds:[529,541]});
+    assert.equal(evidence.playerProfiles, undefined);
+    assert.equal(evidence.fixtureId, undefined);
+    assert.deepEqual(evidence.clubs.map(c=>[c.team.id,c.season.totals.wins]), [[529,11],[541,10]]);
+    assert.equal(calls.length,4);
+  }
+});
+
+test('a fresh live request drops old club/player scopes but a same-match follow-up retains its fixture', async () => {
+  const calls=[];
+  const provider={load:async path=>{calls.push(path);return {fetchedAt:1,data:[]};}};
+  for (const question of ['حلل مباراة مباشرة الآن','Analyze a live match now']) {
+    calls.length=0;
+    const evidence=await collectEvidence(provider,question,{fixtureId:7,teamIds:[529],playerIds:[1100]});
+    assert.deepEqual(calls,['/fixtures?live=all']);
+    assert.deepEqual(evidence.followUpContext,{});
+  }
+  calls.length=0;
+  const evidence=await collectEvidence(provider,'What is the lineup for the same match?',{fixtureId:7});
+  assert.deepEqual(calls,['/fixtures?id=7']);
+  assert.deepEqual(evidence.followUpContext,{fixtureId:7});
+});
