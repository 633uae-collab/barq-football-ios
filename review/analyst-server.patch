+      const before=structuredClone(rows);
+      const e=await collect(question,rows);
+      assert.deepEqual(e.scoringLeaders.map(p=>p.playerId),[90012,90013,90014,90015,90016]);
+      assert.ok(e.missing.some(m=>m.includes('Repeated scoring-leader')));
+      assert.deepEqual(rows,before);
+    }
+  });
+}
+test('leaders exclude all repeated identities even when all returned rows repeat',async()=>{
+  const e=await collect('Premier League top scorers season 2025/26',[row(90011,7),row(90011,8)]);
+  assert.deepEqual(e.scoringLeaders,[]);
+  assert.ok(e.missing.some(m=>m.includes('No scoring leaders')));
+});
+test('leaders retain zeros, provider order and distinct transfer scopes in a single record',async()=>{
