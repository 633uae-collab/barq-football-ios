+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { collectEvidence } = require('../chat-evidence');
+
+for (const [question, id, expectedRequests] of [
+  ['Compare Barcelona and Real Madrid this season', 140, 2],
+  ['قارن برشلونة وريال مدريد هذا الموسم', 140, 2],
+  ['Premier League top scorers', 39, 1],
+  ['هدافو الدوري الإنجليزي', 39, 1],
+]) {
+  test('current season has one verified year for ' + question, async () => {
+    const old = { year: 2024, current: true }, recent = { year: 2025, current: true };
+    for (const [seasonGroups, expected] of [
+      [[[old, recent]], []], [[[recent, old]], []], [[[old], [recent]], []],
+      [[[{ year: 2024, current: 'false' }, recent]], [2025]],
+      [[[{ year: '2024', current: true }]], []],
+      [[[{ year: 2024, current: false }, recent]], [2025]],
+    ]) {
+      const requestedYears = [];
+      await collectEvidence({ async load(path) {
+        const url = new URL(path, 'https://synthetic.invalid');
+        if (url.pathname === '/leagues') return { fetchedAt: 1, data: seasonGroups.map(seasons => ({
+          league: { id, type: 'League', name: 'Synthetic league' }, seasons,
+        })) };
+        assert.ok(['/players/topscorers', '/teams/statistics'].includes(url.pathname));
+        requestedYears.push(Number(url.searchParams.get('season')));
+        return { fetchedAt: 1, data: [] };
+      } }, question);
+      assert.deepEqual(requestedYears, Array(expectedRequests).fill(expected).flat());
+    }
+  });
+}
