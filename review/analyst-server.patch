+async function collect(question,overrides={}) {
+ const defaults={'/players/profiles':[{player:{id:1100,name:'Haaland'}}],'/players/teams':[{team:{id:50},seasons:[2025]}],'/players/squads':[{team:{id:50}}],'/fixtures':[fixture()],'/fixtures/players':[{team:{id:50,name:'Synthetic Club'},players:[{player:{id:1100,name:'Haaland'},statistics:[{games:{minutes:90},goals:{total:0}}]}]}]};
+ const data={...defaults,...overrides},before=structuredClone(data),requests=[];
+ const e=await collectEvidence({load:async path=>{requests.push(path);return{fetchedAt:1,data:Object.hasOwn(data,path.split('?')[0])?data[path.split('?')[0]]:[]};}},question);
+ assert.deepEqual(data,before);
+ return {e,requests};
+}
+for(const q of ['Analyze Haaland over the last five matches','حلل هالاند في آخر خمس مباريات']) {
+ test('malformed squads preserve explicitly limited career fallback: '+q,async()=>{
+  for(const bad of [null,{},'invalid',[null,false,{team:{id:50}}]]) {
+   const {e}=await collect(q,{'/players/squads':bad});
+   assert.deepEqual(e.playerProfiles[0].lastFiveAppearances.map(a=>a.match.id),[90001]);
+   if(!Array.isArray(bad))assert.ok(e.missing.some(m=>m.includes('not verified current registration')));
+   assert.equal(e.playerProfiles[0].lastFiveAppearances[0].player.statistics[0].scoring.goals,0);
+  }
+ });
+ test('malformed fixture collections report incomplete appearance coverage: '+q,async()=>{
+  for(const bad of [null,{},'invalid',false]) {
+   const {e,requests}=await collect(q,{'/fixtures':bad});
+   assert.equal(e.playerProfiles[0].appearanceCoverage.found,0);
+   assert.deepEqual(e.playerProfiles[0].lastFiveAppearances,[]);
+   assert.ok(e.missing.some(m=>m.includes('Only 0 appearances')));
+   assert.ok(!requests.some(p=>p.startsWith('/fixtures/players')));
+  }
+ });
+}
+test('valid fixture siblings survive malformed rows and keep season binding',async()=>{
+ const wrong=fixture();wrong.fixture.id=90002;wrong.league.season=2026;
+ const {e}=await collect('Analyze Haaland over the last five matches Premier League season 2025/26',{'/fixtures':[null,false,{},wrong,fixture()]});
+ assert.deepEqual(e.playerProfiles[0].lastFiveAppearances.map(a=>a.match.id),[90001]);
+ assert.equal(e.playerProfiles[0].appearanceCoverage.found,1);
+});
+
+const squadRows = ids => ids.map(id => ({team: {id}}));
+const fixtureTeamsRequested = requests => requests.filter(path => path.startsWith('/fixtures?'))
+  .map(path => new URL(path, 'https://synthetic.invalid').searchParams.get('team'));
+
+test('invalid squad IDs cannot displace a valid club from the last-five lookup', async () => {
+  const {e, requests} = await collect('حلل هالاند في آخر خمس مباريات', {
+    '/players/squads': squadRows([0, -2, Number.MAX_SAFE_INTEGER + 1, 50, 50])
+  });
+  assert.deepEqual(fixtureTeamsRequested(requests), ['50']);
+  assert.equal(e.playerProfiles[0].appearanceCoverage.found, 1);
+});
+
+test('more current squads than the lookup budget cannot establish a latest five', async () => {
+  for (const ids of [[50, 60, 70], [70, 60, 50]]) {
+    const {e, requests} = await collect('Analyze Haaland over the last five matches', {
+      '/players/squads': squadRows(ids)
+    });
+    assert.deepEqual(fixtureTeamsRequested(requests), []);
+    assert.equal(e.playerProfiles[0].appearanceCoverage.found, 0);
+    assert.ok(e.missing.some(message => message.includes('two-team lookup limit')));
+  }
+});
+
+test('career fallback for a transfer season searches both clubs in either provider order', async () => {
+  for (const ids of [[50, 60], [60, 50]]) {
+    const {requests} = await collect('Analyze Haaland over the last five matches', {
+      '/players/teams': squadRows(ids).map(team => ({...team, seasons: [2025]})),
+      '/players/squads': []
+    });
