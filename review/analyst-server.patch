--- /dev/null
+++ b/server/test/chat-context-roundtrip.test.js
@@ -0,0 +1,102 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { EventEmitter } = require('node:events');
+const { mountChat } = require('../chat');
+
+function conversation(mbappeId = 7101) {
+  let handler, now = Date.UTC(2026, 0, 1);
+  const evidence = [], calls = [];
+  const people = {
+    Mbappe: { id: mbappeId, name: 'K. Mbappé', firstname: 'Kylian', lastname: 'Mbappé' },
+    Lewandowski: { id: 7102, name: 'R. Lewandowski', firstname: 'Robert', lastname: 'Lewandowski' }
+  };
+  const provider = { async load(path) {
+    calls.push(path);
+    const url = new URL(path, 'https://synthetic.invalid');
+    const player = people[url.searchParams.get('search')];
+    return { data: player ? [{ player }] : [], fetchedAt: now, paging: { current: 1, total: 1 } };
+  } };
+  mountChat({ post(_, fn) { handler = fn; } }, { provider, analyst: {
+    chatEnabled: true, freePlanConfirmed: true, key: 'synthetic', now: () => now,
+    async answer(_, e) {
+      evidence.push(e);
+      return { answer: 'Synthetic answer', model: 'synthetic', generatedAt: now };
+    }
+  } });
+  return { evidence, calls, async ask(question, context = {}, history = []) {
+    now += 66000;
+    let body;
+    const response = new EventEmitter();
+    response.json = value => { body = JSON.parse(JSON.stringify(value)); };
+    await handler({ body: { question, context, history } }, response);
+    return body;
+  } };
+}
+for (const question of ['Compare Barcelona, Real Madrid, Manchester City and Liverpool',
+  'قارن برشلونة وريال مدريد ومانشستر سيتي وليفربول']) {
+  test('multi-club answer can be followed up without silently selecting a pair: ' + question, async () => {
+    const chat = conversation();
+    const first = await chat.ask(question);
+    assert.equal(chat.evidence[0].clubs.length, 4);
+    await chat.ask('وضح أكثر', first.context, [{ role: 'user', content: question }, { role: 'assistant', content: first.answer }]);
+    assert.deepEqual(first.context, {});
+    assert.equal(chat.evidence[1].clubs, undefined);
+    assert.ok(first.missing.some(m => /follow-up/i.test(m)));
+  });
+}
+for (const [question, id] of [
+  ['Compare Haaland, Mbappe and Lewandowski at Barcelona', 7101],
+  ['قارن مبابي وليفاندوفسكي في برشلونة', 1000000000]
+]) {
+  test('unrepresentable player set preserves independent club context: ' + question, async () => {
+    const chat = conversation(id);
+    const first = await chat.ask(question);
+    const next = await chat.ask('Show more', first.context);
+    assert.deepEqual(first.context, { teamIds: [529] });
+    assert.deepEqual(next.context, first.context);
+    assert.ok(first.missing.some(m => /follow-up/i.test(m)));
+  });
+}
+test('both supported club IDs survive the round trip and invalid client context is still rejected', async () => {
+  const chat = conversation();
+  const first = await chat.ask('Compare Barcelona and Real Madrid');
+  assert.deepEqual(first.context, { teamIds: [529, 541] });
+  assert.deepEqual((await chat.ask('Show more', first.context)).context, first.context);
+  await assert.rejects(chat.ask('Show more', { teamIds: [529, 541, 40] }), { code: 'INVALID_ANALYSIS_CONTEXT' });
+});
+
+for (const question of [
+  'Show the completed match for Liverpool in La Liga and the Premier League',
+  'حلل مباراة منتهية لليفربول في الدوري الإسباني والدوري الإنجليزي'
+]) {
+  test('switching to an ambiguous club query clears the previous archived identity: ' + question, async () => {
+    const chat = conversation();
+    const first = await chat.ask('Compare Barcelona and Real Madrid');
+    const history = [{ role: 'user', content: question }, { role: 'assistant', content: 'Synthetic clarification' }];
+    const clarification = await chat.ask(question, first.context);
+    assert.ok(clarification.missing.some(message => /one supported competition/.test(message)));
+    // The app replaces its persisted context only when the successful reply includes one.
+    const restored = JSON.parse(JSON.stringify(clarification.context ?? first.context));
+    const next = await chat.ask('Show more', restored, history);
+    assert.deepEqual(restored, {});
+    assert.deepEqual(next.context, {});
+    assert.ok(!chat.evidence[2].clubs?.length);
+  });
+}
+
+for (const [question, field, id] of [
+  ['Show more', 'teamIds', 529], ['وضح أكثر', 'playerIds', 1100]
+]) {
+  test('a repeated archived ID follows the same route as one entity: ' + field, async () => {
+    const restored = { [field]: [id, id] };
+    const single = conversation(), repeated = conversation();
+    const expected = await single.ask(question, { [field]: [id] });
+    const result = await repeated.ask(question, restored);
+    assert.deepEqual(repeated.calls, single.calls);
+    assert.ok(single.calls.length > 0);
+    assert.deepEqual(result.context, expected.context);
+    assert.deepEqual(result.context[field], [id]);
+    assert.deepEqual(restored[field], [id, id]);
+  });
+}
diff --git a/server/test/chat-disconnect.test.js b/server/test/chat-disconnect.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..67323adbd5d8080b9d512c84196eae24681172bc
--- /dev/null
+++ b/server/test/chat-disconnect.test.js
@@ -0,0 +1,50 @@
+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const express = require('express');
+const { mountChat } = require('../chat');
+const deferred = () => { let resolve; const promise = new Promise(r => { resolve = r; }); return { promise, resolve }; };
+async function setup(t, phase) {
+  const entered = deferred(), release = deferred(), closed = deferred(), done = deferred();
+  let now = Date.UTC(2026, 0, 1), generations = 0, writes = 0, first = true;
+  const app = express(); app.use(express.json());
+  const analyst = { key: 'synthetic', chatEnabled: true, freePlanConfirmed: true, blockedUntil: 0, now: () => now,
+    answer: async () => { generations++; if (phase === 'answer' && generations === 1) { entered.resolve(); await release.promise; }
+      return { answer: 'Synthetic control', model: 'openai/gpt-oss-120b', generatedAt: now }; } };
+  const provider = { load: async () => { if (phase === 'evidence' && first) { first = false; entered.resolve(); await release.promise; }
+    return { data: [], fetchedAt: now }; } };
+  mountChat({ post: (path, handler) => app.post(path, async (req, res) => {
+    res.once('close', closed.resolve);
+    const json = res.json.bind(res); res.json = value => { writes++; return json(value); };
+    try { await handler(req, res); } finally { done.resolve(); }
+  }) }, { analyst, provider });
+  app.use((error, req, res, next) => res.status(error.status || 500).json({ code: error.code || error.message }));
+  const server = app.listen(0, '127.0.0.1'); await new Promise(r => server.once('listening', r));
+  t.after(async () => { release.resolve(); server.closeAllConnections(); await new Promise(r => server.close(r)); });
+  const url = `http://127.0.0.1:${server.address().port}/api/analyst/chat`;
+  const body = question => JSON.stringify({ question, context: { fixtureId: 7 } });
+  return { entered, release, closed, done, counts: () => ({ generations, writes }), advance: () => { now += 65001; },
+    post: () => fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: body('Analyze') }),
+    disconnect: async question => { const req = http.request(url, { method: 'POST', headers: { 'content-type': 'application/json' } });
+      req.on('error', () => {}); req.end(body(question)); await entered.promise; req.destroy(); await closed.promise; }
+  };
+}
+for (const question of ['حلل المباراة', 'Analyze this match']) test(`disconnect during evidence does not start generation: ${question}`, { timeout: 5000 }, async t => {
+  const h = await setup(t, 'evidence'); await h.disconnect(question); h.release.resolve(); await h.done.promise;
+  assert.deepEqual(h.counts(), { generations: 0, writes: 0 });
+  assert.equal((await h.post()).status, 429); // No spacing refund on disconnect.
+  for (let i = 0; i < 19; i++) { h.advance(); const response = await h.post(); assert.equal(response.status, 200); assert.equal((await response.json()).answer, 'Synthetic control'); }
+  h.advance(); assert.equal((await h.post()).status, 429); // The disconnected admission still counts toward twenty.
+  assert.equal(h.counts().generations, 19);
+});
+test('disconnect during an already started answer suppresses late response and releases active slot', { timeout: 5000 }, async t => {
+  const h = await setup(t, 'answer'); await h.disconnect('Analyze'); h.release.resolve(); await h.done.promise;
+  assert.deepEqual(h.counts(), { generations: 1, writes: 0 });
+  h.advance(); assert.equal((await h.post()).status, 200); assert.equal(h.counts().generations, 2);
+});
+test('completed request body with an open response still receives its delayed answer', { timeout: 5000 }, async t => {
+  const h = await setup(t, 'evidence'); const pending = h.post(); await h.entered.promise; h.release.resolve();
+  const response = await pending; assert.equal(response.status, 200); assert.equal((await response.json()).answer, 'Synthetic control');
+  assert.deepEqual(h.counts(), { generations: 1, writes: 1 });
+});
