+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { collectEvidence } = require('../chat-evidence');
+const { Provider } = require('../provider');
+
+// Synthetic IDs and totals: these test binding, not real player statistics.
+const profiles = [
+  { id: 7001, name: 'K. Mbappé', firstname: 'Kylian', lastname: 'Mbappé Lottin' },
+  { id: 7002, name: 'R. Lewandowski', firstname: 'Robert', lastname: 'Lewandowski' }
+];
+function fixtureProvider(change = {}) {
+  const calls = [];
+  return { calls, async load(path) {
+    calls.push(path);
+    const u = new URL(path, 'https://fixture.invalid');
+    const search = u.searchParams.get('search');
+    const id = Number(u.searchParams.get('id') || u.searchParams.get('player'));
+    if (u.pathname === '/players/profiles') {
+      const p = search ? profiles[search === 'Mbappe' ? 0 : 1] : profiles.find(p => p.id === id);
+      return { data: change.rows ? change.rows(p) : [{ player: p }], fetchedAt: 1000,
+        paging: change.paging || { current: 1, total: 1 } };
+    }
+    if (u.pathname === '/players/teams') return { data: [{ team: { id: 8000 + id }, seasons: [2025, 2026] }], fetchedAt: 1000 };
+    if (u.pathname === '/players') {
+      const p = profiles.find(p => p.id === id);
+      const statistics = [{ team: { id: 8000 + id, name: 'Synthetic club' },
+        league: { id: 140, name: 'La Liga', season: 2025 }, goals: { total: id === 7001 ? 0 : 2, assists: 0 } }];
+      return { data: [{ player: change.statsName ? { ...p, name: 'Wrong player', firstname: 'Wrong', lastname: 'Player' } : p, statistics }], fetchedAt: 1000 };
+    }
+    return { data: [], fetchedAt: 1000 };
+  } };
+}
+test('named player comparison replaces old clubs, fixture and player in Arabic and English', async () => {
+  for (const question of ['قارن مبابي وليفاندوفسكي في الدوري الإسباني موسم ٢٠٢٥/٢٦', 'Compare Mbappé and Lewandowski in La Liga season 2025/26']) {
+    const provider = fixtureProvider();
+    const e = await collectEvidence(provider, question, { teamIds: [529, 541], playerIds: [1100], fixtureId: 7 }, [{ role: 'user', content: 'Compare Barcelona and Real Madrid this season' }]);
+    assert.equal(e.clubs, undefined);
+    assert.equal(e.seasonOnlyComparison, undefined);
+    assert.deepEqual(e.followUpContext, { playerIds: [7001, 7002] });
+    assert.equal(e.playerProfiles.length, 2);
+    assert.deepEqual(e.playerProfiles.map(p => [p.playerId, p.season, p.statistics[0].statistics[0].scoring.goals]), [[7001, 2025, 0], [7002, 2025, 2]]);
+    assert.ok(provider.calls.includes('/players/profiles?search=Mbappe'));
+    assert.ok(provider.calls.includes('/players/profiles?search=Lewandowski'));
+    assert.ok(!provider.calls.some(p => /fixtures|teams\/statistics|1100|season=2026/.test(p)));
+  }
+});
+test('surname alone never selects a different first name or first duplicate profile', async () => {
+  for (const rows of [p => [{ player: { ...p, firstname: 'Ethan', name: 'E. Mbappé' } }],
+    p => [{ player: p }, { player: { ...p, id: 9001 } }]]) {
+    const provider = fixtureProvider({ rows });
+    const e = await collectEvidence(provider, 'Analyze Mbappe in La Liga season 2025/26', { playerIds: [1100], fixtureId: 7 });
+    assert.deepEqual(e.followUpContext, {});
+    assert.ok(!e.playerProfiles?.length);
+    assert.deepEqual(provider.calls, ['/players/profiles?search=Mbappe']);
+    assert.ok(e.missing.some(m => /identity/i.test(m)));
+  }
+});
+test('incomplete or missing profile pagination cannot establish unique identity', async () => {
+  for (const paging of [{ current: 1, total: 2 }, {}, { current: 2, total: 2 }]) {
+  const provider = fixtureProvider({ paging });
+  const e = await collectEvidence(provider, 'Analyze Lewandowski season 2025/26', { playerIds: [1100] });
+  assert.deepEqual(e.followUpContext, {});
+  assert.deepEqual(provider.calls, ['/players/profiles?search=Lewandowski']);
+  assert.ok(e.missing.some(m => /identity/i.test(m)));
+  }
+});
+test('conflicting duplicate ID and invalid profile IDs are rejected', async () => {
+  for (const rows of [p => [{ player: p }, { player: { ...p, firstname: 'Ethan' } }],
+    p => [null, { player: { ...p, id: 0 } }], p => [{ player: { ...p, id: '7001' } }]]) {
+    const provider = fixtureProvider({ rows });
+    const e = await collectEvidence(provider, 'Analyze Mbappe season 2025/26');
+    assert.deepEqual(e.followUpContext, {});
+    assert.deepEqual(provider.calls, ['/players/profiles?search=Mbappe']);
+  }
+});
+test('a matching numeric ID with a contradictory statistics name is withheld', async () => {
+  const provider = fixtureProvider({ statsName: true });
+  const e = await collectEvidence(provider, 'Analyze Mbappe in La Liga season 2025/26');
+  assert.equal(e.playerProfiles.length, 1);
+  assert.deepEqual(e.playerProfiles[0].statistics, []);
+  assert.ok(e.missing.some(m => /totals withheld/i.test(m)));
+});
+test('unresolved player is not replaced by league leaders or an old player', async () => {
+  const provider = fixtureProvider({ rows: () => [] });
+  const e = await collectEvidence(provider, 'Mbappe Premier League season 2025/26', { playerIds: [1100] });
+  assert.deepEqual(provider.calls, ['/players/profiles?search=Mbappe']);
+  assert.equal(e.scoringLeaders, undefined);
+  assert.deepEqual(e.followUpContext, {});
+});
+test('provider preserves paging for bounded identity resolution', async () => {
+  const p = new Provider({ key: 'test-only', fetchImpl: async () => new Response(JSON.stringify({
