+      const { evidence, calls } = await ask(question, names);
+      assert.deepEqual(evidence.playerProfiles, []);
+      assert.equal(evidence.followUpContext.playerIds, undefined);
+      assert.deepEqual(calls, ['/players/profiles']);
+      assert.ok(evidence.missing.some(message => /identity/i.test(message)));
+    }
+  });
+}
+test('preserves supported profile spellings and verified zero totals', async () => {
+  for (const names of [{ name: 'Haaland' }, { name: 'E. Haaland', firstname: 'Erling', lastname: 'Haaland' },
+    { name: 'E. Haaland', firstname: 'Erling', lastname: 'Braut Haaland' },
+    { name: 'Erling Braut Håland', firstname: 'Erling Braut', lastname: 'Håland' }]) {
+    const { evidence } = await ask('Haaland statistics in season 2025/26', names);
+    assert.deepEqual(evidence.followUpContext.playerIds, [1100]);
+    assert.equal(evidence.playerProfiles[0].statistics[0].statistics[0].scoring.goals, 0);
+  }
+});
