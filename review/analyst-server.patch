@@ -0,0 +1,21 @@
+'use strict';
+const { seasonAnswer } = require('./season-answer');
+const { ServiceError } = require('./provider');
+// Final response boundary, also used after model generation for mixed questions.
+// Arbitrary prose cannot be proved to bind a number to a team/league/season by
+// checking that the number merely occurs somewhere in evidence. Fail closed:
+// only the canonical identity-bound season rendering can cross this boundary.
+// This deliberately withholds mixed tactical prose, rather than labelling it
+// verified. No second model request and no statistical values from history.
+function finalizeSeasonAnswer(question, candidate, evidence) {
+  const seasonal = evidence.seasonOnlyComparison || (evidence.clubs || []).some(c => c.season != null);
+  if (!seasonal) return null;
+  const canonical = seasonAnswer(question, {...evidence, seasonOnlyComparison: true});
+  if (typeof canonical !== 'string' || !canonical.trim()) throw new ServiceError('AI_FACT_CHECK_FAILED', 502);
+  const replaced = candidate !== canonical;
+  const notice = /[\u0600-\u06ff]/u.test(question)
+    ? 'اقتصر الرد النهائي على إحصاءات الموسم المرتبطة بالفريق والبطولة؛ لم تُعرض استنتاجات النص المولّد غير المتحققة.\n\n'
+    : 'The final response is limited to team- and competition-bound season statistics; unverified generated interpretations are withheld.\n\n';
+  return {answer: (replaced ? notice : '') + canonical, model: 'verified-provider-data', source: 'API-Football'};
+}
+module.exports = { finalizeSeasonAnswer };
