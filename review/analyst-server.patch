+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { collectEvidence } = require('../chat-evidence');
+const questions = ['Compare Barcelona and Real Madrid in La Liga season 2025/26', 'قارن برشلونة وريال مدريد في الليغا موسم ٢٠٢٥/٢٦'];
+const valid = { league: { id: 140, name: 'La Liga', type: 'League' }, seasons: [{ year: 2025 }] };
+async function collect(question, leagues) {
+  const calls = [], original = structuredClone(leagues);
+  const evidence = await collectEvidence({ async load(path) {
+    calls.push(path);
+    const u = new URL(path, 'https://synthetic.invalid');
+    if (u.pathname === '/leagues') return { data: leagues, fetchedAt: 1 };
+    assert.equal(u.pathname, '/teams/statistics');
+    assert.equal(u.searchParams.get('season'), '2025');
+    const id = Number(u.searchParams.get('team'));
+    return { fetchedAt: 1, data: { team: { id, name: id === 529 ? 'Barcelona' : 'Real Madrid' },
+      league: { id: 140, season: 2025 }, fixtures: { played: { total: 0 }, wins: { total: 0 }, draws: { total: 0 }, loses: { total: 0 } } } };
+  } }, question);
+  assert.deepEqual(leagues, original);
+  return { evidence, calls };
+}
+for (const question of questions) {
+  test('malformed club league collections are withheld: ' + question, async () => {
+    for (const leagues of [null, false, {}, 'invalid', [null], [{ ...valid, seasons: {} }]]) {
+      const { evidence, calls } = await collect(question, leagues);
+      assert.equal(evidence.clubs.length, 2);
+      assert.ok(evidence.clubs.every(c => !c.season));
+      assert.ok(evidence.missing.some(m => /season unavailable/.test(m)));
+      assert.equal(calls.length, 2);
+    }
+  });
+  test('valid club league and season siblings survive malformed rows: ' + question, async () => {
+    const { evidence, calls } = await collect(question, [null, false, { ...valid, seasons: '2025' }, { ...valid, seasons: [null, false, { year: 2025 }] }]);
