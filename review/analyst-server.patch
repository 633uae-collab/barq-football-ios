+    assert.equal(path, '/fixtures?id=7');
+    return { fetchedAt: 1, data: [{
+      fixture: { id: 7, status: { short: 'FT' } },
+      teams: { home: { id: 901, name: 'Test Home' }, away: { id: 902, name: 'Test Away' } },
