@@ -0,0 +1,57 @@
+'use strict';
+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const {collectEvidence} = require('../chat-evidence');
+
+const profiles = [
+  {id:7001, name:'K. Mbappé', firstname:'Kylian', lastname:'Mbappé Lottin'},
+  {id:7002, name:'R. Lewandowski', firstname:'Robert', lastname:'Lewandowski'}
+];
+function provider() {
+  const calls = [];
+  return {calls, async load(path) {
+    calls.push(path);
+    const u = new URL(path, 'https://synthetic.invalid');
+    const id = Number(u.searchParams.get('player') || u.searchParams.get('id'));
+    const player = profiles.find(p => p.id === id);
+    let data = [];
+    if (u.pathname === '/players/profiles') data = [{player}];
+    if (u.pathname === '/players/teams') data = [{team:{id:90001, name:'Synthetic club'}, seasons:[2025]}];
+    if (u.pathname === '/players') data = [{player, statistics:[{team:{id:90001, name:'Synthetic club'}, league:{id:140, name:'La Liga', season:2025}, goals:{total:0, assists:2}}]}];
+    return {data, fetchedAt:1};
+  }};
+}
+for (const [previous, question] of [
+  ['Compare Mbappe and Lewandowski in La Liga season 2025/26', 'Analyze an upcoming match'],
+  ['قارن مبابي وليفاندوفسكي في الدوري الإسباني موسم ٢٠٢٥/٢٦', 'حلل مباراة قادمة']
+]) test('new upcoming match does not reuse restored player comparison: ' + question, async () => {
+  const saved = {playerIds:[7001,7002]};
+  const restored = JSON.parse(JSON.stringify(saved));
+  const p = provider();
+  const e = await collectEvidence(p, question, restored, [{role:'user', content:previous}]);
+  assert.deepEqual(p.calls, []);
+  assert.equal(e.playerProfiles, undefined);
+  assert.deepEqual(e.followUpContext, {});
+  assert.ok(e.missing.some(message => /specify a match/i.test(message)));
+  assert.deepEqual(restored, saved);
+});
+
+test('ordinary player follow-up still binds its restored identity and zero totals', async () => {
+  const p = provider();
+  const e = await collectEvidence(p, 'Show his assists in La Liga season 2025/26',
+    {playerIds:[7001]}, [{role:'user', content:'Analyze Mbappe in La Liga season 2025/26'}]);
+  assert.deepEqual(e.followUpContext, {playerIds:[7001]});
+  assert.equal(e.playerProfiles[0].statistics[0].statistics[0].scoring.goals, 0);
+  assert.equal(e.playerProfiles[0].statistics[0].statistics[0].scoring.assists, 2);
+  assert.equal(p.calls.length, 3);
+});
+
+test('upcoming season wording alone does not erase the player identity', async () => {
+  for (const question of ['Show his assists in upcoming season 2025/26', 'اذكر تمريراته الحاسمة في الموسم القادم ٢٠٢٥/٢٦']) {
+    const p = provider();
+    const e = await collectEvidence(p, question, {playerIds:[7001]},
+      [{role:'user', content:'Analyze Mbappe in La Liga season 2025/26'}]);
+    assert.deepEqual(e.followUpContext, {playerIds:[7001]});
+    assert.equal(e.playerProfiles[0].statistics[0].statistics[0].scoring.assists, 2);
+  }
+});
