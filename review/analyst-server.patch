+   for(const rows of [[fixture(7),duplicate],[duplicate,fixture(7)]]) {
+    const before=structuredClone(rows);const {e,calls}=await collect(question,rows);
+    assert.deepEqual(e.clubs[0].matches,[]);assert.deepEqual(e.clubs[0].recentResultsNewestFirst,[]);
