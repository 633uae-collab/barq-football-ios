+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { createApp } = require('../app');
+const row = shots => ({team:{id:9001},league:{id:901,season:2025},shots});
+async function request(t, statistics, automatic=false) {
+  const before=structuredClone(statistics),calls=[];
+  const server=createApp({provider:{get:async path=>{
+    calls.push(path);
+    return {data:path.startsWith('/players/seasons?')?[2025]:[{player:{id:7001,name:'Synthetic player'},statistics}],stale:false};
+  }}}).listen(0,'127.0.0.1');
+  await new Promise(r=>server.once('listening',r));
+  t.after(()=>new Promise(r=>server.close(r)));
+  const res=await fetch(`http://127.0.0.1:${server.address().port}/api/player/7001${automatic?'':'?season=2025'}`);
+  const body=await res.json();assert.deepEqual(statistics,before);
+  assert.equal(calls.length,automatic?2:1);
+  return {status:res.status,body};
+}
+for(const automatic of [false,true])test(`player detail rejects on-target shots exceeding total, automatic=${automatic}`,async t=>{
