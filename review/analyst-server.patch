+  for(const [,set,get] of locations) {
+    for(const value of [{home:0,away:0},{home:null,away:2},{home:0},{home:123,away:45},null]) {
+      const f=fixture();set(f,value);
+      assert.deepEqual(get(prepareEvidence(f,1000)),value===null?null:{home:value.home??null,away:value.away??null});
+    }
+  }
+  const f=fixture();f.fixture.status.short='1H';
+  const e=prepareEvidence(f,1000);
+  assert.deepEqual(e.currentScore,{home:2,away:0});
+  assert.deepEqual(e.completedPeriodScores,{halftime:null,fulltime:null});
+});
