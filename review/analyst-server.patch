@@ -0,0 +1,63 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const { Provider } = require('../provider');
+
+// Local fault injection through real fetch/HTTP streams; no external provider traffic.
+async function upstream(t, status, contentType = 'application/json', timeout = 1500) {
+  let closed;
+  const responseClosed = new Promise(resolve => { closed = resolve; });
+  const server = http.createServer((_req, res) => {
+    res.writeHead(status, { 'content-type': contentType });
+    res.write('synthetic unfinished response');
+    res.once('close', closed);
+  });
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  t.after(() => { server.closeAllConnections(); return new Promise(resolve => server.close(resolve)); });
+  let calls = 0, signal;
+  const p = new Provider({ key: 'synthetic-key', timeout, fetchImpl: (_url, opts) => {
+    calls++; signal = opts.signal;
+    return fetch(`http://127.0.0.1:${server.address().port}`, { signal });
+  } });
+  return { p, responseClosed, calls: () => calls, signal: () => signal };
+}
+for (const [status, type, code] of [
+  [503, 'application/json', 'UPSTREAM_UNAVAILABLE'],
+  [429, 'application/json', 'PLAN_LIMIT'],
+  [401, 'application/json', 'API_AUTH_FAILED'],
+  [403, 'application/json', 'API_AUTH_FAILED'],
+  [200, 'text/html', 'UPSTREAM_INVALID_JSON']
+]) test(`rejected HTTP ${status}/${type} aborts its unfinished body before releasing the provider slot`, async t => {
+  const f = await upstream(t, status, type);
+  await assert.rejects(f.p.get('/fixtures'), { code });
+  assert.equal(f.signal().aborted, true, 'Discarded response must not outlive its cleared timeout');
+  let timer;
+  try {
+    await Promise.race([f.responseClosed, new Promise((_, reject) => {
+      timer = setTimeout(() => reject(new Error('Local upstream connection remained open')), 1000);
+    })]);
+  } finally { clearTimeout(timer); }
+  assert.equal(f.calls(), 1, 'No retry');
+  assert.equal(f.p.active, 0);
+  assert.equal(f.p.pending.size, 0);
+  assert.equal(f.p.cache.size, 0);
+});
+
+test('body timeout closes the real stream, releases the slot and permits a later successful request', async t => {
+  const f = await upstream(t, 200, 'application/json', 100);
+  await assert.rejects(f.p.get('/fixtures'), { code: 'UPSTREAM_TIMEOUT', status: 504 });
+  let timer;
+  try {
+    await Promise.race([f.responseClosed, new Promise((_, reject) => {
+      timer = setTimeout(() => reject(new Error('Timed-out stream remained open')), 1000);
+    })]);
+  } finally { clearTimeout(timer); }
+  assert.equal(f.calls(), 1);
+  assert.equal(f.p.active, 0);
+  assert.equal(f.p.pending.size, 0);
+  assert.equal(f.p.cache.size, 0);
+  f.p.fetch = async () => new Response(JSON.stringify({ response: [{ value: 0 }] }),
+    { headers: { 'content-type': 'application/json' } });
+  assert.deepEqual((await f.p.get('/fixtures')).data, [{ value: 0 }]);
+  assert.equal(f.p.active, 0);
+});
