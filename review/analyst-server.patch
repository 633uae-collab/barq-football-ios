+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { HistoricalKnowledge } = require('../knowledge');
+const { collectEvidence } = require('../chat-evidence');
+
+for (const question of ['Show the latest result for FC Barcelona B', 'Show the latest result for Barça Atlètic',
+  'ما نتيجة آخر مباراة لبرشلونة الرديف؟', 'ما نتيجة آخر مباراة لرديف برشلونة؟']) {
+  test('reserve match cannot use the senior team or its restored context: ' + question, async () => {
+    const calls = [];
+    const provider = { async load(path) { calls.push(path); return { data: [], fetchedAt: 1 }; } };
+    const result = await collectEvidence(provider, question, { teamIds: [529], fixtureId: 100 });
+    assert.deepEqual(calls, []);
+    assert.deepEqual(result.sources, []);
+    assert.deepEqual(result.followUpContext, {});
+    assert.ok(result.missing.length);
+  });
+}
+
+test('reserve foundation cannot inherit a cached senior date in either language', async () => {
+  let calls = 0;
+  const knowledge = new HistoricalKnowledge({ fetchImpl: async () => {
+    calls++;
+    const value = { time: '+1901-02-03T00:00:00Z', precision: 11,
+      calendarmodel: 'http://www.wikidata.org/entity/Q1985727' };
+    const entity = { id: 'Q7156', labels: { en: { value: 'FC Barcelona' } },
+      claims: { P571: [{ rank: 'normal', mainsnak: { snaktype: 'value', datavalue: { value } } }] } };
+    return Response.json({ entities: { Q7156: entity } });
+  } });
+  const senior = await knowledge.collect('When was FC Barcelona founded?');
+  assert.equal(senior.facts[0].value, '1901-02-03');
+  for (const name of ['Barcelona B', 'Barça Atlètic', 'رديف برشلونة', 'برشلونة الرديف']) {
+    const question = /[ء-ي]/u.test(name) ? 'متى تأسس ' + name + '؟' : 'When was ' + name + ' founded?';
+    const result = await knowledge.collect(question, senior.followUpContext);
+    assert.deepEqual(result.facts, []);
+    assert.deepEqual(result.sources, []);
+    assert.deepEqual(result.followUpContext, {});
+  }
+  assert.equal((await knowledge.collect('FC Barcelona basic history')).facts[0].value, '1901-02-03');
+  assert.equal(calls, 1);
+});
