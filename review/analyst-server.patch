@@ -0,0 +1,90 @@
+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { collectEvidence } = require('../chat-evidence');
+
+const fixture = (id, home, away) => ({
+  fixture: { id, date: '2026-11-01T12:00:00Z', status: { short: 'FT' } },
+  league: { id: 140, name: 'La Liga', season: 2026 },
+  teams: { home: { id: home, name: home === 529 ? 'Barcelona' : 'Real Madrid' }, away: { id: away, name: away === 529 ? 'Barcelona' : 'Other club' } },
+  goals: { home: 0, away: 0 }
+});
+const season = team => ({ team: { id: team, name: team === 529 ? 'Barcelona' : 'Real Madrid' }, league: { id: 140, season: 2026 } });
+
+test('Arabic and English club requests withhold unrelated fixtures before selecting match or season', async () => {
+  for (const question of ['حلل آخر مباراة لبرشلونة', 'Analyze Barcelona last match']) {
+    const calls = [], good = fixture(7, 529, 541), wrong = fixture(8, 40, 50);
+    const e = await collectEvidence({ load: async path => {
+      calls.push(path);
+      const p = new URLSearchParams(path.split('?')[1]);
+      const data = path.startsWith('/teams/statistics') ? season(529) : p.has('id') ? [wrong, good] : [wrong, good];
+      return { fetchedAt: 1, data };
+    } }, question);
+    assert.deepEqual(e.clubs[0].matches.map(f => f.id), [7]);
+    assert.deepEqual(e.clubs[0].recentResultsNewestFirst.map(f => [f.fixtureId, f.result]), [[7, 'D']]);
+    assert.equal(e.fixtureId, 7);
+    assert.deepEqual(e.currentScore, { home: 0, away: 0 });
+    assert.ok(!calls.includes('/fixtures?id=8'));
+    assert.ok(e.missing.some(s => /identity|unrelated/i.test(s)));
+  }
+});
+
+test('an unrelated upcoming fixture cannot create an opponent or a follow-up match', async () => {
+  const calls = [];
+  const e = await collectEvidence({ load: async path => {
+    calls.push(path);
+    return { fetchedAt: 1, data: path.startsWith('/teams/statistics') ? season(529) : [fixture(8, 40, 50)] };
+  } }, 'Analyze Barcelona upcoming match');
+  assert.equal(e.clubs.length, 1);
+  assert.deepEqual(e.clubs[0].matches, []);
+  assert.deepEqual(e.clubs[0].recentMatches, []);
+  assert.deepEqual(e.clubs[0].recentResultsNewestFirst, []);
+  assert.equal(e.fixtureId, undefined);
+  assert.ok(!calls.some(p => /[?&](?:id|team)=(?:8|40|50)(?:&|$)/.test(p)));
+  assert.ok(!calls.some(p => p.startsWith('/teams/statistics')));
+});
+
+test('upcoming club and opponent recent fixtures are independently bound to each requested team', async () => {
+  const next = fixture(7, 529, 541), unrelated = fixture(8, 40, 50);
+  next.fixture.status.short = 'NS';
+  next.goals = { home: null, away: null };
+  const e = await collectEvidence({ load: async path => {
+    const p = new URLSearchParams(path.split('?')[1]);
+    const team = Number(p.get('team'));
+    const data = path.startsWith('/teams/statistics') ? season(team)
+      : p.has('next') || p.has('id') ? [next]
+      : [unrelated, fixture(team === 529 ? 9 : 10, team, 99)];
+    return { fetchedAt: 1, data };
+  } }, 'Analyze Barcelona upcoming match');
+  assert.deepEqual(e.clubs[0].recentMatches.map(f => f.id), [9]);
+  assert.deepEqual(e.clubs[1].matches.map(f => f.id), [10]);
+  assert.deepEqual(e.clubs[1].recentResultsNewestFirst.map(f => [f.fixtureId, f.result]), [[10, 'D']]);
+});
+
+test('a matching fixture ID cannot relabel unrelated detail teams as the requested club', async () => {
+  const e = await collectEvidence({ load: async path => {
+    const p = new URLSearchParams(path.split('?')[1]);
+    return { fetchedAt: 1, data: path.startsWith('/teams/statistics') ? season(529)
+      : p.has('id') ? [fixture(7, 40, 50)] : [fixture(7, 529, 541)] };
+  } }, 'Analyze Barcelona last match');
+  assert.equal(e.fixtureId, undefined);
+  assert.equal(e.currentScore, undefined);
+  assert.ok(e.missing.some(s => /identity.*not.*verified/i.test(s)));
+});
+
+
+for (const question of ['Analyze Barcelona completed match', 'حلل مباراة منتهية لبرشلونة']) {
+  test('club fixture detail preserves the selected opponent and venue: ' + question, async () => {
+    const selected = fixture(7, 529, 541);
+    for (const detail of [fixture(7, 541, 529), fixture(7, 529, 50), structuredClone(selected)]) {
+      detail.goals = { home: 2, away: 0 };
+      const evidence = await collectEvidence({ load: async path => ({
+        fetchedAt: 1, data: [path === '/fixtures?id=7' ? detail : selected]
+      }) }, question);
+      const sameParticipants = detail.teams.home.id === 529 && detail.teams.away.id === 541;
+      assert.deepEqual(evidence.currentScore, sameParticipants ? detail.goals : undefined);
+      assert.equal(evidence.fixtureId, sameParticipants ? 7 : undefined);
+      assert.deepEqual(evidence.clubs[0].matches[0].goals, selected.goals);
+    }
+  });
+}
