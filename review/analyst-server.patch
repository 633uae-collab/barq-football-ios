+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { collectEvidence } = require('../chat-evidence');
+
+const user = content => ({ role: 'user', content });
+const assistant = content => ({ role: 'assistant', content });
+function fixture(status) {
+  return { fixture: { id: 72, status: { short: status } },
+    teams: { home: { id: 529, name: 'Barcelona' }, away: { id: 541, name: 'Real Madrid' } },
+    goals: { home: 0, away: 2 } };
+}
+for (const [last, more] of [
+  ['What was the score of their last match?', 'Who scored in the same match?'],
+  ['كم كانت نتيجة مباراتهم السابقة؟', 'من سجّل في نفس المباراة؟']
+]) {
+  test('same-match questions retain the finished status requirement: ' + more, async () => {
+    let status = 'FT';
+    const calls = [];
+    const provider = { async load(path) {
+      calls.push(path);
+      return { data: [fixture(status)], fetchedAt: 1000 };
+    } };
+    const first = await collectEvidence(provider, last, { teamIds: [529] });
+    assert.equal(first.fixtureId, 72);
+    const restored = JSON.parse(JSON.stringify(first.followUpContext));
+    for (const history of [[user(last)], [user(last), assistant('Synthetic response'), user(more)]]) {
+      for (status of ['2H', 'NS', 'FT', 'AET', 'PEN']) {
+        calls.length = 0;
+        const e = await collectEvidence(provider, more, restored, history);
+        assert.deepEqual(calls, ['/fixtures?id=72']);
+        if (['FT', 'AET', 'PEN'].includes(status)) {
+          assert.deepEqual(e.currentScore, { home: 0, away: 2 });
+        } else {
+          assert.equal(e.currentScore, undefined);
+          assert.ok(e.missing.some(reason => /not verified as completed/.test(reason)));
+        }
+      }
+    }
+  });
+}
+test('an intervening live request or an assistant claim cannot establish a completed match', async () => {
+  const provider = { async load() { return { data: [fixture('2H')], fetchedAt: 1000 }; } };
+  for (const history of [[user('What was the score of their last match?'), user('Analyze a live match')],
+    [assistant('What was the score of their last match?')]]) {
+    const e = await collectEvidence(provider, 'Who scored in the same match?', { fixtureId: 72 }, history);
+    assert.deepEqual(e.currentScore, { home: 0, away: 2 });
+  }
+});
