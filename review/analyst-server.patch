--- /dev/null
+++ b/server/test/team-squad-binding.test.js
@@ -0,0 +1,38 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { createApp } = require('../app');
+
+const row = (id, player = 9001) => ({ team: { id, name: 'Synthetic club' }, players: [{ id: player, name: 'Synthetic player', position: 'Attacker', number: 0 }] });
+async function request(t, data) {
+  const original = structuredClone(data);
+  const provider = { get: async path => ({ data: path.startsWith('/teams?') ? [{ team: { id: 7001, name: 'Synthetic club' } }] : path.startsWith('/players/squads?') ? data : [], stale: path.startsWith('/players/squads?') }) };
+  const server = createApp({ provider }).listen(0, '127.0.0.1');
+  await new Promise(resolve => server.once('listening', resolve));
+  t.after(() => new Promise(resolve => server.close(resolve)));
+  const res = await fetch(`http://127.0.0.1:${server.address().port}/api/team/7001`), body = await res.json();
+  assert.deepEqual(data, original, 'Provider input must not change');
+  return { status: res.status, body };
+}
+
+test('team squad rejects foreign, missing and malformed team identity', async t => {
+  for (const data of [[row(7002)], [row('7001')], [{ players: row(7001).players }], [null], {}, null]) {
+    const r = await request(t, data);
+    assert.equal(r.status, 502); assert.equal(r.body.error, 'UPSTREAM_INVALID_RESPONSE');
+    assert.equal(r.body.squad, undefined);
+  }
+});
+test('team squad rejects repeated team records without choosing first in either order', async t => {
+  for (const data of [[row(7001), row(7001)], [row(7001), row(7002, 9002)], [row(7002, 9002), row(7001)]]) {
+    const r = await request(t, data);
+    assert.equal(r.status, 502); assert.equal(r.body.error, 'UPSTREAM_INVALID_RESPONSE');
+    assert.equal(r.body.squad, undefined);
+  }
+});
+test('team squad preserves matching roster, zero, stale attribution and empty results', async t => {
+  const r = await request(t, [row(7001)]);
+  assert.equal(r.status, 200); assert.equal(r.body.team.id, 7001);
+  assert.deepEqual(r.body.squad, [{ ...row(7001).players[0], pos: 'Attacker' }]);
+  assert.equal(r.body.stale, true);
+  const empty = await request(t, []);
+  assert.equal(empty.status, 200); assert.deepEqual(empty.body.squad, []);
+});
