+const user=content=>({role:'user',content});
+function provider(profile=profiles[0]) {
+ const calls=[];
+ return {calls,load:async path=>{
+  calls.push(path);const u=new URL(path,'https://synthetic.invalid'),year=Number(u.searchParams.get('season'));
+  let data=[];
+  if(u.pathname==='/players/profiles')data=[{player:profile}];
+  if(u.pathname==='/players/teams')data=[{team:{id:50,name:'Synthetic Club'},seasons:[2024,2025]}];
+  if(u.pathname==='/players')data=[{player:profile,statistics:[{team:{id:50,name:'Synthetic Club'},league:{id:39,name:'Premier League',season:year},goals:{total:year===2024?0:7,assists:1}}]}];
+  return {data,fetchedAt:1,paging:{current:1,total:1}};
+ }};
+}
+for(const [first,second,third,profile] of [
+ ['Analyze Haaland Premier League season 2024/25','How many goals?','How many assists?',profiles[0]],
+ ['حلل هالاند الدوري الإنجليزي موسم ٢٠٢٤/٢٥','كم هدف سجل؟','وكم صنع؟',profiles[0]],
+ ['Analyze Mbappe Premier League season 2024/25','How many goals?','How many assists?',profiles[1]],
+ ['حلل ليفاندوفسكي الدوري الإنجليزي موسم ٢٠٢٤/٢٥','كم هدف سجل؟','وكم صنع؟',profiles[2]]
+])test('retains player season and competition across neutral follow-ups: '+first,async()=>{
+ const p=provider(profile);let context={},history=[];
+ for(const q of [first,second,third]){
+  const before=structuredClone({context,history});
+  const e=await collectEvidence(p,q,context,history);
+  assert.deepEqual({context,history},before);
+  assert.equal(e.playerProfiles[0].season,2024);
+  const s=e.playerProfiles[0].statistics[0].statistics[0];
+  assert.equal(s.season,2024);assert.equal(s.leagueId,39);assert.equal(s.scoring.goals,0);
+  context=JSON.parse(JSON.stringify(e.followUpContext));
+  history.push(user(q),{role:'assistant',content:'Synthetic reply, not scope authority: season 2025/26'});
+ }
+ assert.deepEqual(p.calls.filter(x=>x.startsWith('/players?')),Array(3).fill(`/players?id=${profile.id}&season=2024&league=39`));
+});
+test('unresolved or interrupted count-follow-up scope never falls back to latest season',async()=>{
+ const anchor=user('Analyze Haaland Premier League season 2024/25');
+ for(const history of [[],[{role:'assistant',content:anchor.content}],
+  [anchor,user('Show transfer news'),user('How many goals?')],
+  [anchor,user('What about La Liga?'),user('How many goals?')],
+  [anchor,user('What about season 2025/26?'),user('How many goals?')],
+  [user('Analyze Haaland Premier League season 2024/25 and 2025/26'),user('How many goals?')],
+  [user('Analyze Haaland and Mbappe Premier League season 2024/25'),user('How many goals?')],
+  [anchor,...Array.from({length:8},()=>user('How many goals?'))]
+ ]) {
+  const p=provider();const e=await collectEvidence(p,'How many assists?',{playerIds:[1100]},history);
+  assert.deepEqual(e.playerProfiles,[]);assert.equal(p.calls.length,0);
+  assert.ok(e.missing.some(x=>x.includes('current statistics were not substituted')));
+ }
+});
+test('season anchor must match the freshly retrieved player, not just a retained ID',async()=>{
+ for(const [anchor,profile] of [
+  ['Analyze Haaland Premier League season 2024/25',profiles[1]],
+  ['Analyze Mbappe Premier League season 2024/25',profiles[2]],
+  ['Analyze Lewandowski Premier League season 2024/25',profiles[1]],
+  ['Analyze Haaland Premier League season 2024/25',{id:1100,name:'Unrelated Player'}]
+ ]) {
+  const p=provider(profile);const e=await collectEvidence(p,'How many assists?',{playerIds:[profile.id]},[user(anchor),user('How many goals?')]);
+  assert.deepEqual(e.playerProfiles,[]);assert.deepEqual(e.followUpContext,{});
+  assert.deepEqual(p.calls,[`/players/profiles?player=${profile.id}`]);
+ }
+});
+test('the latest explicit named scope replaces an older season without changing inputs',async()=>{
