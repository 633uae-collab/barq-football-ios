@@ -0,0 +1,30 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { GroqAnalyst } = require('../groq');
+
+function club(id, leagueId, year, goalsFor) {
+  const team = { id, name: 'Synthetic club ' + id };
+  return { teamId: id, team, season: { team, verified: true, leagueId,
+    league: 'Synthetic league ' + leagueId, year, totals: { goalsFor } } };
+}
+
+for (const [q, notice, goals] of [
+  ['Compare the two clubs this season', /different competitions or seasons/i, 'Goals for'],
+  ['قارن الناديين هذا الموسم', /بطولات أو مواسم مختلفة/, 'له']
+]) {
+  test('warn when verified totals come from different scopes: ' + q, async () => {
+    const analyst = new GroqAnalyst({ fetchImpl() { throw Error('Unexpected model request'); } });
+    for (const [league, year] of [[902, 2025], [901, 2024], [901, 2025]]) {
+      const clubs = [club(9101, 901, 2025, 0), club(9102, league, year, 7)];
+      const reply = await analyst.answer(q, { seasonOnlyComparison: true, clubs });
+      assert.equal(notice.test(reply.answer), league !== 901 || year !== 2025);
+      assert.ok(reply.answer.includes(goals + ': 0'));
+      assert.ok(reply.answer.includes(goals + ': 7'));
+      clubs[1].season.verified = false;
+      const partial = await analyst.answer(q, { seasonOnlyComparison: true, clubs });
+      assert.doesNotMatch(partial.answer, notice);
+      assert.ok(!partial.answer.includes(goals + ': 7'));
+    }
+  });
+}
