+'use strict';
+// Names select a search, never a guessed provider ID, club or season.
+const descriptors = [
+  { search: 'Mbappe', mention: /(?<!\p{L})mbapp[eé](?!\p{L})|مبابي|مبابى/iu, first: 'kylian', last: /^mbappe(?: lottin)?$/ },
+  { search: 'Lewandowski', mention: /\blewandowski\b|ليفاندوفسكي|ليفاندوسكي|لواندوفسكي/i, first: 'robert', last: /^lewandowski$/ }
+];
+const normalize = value => typeof value === 'string'
+  ? value.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim().replace(/\s+/g, ' ') : '';
+const namedPlayerSearches = question => descriptors.filter(d => d.mention.test(question));
+function matchesSearchIdentity(player, descriptor) {
+  return !!normalize(player?.name) && normalize(player?.firstname) === descriptor.first
+    && descriptor.last.test(normalize(player?.lastname));
+}
+function resolveProfile(result, descriptor) {
+  // No pagination sweep: incomplete searches are explicitly unresolved.
+  if (result.paging?.current !== 1 || result.paging?.total !== 1 || !Array.isArray(result.data)) return undefined;
+  const matches = result.data.map(r => r?.player).filter(p => Number.isSafeInteger(p?.id) && p.id > 0
+    && matchesSearchIdentity(p, descriptor));
+  const ids = new Set(matches.map(p => p.id));
+  if (ids.size !== 1) return undefined;
+  const candidate = matches[0];
+  // Duplicate IDs with conflicting names are not trusted either.
+  if (result.data.some(r => r?.player?.id === candidate.id && (!matches.includes(r.player)
+    || normalize(r.player.name) !== normalize(candidate.name)))) return undefined;
+  return candidate;
+}
+// The fixed Haaland ID still needs a compatible profile on each named lookup.
+function matchesHaalandProfile(player) {
+  const surname = /^(?:braut )?(?:haaland|haland)$/;
+  return /^(?:(?:e\.?|erling(?: braut)?) )?(?:haaland|haland)$/.test(normalize(player?.name))
+    && (player.firstname == null || /^(?:erling|erling braut)$/.test(normalize(player.firstname)))
+    && (player.lastname == null || surname.test(normalize(player.lastname)));
+}
+function matchesResolvedName(player, profile) {
+  if (!player || player.id !== profile.id || !normalize(player.name)) return false;
+  if (player.firstname && normalize(player.firstname) !== normalize(profile.firstname)) return false;
+  if (player.lastname && normalize(player.lastname) !== normalize(profile.lastname)) return false;
+  return normalize(player.name) === normalize(profile.name)
+    || normalize(player.name) === normalize(`${profile.firstname} ${profile.lastname}`);
+}
+module.exports = { matchesSearchIdentity, namedPlayerSearches, resolveProfile, matchesResolvedName, matchesHaalandProfile };
