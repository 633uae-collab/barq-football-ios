+ const e=await collectEvidence({load:async path=>{requests.push(path);return{fetchedAt:1,data:data[path.split('?')[0]]||[]};}},q);
+ assert.deepEqual(fixtures,before);return{e,requests};
+}
+for(const q of ['Analyze Haaland over the last five matches','حلل هالاند في آخر خمس مباريات'])test('duplicate appearance fixtures cannot overwrite match evidence: '+q,async()=>{
