@@ -0,0 +1,49 @@
+'use strict';
+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const {collectEvidence} = require('../chat-evidence');
+
+const questions = [
+  'Analyze Haaland over the last five matches in the Premier League season 2025/26',
+  'حلل هالاند في آخر خمس مباريات في الدوري الإنجليزي موسم ٢٠٢٥/٢٦'
+];
+async function collect(question, seasonTeamIds) {
+  const requests = [];
+  const provider = {load: async path => {
+    const {pathname, searchParams} = new URL(path, 'https://synthetic.invalid');
+    requests.push({pathname, params: Object.fromEntries(searchParams)});
+    const team = Number(searchParams.get('team'));
+    const player = {id: 1100, name: 'Haaland'};
+    let data = [];
+    if (pathname === '/players/profiles') data = [{player}];
+    if (pathname === '/players/teams') data = [
+      {team: {id: 90}, seasons: [2026]},
+      ...seasonTeamIds.map(id => ({team: {id}, seasons: [2025]}))
+    ];
+    if (pathname === '/players/squads') data = [{team: {id: 90}}];
+    if (pathname === '/fixtures' && seasonTeamIds.includes(team)) data = [{
+      fixture: {id: 90000 + team, date: team === 50 ? '2025-09-01' : '2026-01-12', status: {short: 'FT'}},
+      teams: {home: {id: team}, away: {id: 75}}, league: {id: 39, season: 2025}, goals: {home: 0, away: 0}
+    }];
+    if (pathname === '/fixtures/players') data = [{team: {id: team}, players: [
+      {player, statistics: [{games: {minutes: 63}, goals: {total: 0}}]}
+    ]}];
+    return {data, fetchedAt: 1};
+  }};
+  return {evidence: await collectEvidence(provider, question), requests};
+}
+for (const question of questions) test('appearance search follows both season clubs after a transfer: ' + question, async () => {
+  const {evidence, requests} = await collect(question, [50, 51, 50]);
+  const rows = evidence.playerProfiles[0].lastFiveAppearances;
+  assert.deepEqual(rows?.map(row => row.match.id), [90051, 90050]);
+  assert.deepEqual(rows.map(row => row.player.statistics[0].scoring.goals), [0, 0]);
+  assert.deepEqual(requests.filter(r => r.pathname === '/fixtures').map(r => r.params),
+    ['50', '51'].map(team => ({team, last: '10', league: '39', season: '2025'})));
+  assert.ok(requests.every(r => r.pathname !== '/players/squads'));
+});
+test('no arbitrary subset of season clubs is reported as the latest appearances', async () => {
+  const {evidence, requests} = await collect(questions[0], [52, 50, 51]);
+  assert.deepEqual(evidence.playerProfiles[0].lastFiveAppearances, []);
+  assert.ok(evidence.missing.some(s => /more than two teams/i.test(s)));
+  assert.ok(requests.every(r => !r.pathname.startsWith('/fixtures') && r.pathname !== '/players/squads'));
+});
