+    for (const [key, arabic, english] of fields) {
+      const value = s.totals[key];
+      blocks.push(`${ar ? arabic : english}: ${Number.isSafeInteger(value) && value >= 0 ? value : unknown}`);
+    }
+    if (s.coverage === 'updated') blocks.push(ar
+      ? 'تشمل الأرقام آخر مباراة منتهية بعد مطابقة حصيلة كل المباريات السابقة بإحصاءات الموسم.'
+      : 'Totals include the latest final score. All earlier results match the season aggregate.');
+    if (s.coverage === 'unconfirmed') blocks.push(ar
+      ? 'هذه حصيلة المزوّد؛ تعذّر تأكيد أنها تشمل كل المباريات المنتهية.'
+      : 'Provider snapshot; coverage of all completed matches could not be confirmed.');
+    blocks.push('');
+  }
+  const asksMoreGoals = /who scored more|which (?:team|club) scored more|من سج[ّ]?ل أهداف[ًا]* أكثر|من سج[ّ]?ل أكثر/iu.test(question);
+  if (asksMoreGoals && verifiedRows.length === 2 && displayedScopes.size === 1) {
+    const [a, b] = verifiedRows;
+    const first = a.season.totals.goalsFor, second = b.season.totals.goalsFor;
+    if (count(first) && count(second)) {
+      if (first === second) blocks.unshift(ar ? 'الفريقان متساويان في الأهداف المسجّلة.' : 'The teams are level on goals scored.');
+      else {
+        const name = cell((first > second ? a : b).team.name);
+        blocks.unshift(ar ? `${name} سجّل أهدافاً أكثر.` : `${name} scored more goals.`);
+      }
+    }
+  }
+  if (displayedScopes.size > 1) {
+    blocks.splice(1, 0, ar
+      ? 'الأرقام المعروضة تخص بطولات أو مواسم مختلفة. راجع البطولة والموسم لكل فريق عند المقارنة.'
+      : 'These totals cover different competitions or seasons. Check each team’s competition and season when comparing them.');
+  }
+  blocks.push(ar ? 'المصدر: API-Football. نطاق البطولة والموسم مذكور لكل فريق؛ الصفر قيمة متحققة وليس بيانات مفقودة.' : 'Source: API-Football. Competition and season are specified per team; zero is a value, not missing data.');
+  if (/(?:تاريخ|وقت)\s+(?:البيانات|التحديث|الجلب)|\b(?:data date|as of|retriev(?:al|ed)|last updated)\b/i.test(question)
+      && Number.isFinite(evidence.fetchedAt) && Number.isFinite(new Date(evidence.fetchedAt).getTime())) {
+    const retrieved = new Date(evidence.fetchedAt).toISOString();
+    blocks.push(ar ? `وقت جلب البيانات: ${retrieved}. تاريخ آخر تحديث لدى المزوّد غير متاح في إحصاءات الموسم.`
+      : `Retrieved at ${retrieved}. The season statistics do not provide a provider update time.`);
+  }
+  return blocks.join('\n');
+}
+module.exports = { seasonAnswer };
+
+
