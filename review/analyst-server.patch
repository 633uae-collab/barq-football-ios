+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { collectEvidence } = require('../chat-evidence');
+
+async function ask(question, names) {
+  const player = { id: 1100, ...names };
+  const calls = [];
+  const data = {
+    '/players/profiles': [{ player }],
+    '/players/teams': [{ team: { id: 9001 }, seasons: [2025] }],
+    '/players': [{ player, statistics: [{ team: { id: 9001, name: 'Synthetic club' },
+      league: { id: 39, name: 'Synthetic League', season: 2025 }, goals: { total: 0 } }] }]
+  };
+  const evidence = await collectEvidence({ async load(path) {
+    const route = path.split('?')[0];
+    calls.push(route);
+    return { fetchedAt: 1000, data: data[route] ?? [] };
+  } }, question);
+  return { evidence, calls };
+}
+
+for (const question of ['Haaland statistics in season 2025/26', 'إحصاءات هالاند موسم ٢٠٢٥/٢٦']) {
