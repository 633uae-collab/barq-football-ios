+  }
+});
+
+for (const question of ['Analyze Haaland over the last five matches', 'حلل هالاند في آخر خمس مباريات']) {
+  test('scheduled fixtures cannot displace actual player appearances: ' + question, async () => {
+    const fixtures = ['NS', 'TBD', 'FT', 'FT', 'FT', 'FT', 'FT'].map((status, index) => {
+      const row = fixture();
+      row.fixture.id += index;
+      row.fixture.status.short = status;
+      row.fixture.date = new Date(Date.UTC(2025, 9, 25 - index)).toISOString();
+      return row;
+    });
+    const {e, requests} = await collect(question, {'/fixtures': fixtures});
+    const player = e.playerProfiles[0];
+    const played = fixtures.slice(2).map(row => row.fixture.id);
+    assert.deepEqual(player.appearanceTimeline.map(row => row.fixtureId), played);
+    assert.deepEqual(player.lastFiveAppearances.map(row => row.match.id), played);
+    assert.deepEqual(player.lastFiveTeamMatches.map(row => row.match.id), played);
