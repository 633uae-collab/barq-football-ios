+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { createApp } = require('../app');
+
+const stat = (league = 140, season = 2025) => ({ league: { id: league, season }, team: { id: 9001 }, goals: { total: 0, assists: 0 }, games: { appearences: 0 } });
+const row = (statistics = [stat()], id = 7001) => ({ player: { id, name: 'Synthetic player' }, statistics });
+async function request(t, kind, data, explicit = true) {
+  const original = structuredClone(data), calls = [];
+  const provider = { get: async path => {
+    calls.push(path);
+    return { data: path.startsWith('/leagues?') ? [{ league: { id: 140 }, seasons: [{ year: 2025, current: true }] }] : data, stale: true };
+  } };
+  const server = createApp({ provider }).listen(0, '127.0.0.1');
+  await new Promise(resolve => server.once('listening', resolve));
+  t.after(() => new Promise(resolve => server.close(resolve)));
+  const res = await fetch(`http://127.0.0.1:${server.address().port}/api/${kind}/140${explicit ? '?season=2025' : ''}`);
+  const body = await res.json();
+  assert.deepEqual(data, original, 'Provider input must not change');
+  assert.equal(new URL(calls.at(-1), 'https://synthetic.invalid').searchParams.get('season'), '2025');
+  return { status: res.status, body };
+}
+for (const kind of ['topscorers', 'topassists']) {
+  test(`${kind} rejects statistics outside the requested league and season`, async t => {
+    for (const s of [stat(39), stat(140, 2024), stat('140'), stat(140, '2025'), stat(null), stat(140, null)]) {
+      const r = await request(t, kind, [row([s])]);
+      assert.equal(r.status, 502); assert.deepEqual(r.body, { error: 'UPSTREAM_INVALID_RESPONSE' });
+    }
+    const r = await request(t, kind, [row([stat(140, 2024)])], false);
+    assert.equal(r.status, 502); assert.deepEqual(r.body, { error: 'UPSTREAM_INVALID_RESPONSE' });
+  });
+  test(`${kind} withholds malformed or ambiguous statistics instead of choosing the first`, async t => {
+    for (const data of [[row([stat(), stat()])], [row([stat(), stat(39)])], [row([stat(39), stat()])], [row([])], [row(null)], [row({})], [row([null])], [null], {}, null]) {
+      const r = await request(t, kind, data);
+      assert.equal(r.status, 502); assert.deepEqual(r.body, { error: 'UPSTREAM_INVALID_RESPONSE' });
+    }
+  });
+  test(`${kind} preserves scoped order, zeros, stale attribution and an empty ranking`, async t => {
+    const r = await request(t, kind, [row([stat()], 7002), row([stat()], 7001)], false);
+    assert.equal(r.status, 200); assert.equal(r.body.stale, true);
+    assert.deepEqual(r.body.players.map(p => [p.id, p.team.id, p.goals, p.assists, p.apps]), [[7002, 9001, 0, 0, 0], [7001, 9001, 0, 0, 0]]);
+    const empty = await request(t, kind, []); assert.equal(empty.status, 200); assert.deepEqual(empty.body, { players: [], stale: true });
+  });
+}
