+const fixture=(id,home=0)=>({fixture:{id,date:'2025-02-01T12:00:00Z',status:{short:'FT'}},teams:{home:{id:529,name:'Barcelona'},away:{id:541,name:'Real Madrid'}},league:{id:140,season:2025},goals:{home,away:0}});
+async function collect(question,rows) {const calls=[];const e=await collectEvidence({async load(path){calls.push(path);
+ if(path==='/fixtures?team=529&last=5')return {data:rows,fetchedAt:1};
+ if(path.startsWith('/fixtures?id='))return {data:[fixture(Number(path.split('=')[1]))],fetchedAt:1};
